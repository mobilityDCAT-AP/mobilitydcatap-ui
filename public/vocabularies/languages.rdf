   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/FOS"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="fos">Siraya</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">fos</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">fos</skos:notation>
      <skos:prefLabel xml:lang="en">Siraya</skos:prefLabel>
      <dc:identifier>FOS</dc:identifier>
      <atold:op-code>FOS</atold:op-code>
      <at:op-code>FOS</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>FOS</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>fos</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Siraya is a dormant Formosan language, indigenous to the Siraya region of Taiwan, that is currently undergoing revitalisation. Several Siraya communities have been involved in a Sirayan cultural and language revitalisation movement for more than a decade. Siraya belongs to the East Formosan primary branch of the Austronesian language family. Like many Austronesian languages, Siraya is characterised by voice alternations in its clause structure and productive morphology, including affixation and reduplication to form new words.</skos:definition>
   </skos:Concept>
