      <skos:altLabel xml:lang="ota">Ottoman Turkish (1500-1928)</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2T">ota</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ota</skos:notation>
