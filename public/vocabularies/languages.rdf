      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KGC</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kgc</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Over the years there has been considerable confusion between Kasseng [kgc], Talieng [tdf], and Tareng [tgr]. Kasseng is an exonym for Talieng. Kasseng should be merged with Talieng.</skos:scopeNote>
      <at:end.use>2016-01-15</at:end.use>
   </skos:Concept>
