   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/KPP"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="kpp">Paku Karen</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">kpp</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">kpp</skos:notation>
      <skos:prefLabel xml:lang="en">Paku Karen</skos:prefLabel>
      <dc:identifier>KPP</dc:identifier>
      <atold:op-code>KPP</atold:op-code>
      <at:op-code>KPP</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KPP</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kpp</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">The entry for Karen, Paku contained Mobwa as a dialect in the past. However, speakers of Mobwa report low inherent intelligibility with Paku. Based on low reported comprehension and separate identities, it seems that Mobwa [jkm] should be considered a separate language from Paku [pku]. In addition, Mobwa is treated as a distinct variety from Paku in the linguistic literature.</skos:scopeNote>
      <at:end.use>2012-02-03</at:end.use>
   </skos:Concept>
