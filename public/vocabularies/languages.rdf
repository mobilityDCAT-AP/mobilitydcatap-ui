      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mja</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mja</skos:notation>
