   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/WIK"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="wik">Wikalkan</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wik</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wik</skos:notation>
      <skos:prefLabel xml:lang="en">Wikalkan</skos:prefLabel>
      <dc:identifier>WIK</dc:identifier>
      <atold:op-code>WIK</atold:op-code>
      <at:op-code>WIK</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WIK</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wik</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Wikalkan is an endangered Australian language spoken by Wik-Ngatharr people on the Cape York Peninsula of Queensland. It is closely related to Wik Ngathan (wig). Both belong to the Wik sub-group, and, on a broader level, to the Paman branch of the Pama-Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
