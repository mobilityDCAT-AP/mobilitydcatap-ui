      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Mirnong</skos:altLabel>
      <skos:altLabel xml:lang="en">Mineng</skos:altLabel>
      <skos:altLabel xml:lang="xrg">Minang</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xrg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xrg</skos:notation>
      <skos:prefLabel xml:lang="en">Minang</skos:prefLabel>
      <dc:identifier>XRG</dc:identifier>
      <atold:op-code>XRG</atold:op-code>
      <at:op-code>XRG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XRG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xrg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Minang is an extinct Australian Aboriginal language formerly spoken in the south-western corner of Western Australia. It is classified in the Nyunga group within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
