   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/RMB"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="rmb">Rembarrnga</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">rmb</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">rmb</skos:notation>
      <skos:prefLabel xml:lang="en">Rembarrnga</skos:prefLabel>
      <dc:identifier>RMB</dc:identifier>
      <atold:op-code>RMB</atold:op-code>
      <at:op-code>RMB</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>RMB</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>rmb</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Rembarrnga is an endangered Australian Aboriginal language spoken in the Roper River region of the Northern Territory. The children of Rembarrnga speakers are now learning neighbouring languages such as Kriol in south central Arnhem Land, and Kunwinjku. It is one of the Northern Non-Pama–Nyungan languages, and closely related to to Ngalakgan (NIG). Both are classified within the Gunwinyguan language family.</skos:definition>
   </skos:Concept>
