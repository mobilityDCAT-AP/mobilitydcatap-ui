      <skos:prefLabel xml:lang="it">lingua dei segni di Tebul</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Tebul</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">tebul jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes de Tebul</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">tebulu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">znakovni jezik etničke skupine Tebul</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">тебульский жестовый язык</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">język migowy Tebul</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">tebulský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Tebul Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от Тебул</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Tebul-gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali ta’ Tebul</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">posunkový jazyk Tebul</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Tebulo gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Tebul Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νοηματική γλώσσα Τεμπούλ</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">tebulilainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos tebul</skos:prefLabel>
      <dc:identifier>TSY</dc:identifier>
      <atold:op-code>TSY</atold:op-code>
      <at:op-code>TSY</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TSY</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>tsy</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Tebul Sign Language is a sign language used in Uluban village in Mali. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
