      </at:op-mapped-code>
      <skos:definition xml:lang="en">Sininkere (Silinkere) is a language that belongs to the Soninke group of the Mande languages. It is a dialect of Soninke spoken in Burkina Faso. It is part of the hypothetical Niger-Congo language family.</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/SNK"/>
   </skos:Concept>
