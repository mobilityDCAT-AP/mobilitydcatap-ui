   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/DJJ"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Ndjébbana</skos:altLabel>
      <skos:altLabel xml:lang="djj">Djeebbana</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">djj</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">djj</skos:notation>
      <skos:prefLabel xml:lang="en">Djeebbana</skos:prefLabel>
      <dc:identifier>DJJ</dc:identifier>
      <atold:op-code>DJJ</atold:op-code>
      <at:op-code>DJJ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>DJJ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>djj</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Djeebbana, also spelled Ndjébbana, is an endangered Australian Aboriginal language spoken by the Gunavidji (Ndjebbana) people of North-central Arnhem Land in the Northern Territory of Australia. It is closely related to Na-kara (nck), and both belong to the Maningrida group of languages. This group is sometimes classified with the Gunwinyguan languages in a proposed Macro-Gunwinyguan family, which is distinct from the Pama–Nyungan language family.</skos:definition>
   </skos:Concept>
