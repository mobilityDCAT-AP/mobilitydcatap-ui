      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Lamet</skos:altLabel>
      <skos:altLabel xml:lang="lbn">Rmeet</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">lbn</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">lbn</skos:notation>
      <skos:prefLabel xml:lang="en">Rmeet</skos:prefLabel>
      <dc:identifier>LBN</dc:identifier>
      <atold:op-code>LBN</atold:op-code>
      <at:op-code>LBN</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>LBN</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>lbn</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Rmeet is a Palaungic language of Laos. It belongs to the Austro-Asiatic language family. Lamet is the Lao pronunciation of the language. Like many Austroasiatic languages, Palaungic languages are characterised by prefixation in its clause structure and larger than average vowel inventories.</skos:definition>
   </skos:Concept>
