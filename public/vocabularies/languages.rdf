      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">csr</skos:notation>
      <skos:prefLabel xml:lang="sl">kostariški znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">kostorykański język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">kostarikanski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali tal-Cost Rica</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Kostarikas zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Costa Rica</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos costarricense</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">costaricanskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">kostarický znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Costa-ricanische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni della Costa Rica</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes costaricienne</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от Коста Рика</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">kostarikiečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="et">costa rica viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="da">costaricansk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Costa Ricaanse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual costa-riquenha</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">kostarický posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Costa Rican Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="el">κοσταρικανή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Costa Rica-i jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Chósta Ríce</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">costaricalainen viittomakieli</skos:prefLabel>
