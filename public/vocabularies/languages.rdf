   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/GUE"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="gue">Gurindji</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">gue</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">gue</skos:notation>
      <skos:prefLabel xml:lang="en">Gurindji</skos:prefLabel>
      <dc:identifier>GUE</dc:identifier>
      <atold:op-code>GUE</atold:op-code>
      <at:op-code>GUE</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>GUE</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>gue</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Gurindji is an endangered Pama–Nyungan language spoken by the Gurindji in the Northern Territory, Australia. In 2006 it had about 590 speakers according to the Australian Bureau of Statistics. Gurindji Kriol is a mixed language that derives from the Gurindji language. It is closely related to Ngarinman, and both belong to the Ngumpin sub-group within the Pama-Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages.</skos:definition>
   </skos:Concept>
