   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/ZML"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="zml">Matngala</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">zml</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">zml</skos:notation>
      <skos:prefLabel xml:lang="en">Matngala</skos:prefLabel>
      <dc:identifier>ZML</dc:identifier>
      <atold:op-code>ZML</atold:op-code>
      <at:op-code>ZML</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ZML</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>zml</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Matngala is an extinct Australian Aboriginal language formerly spoken by the Matngala people in the middle and lower reaches of the Daly River in the Northern Territory. It is often grouped with Kama in the small Eastern Daly group, unrelated to the larger Australian Aboriginal language families.</skos:definition>
   </skos:Concept>
