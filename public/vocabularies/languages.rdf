      <skos:prefLabel xml:lang="lt">Džankoto gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">джанкотски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Jhankoti viipekeel</skos:prefLabel>
