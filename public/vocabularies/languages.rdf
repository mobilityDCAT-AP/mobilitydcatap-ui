      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="myq">Forest Maninka</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">myq</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">myq</skos:notation>
      <skos:prefLabel xml:lang="en">Forest Maninka</skos:prefLabel>
      <dc:identifier>MYQ</dc:identifier>
      <atold:op-code>MYQ</atold:op-code>
      <at:op-code>MYQ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MYQ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>myq</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Forest Maninka” is a phantom language. I’m afraid, I’m partly guilty of its emergence: many years ago, I invented this term as generic for the continuum Manya – Konya – Odienne Jula, and later on, someone reinterpreted it as a language of a lower level.</skos:scopeNote>
      <at:end.use>2013-01-23</at:end.use>
   </skos:Concept>
