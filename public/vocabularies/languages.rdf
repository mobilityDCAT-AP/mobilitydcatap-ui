      <skos:prefLabel xml:lang="de">Bolivianische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">boliwijski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">bolívijský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta na Bolaive</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes bolivienne</skos:prefLabel>
      <skos:prefLabel xml:lang="et">boliivia viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual boliviana</skos:prefLabel>
