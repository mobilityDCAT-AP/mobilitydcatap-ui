   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/KRU"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Oraon</skos:altLabel>
      <skos:altLabel xml:lang="kru">Kuṛux</skos:altLabel>
      <skos:altLabel xml:lang="kru">Kuṁṛux</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">kru</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2T">kru</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">kru</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2B">kru</skos:notation>
      <skos:prefLabel xml:lang="en">Kurukh</skos:prefLabel>
      <dc:identifier>KRU</dc:identifier>
      <atold:op-code>KRU</atold:op-code>
      <at:op-code>KRU</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KRU</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2b</dc:source>
            <at:legacy-code>kru</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kru</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2t</dc:source>
            <at:legacy-code>kru</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kurukh, also Kurux, Oraon or Uranw, is a North Dravidian language spoken by the Kurukh (Oraon) and Kisan people of East India. It is spoken by about two million people in the Indian states of Jharkhand, Chhattisgarh, Odisha, West Bengal, Assam and Tripura, as well as by 65 000 in northern Bangladesh, 28 600 of a dialect called Uranw in Nepal and about 5 000 in Bhutan. The most closely related language to Kurukh is Malto. Together with Brahui, all three languages form the North Dravidian branch of the Dravidian language family. Kurukh is written in Devanagari, a script also used to write Indo-Aryan languages.</skos:definition>
   </skos:Concept>
