   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/SUJ"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="suj">Shubi</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">suj</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">suj</skos:notation>
      <skos:prefLabel xml:lang="en">Shubi</skos:prefLabel>
      <dc:identifier>SUJ</dc:identifier>
      <atold:op-code>SUJ</atold:op-code>
      <at:op-code>SUJ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SUJ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>suj</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Shubi is an East Bantu language spoken in north-western Tanzania. It is closely related to Hangaza (han). Both languages are classified within the Volta-Congo primary branch of the Atlantic-Congo language family. Like other Bantu languages, Shubi has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
