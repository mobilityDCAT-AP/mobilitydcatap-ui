      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="smj">julevsámegiella</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2B">smj</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">smj</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2T">smj</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">smj</skos:notation>
      <skos:prefLabel xml:lang="sv">lulesamiska</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">luulajansaame</skos:prefLabel>
      <skos:prefLabel xml:lang="no">lulesamisk</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">луле-саамский язык</skos:prefLabel>
      <skos:prefLabel xml:lang="et">lule saami keel</skos:prefLabel>
      <skos:prefLabel xml:lang="se">julevsámegiella</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Lule Sami</skos:prefLabel>
      <dc:identifier>SMJ</dc:identifier>
      <atold:op-code>SMJ</atold:op-code>
      <at:op-code>SMJ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SMJ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>smj</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2b</dc:source>
            <at:legacy-code>smj</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2t</dc:source>
            <at:legacy-code>smj</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Lule Sami (julevsámegiella) is one of the Sami languages. It was originally only spoken around the Lule River, in Sweden. During the 18th century some Sami migrated to Nordland in Norway, and their descendants still live in Norway, and speak Lule Sami. In Norway, in Hamarøy Municipality, Lule Sami is one of the official languages. Like Baltic-Finnic languages, Sami languages are a branch of the Uralic language family.</skos:definition>
   </skos:Concept>
