      <skos:prefLabel xml:lang="es">lengua de signos de Ban Khor</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">бан-кхорский жестовый язык</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Ban Khor-i jelnyelv</skos:prefLabel>
