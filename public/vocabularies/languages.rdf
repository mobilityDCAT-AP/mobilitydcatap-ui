   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/BLV"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="blv">Ipala</skos:altLabel>
      <skos:altLabel xml:lang="en">Kibala</skos:altLabel>
      <skos:altLabel xml:lang="en">Ngoya</skos:altLabel>
      <skos:altLabel xml:lang="blv">Bolo</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">blv</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">blv</skos:notation>
      <skos:prefLabel xml:lang="en">Bolo</skos:prefLabel>
      <dc:identifier>BLV</dc:identifier>
      <atold:op-code>BLV</atold:op-code>
      <at:op-code>BLV</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>BLV</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>blv</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Bolo is a narrow Bantu language spoken in Angola. The only name for the language as a whole, 'Ngoya', was originally pejorative, though it is becoming increasingly accepted. 'Kibala' is the Umbundu name for the central dialect, Ipala. 'Bolo' is a peripheral dialect. Together with Mpinda (pnd) and Kimbundu (kmb), it belongs to the Mbundu group, which is classified within the Volta-Congo primary branch. Like other Bantu languages, Bolo has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
