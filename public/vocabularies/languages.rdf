      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="rxw">Karuwali</skos:altLabel>
      <skos:altLabel xml:lang="en">Garuwali</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">rxw</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">rxw</skos:notation>
      <skos:prefLabel xml:lang="en">Karuwali</skos:prefLabel>
      <dc:identifier>RXW</dc:identifier>
      <atold:op-code>RXW</atold:op-code>
      <at:op-code>RXW</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>RXW</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>rxw</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Karuwali is a dormant Pama-Nyungan language, tentatively classified within the Karnic sub-branch. It was spoken by the Mithaka people in Queensland, Australia. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
