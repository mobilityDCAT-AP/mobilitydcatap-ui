   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/GNI"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="gni">Gooniyandi</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">gni</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">gni</skos:notation>
      <skos:prefLabel xml:lang="en">Gooniyandi</skos:prefLabel>
      <dc:identifier>GNI</dc:identifier>
      <atold:op-code>GNI</atold:op-code>
      <at:op-code>GNI</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>GNI</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>gni</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Gooniyandi, or Guniyandi, is an endangered Australian Aboriginal language spoken by about 200 people, most of whom live in or near Fitzroy Crossing in Kimberley, Western Australia. Gooniyandi is not related to the Pama-Nyungan language family that spans the majority of Australia; however, it is a relative of Bunuba. Both belong to the Bunuban language family.</skos:definition>
   </skos:Concept>
