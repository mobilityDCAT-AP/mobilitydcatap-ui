      <skos:altLabel xml:lang="msd">Yucatec Maya Sign Language</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">msd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">msd</skos:notation>
      <skos:prefLabel xml:lang="sk">posunkový jazyk Yucatec Maya</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes maya yucatèque</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Yucatec Maya Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Yucatec Maya Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos maya de yucateca</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Maya-Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Yucatec maya tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">jukatekų majų gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Yucatec Maya</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne al mayașilor Yucatec</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual iucatega</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">znakovni jezik naroda Yucatec</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">znakovni jezik Yucatec Maya</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Jukatanas maiju zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali ta’ Yucatec Maya</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni maya yucateca</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">yukatekiskt maya-teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="et">maaja viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">jukatańsk majańskii język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">yucatánský mayský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νοηματική γλώσσα Γιουκατέκ Μάγια</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език Юкатек Майа</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">jukatán maja jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">jukatekmayalainen viittomakieli</skos:prefLabel>
      <dc:identifier>MSD</dc:identifier>
      <atold:op-code>MSD</atold:op-code>
      <at:op-code>MSD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MSD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>msd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Yucatec Maya Sign Language is a sign language used in the Yucatan region, in Mexico, by Maya communities. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
