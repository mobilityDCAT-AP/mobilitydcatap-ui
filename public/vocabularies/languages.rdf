      <skos:altLabel xml:lang="isg">Irish Sign Language</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">isg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">isg</skos:notation>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Irlanda</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos irlandesa</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta na hÉireann</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">airių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Irish Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">irski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">irski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="el">ιρλανδική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">irlandzki język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">írsky posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Ierse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni irlandese</skos:prefLabel>
      <skos:prefLabel xml:lang="tr">irlandaca işaret dili</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes irlandaise</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Irlandiża</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">irský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">irlantilainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Irische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">īru zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="da">irsk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">ír jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual irlandesa</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">ирландски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">iriskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="et">iiri viipekeel</skos:prefLabel>
      <dc:identifier>ISG</dc:identifier>
      <atold:op-code>ISG</atold:op-code>
      <at:op-code>ISG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ISG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>isg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Irish Sign Language is a sign language used in Ireland and in Northern Ireland. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/TBH"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Thurawal</skos:altLabel>
      <skos:altLabel xml:lang="tbh">Dharawal</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">tbh</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">tbh</skos:notation>
      <skos:prefLabel xml:lang="en">Dharawal</skos:prefLabel>
      <dc:identifier>TBH</dc:identifier>
      <atold:op-code>TBH</atold:op-code>
      <at:op-code>TBH</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TBH</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>tbh</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Dharawal, also known as Thurawal, is a dormant Pama-Nyungan language classified within the Yuin-Kuri sub-branch. It was spoken in Wollongong, Port Kembla, and Nowra regions of New South Wales, Australia. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
