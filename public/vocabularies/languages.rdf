      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">apc</skos:notation>
      <skos:prefLabel xml:lang="sv">levantinsk arabiska</skos:prefLabel>
      <skos:prefLabel xml:lang="de">levantinisches Arabisch</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Levantijns-Arabisch</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">arābu valoda (levantiešu)</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">levantská arabčina</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Levandi araabia keel</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">arabă levantină</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Għarbi Levantin</skos:prefLabel>
      <skos:prefLabel xml:lang="it">arabo levantino</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">levantinarabia</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">levantská arabština</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">arabe levantin</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">levantei arab</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">левантински арабски</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">levantinska arabščina</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Araibis Leiveantach</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">arabski syryjsko-palestyński</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Levantine Arabic</skos:prefLabel>
      <skos:prefLabel xml:lang="el">λεβαντίνικα αραβικά</skos:prefLabel>
      <skos:prefLabel xml:lang="es">árabe levantino</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">árabe levantino</skos:prefLabel>
      <skos:prefLabel xml:lang="da">levantinsk arabisk</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">istočni arapski</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Levanto arabų</skos:prefLabel>
      <dc:identifier>APC</dc:identifier>
      <atold:op-code>APC</atold:op-code>
      <at:op-code>APC</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>APC</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>apc</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Levantine Arabic, also called Shami, is an Arabic variety spoken in the Levant, namely in Syria, Jordan, Lebanon, Palestine, Israel and southern Turkey. With over 60 million speakers, Levantine Arabic is, alongside Egyptian, one of the two prestige varieties of spoken Arabic comprehensible all over the Arab world. Levantine Arabic falls under the Semitic sub-branch of the Afro-Asiatic language family.</skos:definition>
   </skos:Concept>
