      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Ġermaniża</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual alemã</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos alemana</skos:prefLabel>
      <dc:identifier>GSG</dc:identifier>
      <atold:op-code>GSG</atold:op-code>
      <at:op-code>GSG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>GSG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>gsg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">German Sign Language is a sign language used in German and in the German-speaking community of Belgium. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
