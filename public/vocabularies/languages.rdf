      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="wnd">Wandarang</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wnd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wnd</skos:notation>
      <skos:prefLabel xml:lang="en">Wandarang</skos:prefLabel>
      <dc:identifier>WND</dc:identifier>
      <atold:op-code>WND</atold:op-code>
      <at:op-code>WND</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WND</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wnd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Wandarang is an extinct Australian Aboriginal language once spoken in the Northern Territory. Wandarang is a member of the Arnhem, or Macro-Gunwinyguan family, the second-largest Australian language family after Pama–Nyungan, but this language family is not universally accepted.</skos:definition>
   </skos:Concept>
