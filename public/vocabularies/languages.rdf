   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MOE"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Montagnais</skos:altLabel>
      <skos:altLabel xml:lang="moe">Innu</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">moe</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">moe</skos:notation>
      <skos:prefLabel xml:lang="en">Innu</skos:prefLabel>
      <dc:identifier>MOE</dc:identifier>
      <atold:op-code>MOE</atold:op-code>
      <at:op-code>MOE</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MOE</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>moe</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Innu (or Montagnais) is an Algonquian language spoken by over 10,000 Innu in Labrador and Quebec in Eastern Canada. It is a member of the Cree–Montagnais–Naskapi dialect continuum and is spoken in various dialects depending on the community. Algonquian languages belong to the Algic language family.</skos:definition>
   </skos:Concept>
