   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MEG"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="meg">Mea</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">meg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">meg</skos:notation>
      <skos:prefLabel xml:lang="en">Mea</skos:prefLabel>
      <dc:identifier>MEG</dc:identifier>
      <atold:op-code>MEG</atold:op-code>
      <at:op-code>MEG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MEG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>meg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">The settled consensus of NC linguistic opinon, as reflected in the Corpus de la Parole site (cited above), Wurm &amp; Hattori (1981) and Grace (1976) (bibliographic details below) is that Tîrî and Méa are dialects of the one language. New Caledonian official statistics also gives a single number of speakers for both dialects as one.</skos:scopeNote>
      <at:end.use>2013-01-23</at:end.use>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/UTH"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Eastern Duka</skos:altLabel>
      <skos:altLabel xml:lang="uth">Saare</skos:altLabel>
      <skos:altLabel xml:lang="uth">it-Hun</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">uth</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">uth</skos:notation>
      <skos:prefLabel xml:lang="en">ut-Hun</skos:prefLabel>
      <dc:identifier>UTH</dc:identifier>
      <atold:op-code>UTH</atold:op-code>
      <at:op-code>UTH</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>UTH</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>uth</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">ut-Hun, also known as Eastern Duka, is a Northwestern Kainji language of Nigeria. It is close to us-Saare, also known as Western Duka. However, speakers use Saare for both languages. Noun class systems are a defining feature of the Atlantic–Congo languages, to which Kainji languages belong as part of the Volta-Congo primary branch and the Benue-Congo sub-branch.</skos:definition>
   </skos:Concept>
