      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="wit">Wintu</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wit</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wit</skos:notation>
      <skos:prefLabel xml:lang="en">Wintu</skos:prefLabel>
      <dc:identifier>WIT</dc:identifier>
      <atold:op-code>WIT</atold:op-code>
      <at:op-code>WIT</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WIT</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wit</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Modern scholars of Wintuan languages are in agreement that Wintu, Nomlaki and Patwin are three separate languages. Thus, Wintu [wit] split into Wintu [wnw], Nomlaki [nol], and Patwin [pwi] .</skos:scopeNote>
      <at:end.use>2013-01-23</at:end.use>
   </skos:Concept>
