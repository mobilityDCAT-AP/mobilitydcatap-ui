   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MPB"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Mullukmulluk</skos:altLabel>
      <skos:altLabel xml:lang="mpb">Malak Malak</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mpb</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mpb</skos:notation>
      <skos:prefLabel xml:lang="en">Malak Malak</skos:prefLabel>
      <dc:identifier>MPB</dc:identifier>
      <atold:op-code>MPB</atold:op-code>
      <at:op-code>MPB</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MPB</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mpb</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Malak Malak, also known as Mullukmulluk, is a moribund Australian Aboriginal language traditionally spoken on the northern side of the Daly River in the Northern Territory. By 2002 it was estimated to have less than 10 speakers. Malak Malak is related to Kuwema, or Tyaraity. They were formerly classified as independent members of the Northern Daly languages, but are now considered a language isolate.</skos:definition>
   </skos:Concept>
