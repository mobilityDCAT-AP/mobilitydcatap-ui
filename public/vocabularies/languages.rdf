   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/GDC"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="gdc">Gugu Badhun</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">gdc</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">gdc</skos:notation>
      <skos:prefLabel xml:lang="en">Gugu Badhun</skos:prefLabel>
      <dc:identifier>GDC</dc:identifier>
      <atold:op-code>GDC</atold:op-code>
      <at:op-code>GDC</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>GDC</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>gdc</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Gugu Badhun is a dormant Australian Aboriginal language formerly spoken in the Upper Burdekin region of northern Queensland. Gugu Badhun is closely related to Warungu (wrg), and both belong to the Maric group of languages within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/OSD"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="osd">дигорон ӕвзаг</skos:altLabel>
      <skos:altLabel xml:lang="osd">digoron ævzag</skos:altLabel>
      <skos:altLabel xml:lang="en">Digor</skos:altLabel>
      <skos:altLabel xml:lang="en">Digor Ossetian</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">osd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">osd</skos:notation>
      <skos:prefLabel xml:lang="en">Digor Ossetic</skos:prefLabel>
      <skos:prefLabel xml:lang="da">digorossetisk</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">osetină digor</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Digor-Ossetisch</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">digorski osetski</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">osetinų digorų</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Oiséitis Dhíogórach</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">ossète Digor</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">digorská osetština</skos:prefLabel>
      <skos:prefLabel xml:lang="et">digoriosseedi keel</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">digorská osetčina</skos:prefLabel>
      <skos:prefLabel xml:lang="el">ντίγκορ οσετικά</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">osetīnu valoda (digoru)</skos:prefLabel>
      <skos:prefLabel xml:lang="it">osseto digor</skos:prefLabel>
      <skos:prefLabel xml:lang="es">osético digor</skos:prefLabel>
      <skos:prefLabel xml:lang="de">digorisches Ossetisch</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">digorski (zachodnioosetyjski)</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">digor oszét</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">digorosseetti</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Ossetiku, varjetà Digor</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">дигорски осетински</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">digor osetščina</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">digorossetiska</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">osseto digoriano</skos:prefLabel>
      <dc:identifier>OSD</dc:identifier>
      <atold:op-code>OSD</atold:op-code>
      <at:op-code>OSD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>OSD</at:authority-code>
      <skos:definition xml:lang="en">Digor Ossetic (often simply referred to as Digor) is the less commonly spoken variety of the two Ossetic languages, with the other being Iron Ossetic. Digor is spoken in the western regions of the Republic of North Ossetia and in neighbouring Kabardino-Balkaria. Both Ossetic languages, along with Yaghnobi and the extinct Sogdian, are part of the Eastern Iranian subgroup within the Indo-European language family. Digor Ossetic uses the Cyrillic script.</skos:definition>
   </skos:Concept>
