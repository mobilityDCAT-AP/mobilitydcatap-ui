   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/LVI"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="lvi">səlwəŋ</skos:altLabel>
      <skos:altLabel xml:lang="en">Swoeng</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">lvi</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">lvi</skos:notation>
      <skos:prefLabel xml:lang="en">Lavi</skos:prefLabel>
      <dc:identifier>LVI</dc:identifier>
      <atold:op-code>LVI</atold:op-code>
      <at:op-code>LVI</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>LVI</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>lvi</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Lavi (Swoeng) is a Mon–Khmer language spoken in Sekong Province, Laos. Lavi falls under the Bahnaric sub-branch of the Austroasiatic language family. Within the West Bahnaric branch, it is the most divergent language. Like many Austroasiatic languages, Lavi is characterised by prefixation and non-existent suffixation in its clause structure and large vowel inventories.</skos:definition>
   </skos:Concept>
