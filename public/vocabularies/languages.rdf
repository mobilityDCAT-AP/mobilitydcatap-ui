      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TIE</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>tie</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">The original classification of Tingal as a separate language was based on a misreading of the only published reference to it. A field check has established that Tingal is a dialect of Tegali [ras].</skos:scopeNote>
      <at:end.use>2016-01-15</at:end.use>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/BNM"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="bnm">Batanga</skos:altLabel>
      <skos:altLabel xml:lang="en">Tanga</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">bnm</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">bnm</skos:notation>
      <skos:prefLabel xml:lang="en">Batanga</skos:prefLabel>
      <dc:identifier>BNM</dc:identifier>
      <atold:op-code>BNM</atold:op-code>
      <at:op-code>BNM</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>BNM</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>bnm</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Batanga is a Southern Bantoid language spoken in Equatorial Guinea and Gabon. Together with other Bengaic languages (BNM, BNG, NUI, YKO) and Dualaic languages (DUA, MZD, KME, ISU, OLB), it belongs to the Sawabantu group, which is classified within the Volta-Congo primary branch. Like other Bantu languages, Batanga has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
