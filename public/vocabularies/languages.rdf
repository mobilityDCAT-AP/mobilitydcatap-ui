      <skos:prefLabel xml:lang="fr">langue des signes nigériane</skos:prefLabel>
      <skos:prefLabel xml:lang="da">nigeriansk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Nigeriaanse Gebarentaal</skos:prefLabel>
