   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/UKY"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="uky">Kuuk-Yak</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">uky</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">uky</skos:notation>
      <skos:prefLabel xml:lang="en">Kuuk-Yak</skos:prefLabel>
      <dc:identifier>UKY</dc:identifier>
      <atold:op-code>UKY</atold:op-code>
      <at:op-code>UKY</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>UKY</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>uky</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kuuk-Yak, literally ‘snake language’, is an extinct Pama-Nyungan language formerly spoken on the Cape York Peninsula of Queensland in Australia. It is thought to be related to Kuuk Thayorre (thd). If so, it is classified within the Paman branch and more specifically within the Southwest Pama sub-branch. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
