   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/GBW"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="gbw">Gabi-Gabi</skos:altLabel>
      <skos:altLabel xml:lang="en">Kabi Kabi</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">gbw</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">gbw</skos:notation>
      <skos:prefLabel xml:lang="en">Gabi-Gabi</skos:prefLabel>
      <dc:identifier>GBW</dc:identifier>
      <atold:op-code>GBW</atold:op-code>
      <at:op-code>GBW</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>GBW</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>gbw</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Gabi-Gabi is an endangered Australian Aboriginal language traditionally spoken by the Gabi-Gabi people in south-east Queensland. Gabi-Gabi is closely related to Batjala (xby). Both belong to the Waka-Kabic sub-group within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
