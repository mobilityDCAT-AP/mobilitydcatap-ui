      <skos:prefLabel xml:lang="es">lengua de signos de Laos</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali tal-Laos</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Laos</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes laotienne</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">laosiečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">laoský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">laoski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">laotiskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">laoszi jelnyelv</skos:prefLabel>
