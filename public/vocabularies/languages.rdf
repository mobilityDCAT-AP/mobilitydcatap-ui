   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/WRZ"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="wrz">Waray</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wrz</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wrz</skos:notation>
      <skos:prefLabel xml:lang="en">Waray (Australia)</skos:prefLabel>
      <dc:identifier>WRZ</dc:identifier>
      <atold:op-code>WRZ</atold:op-code>
      <at:op-code>WRZ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WRZ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wrz</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Waray is an extinct Australian Aboriginal language spoken in the Adelaide River area of the Northern Territory. Waray is not related to the Pama-Nyungan language family that spans the majority of Australia. It belongs to the smaller Gunwinyguan language family and is related to Jawoyn.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/ZMP"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="zmp">Kimbuun</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">zmp</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">zmp</skos:notation>
      <skos:prefLabel xml:lang="en">Mbuun</skos:prefLabel>
      <dc:identifier>ZMP</dc:identifier>
      <atold:op-code>ZMP</atold:op-code>
      <at:op-code>ZMP</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ZMP</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>zmp</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Mbuun or Mpuun, is a Bantu language spoken by several hundred thousand people in the Democratic Republic of Congo. The name is sometimes spelled Kimbuun or Gimbunda. Mpuono has been spuriously conflated with it in some sources. Mbuun is part of the Kikongo Language Cluster, which is classified within the Volta-Congo branch. Like other Bantu languages, Mbuun has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
