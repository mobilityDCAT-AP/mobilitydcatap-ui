   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/NIG"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="nig">Ngalakgan</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">nig</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">nig</skos:notation>
      <skos:prefLabel xml:lang="en">Ngalakgan</skos:prefLabel>
      <dc:identifier>NIG</dc:identifier>
      <atold:op-code>NIG</atold:op-code>
      <at:op-code>NIG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>NIG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nig</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Ngalakgan is an extinct Australian Aboriginal language of the Ngalakgan people. It has not been fully acquired by children since the 1930s. It is one of the Northern Non-Pama–Nyungan languages formerly spoken in the Roper river region of the Northern Territory. It is closely related to Rembarrnga (rmb). Both are classified within the Gunwinyguan language family.</skos:definition>
   </skos:Concept>
