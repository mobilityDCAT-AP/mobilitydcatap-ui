   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/ULY"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="uly">Buli</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">uly</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">uly</skos:notation>
      <skos:prefLabel xml:lang="en">Buli</skos:prefLabel>
      <dc:identifier>ULY</dc:identifier>
      <atold:op-code>ULY</atold:op-code>
      <at:op-code>ULY</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ULY</at:authority-code>
      <skos:definition xml:lang="en">Buli is an Afro-Asiatic language of Bauchi State, Nigeria. It is part of the Barawa cluster, which is in turn part of the West Chadic branch. Its closes language varieties are Pesse, Zul, Dir-Nyamzak-Mbarimi and the extinct Luri. Together, they form the Polci-Luri group.</skos:definition>
   </skos:Concept>
