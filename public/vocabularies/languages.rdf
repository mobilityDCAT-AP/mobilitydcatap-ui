      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Ngunawal</skos:altLabel>
      <skos:altLabel xml:lang="xul">Ngunnawal</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xul</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xul</skos:notation>
      <skos:prefLabel xml:lang="en">Ngunnawal</skos:prefLabel>
      <dc:identifier>XUL</dc:identifier>
      <atold:op-code>XUL</atold:op-code>
      <at:op-code>XUL</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XUL</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xul</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Ngunnawal is an extinct Aboriginal language spoken in the Canberra region in Australia now undergoing revitalisation. It belongs to the large Pama-Nyungan family, specifically the Southeastern branch. Together with Gundungurra, it constitutes the Yuin subbranch.</skos:definition>
   </skos:Concept>
