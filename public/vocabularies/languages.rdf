         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Hakka is a member of the Sinitic languages of the Sino-Tibetan language family. It is most closely related to Gan and is sometimes classified as a variety of Gan. It is spoken natively by the Hakka people in parts of Southern China, Taiwan, some diaspora areas of Southeast Asia and in overseas Chinese communities around the world.</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/ZHO"/>
   </skos:Concept>
