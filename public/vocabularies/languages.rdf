      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="mpc">Mangarrayi</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mpc</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mpc</skos:notation>
      <skos:prefLabel xml:lang="en">Mangarrayi</skos:prefLabel>
      <dc:identifier>MPC</dc:identifier>
      <atold:op-code>MPC</atold:op-code>
      <at:op-code>MPC</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MPC</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mpc</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Mangarrayi is an endangered Australian Aboriginal language spoken in the Northern Territory. It has been tentatively classified within the small Mangarrayi-Maran language family, which in turn has been grouped within the proposed Arnhem, or Macro-Gunwinyguan family, the second-largest Australian language family after Pama–Nyungan, though this higher-level classification is not universally accepted.</skos:definition>
   </skos:Concept>
