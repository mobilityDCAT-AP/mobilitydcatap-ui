      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="thc">Tai Hang Tong</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">thc</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">thc</skos:notation>
      <skos:prefLabel xml:lang="en">Tai Hang Tong</skos:prefLabel>
      <dc:identifier>THC</dc:identifier>
      <atold:op-code>THC</atold:op-code>
      <at:op-code>THC</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>THC</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>thc</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Thai Hang Tong (THC) is an alternative name used in Vietnam for Tai Pao (TPO) (FerlusRequest for Change to ISO 639-3 Language Code, page 3 2008). It is found in some Vietnamese-language publications, but is hardly ever used locally at present (“Tai Pao” is now the preferred form). Thus, Thai Hang Tong [thc] merged into Tai Pao [tpo].</skos:scopeNote>
      <at:end.use>2016-01-15</at:end.use>
   </skos:Concept>
