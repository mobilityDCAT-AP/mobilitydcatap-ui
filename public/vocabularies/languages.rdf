   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/NLO"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="nlo">Ngul</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">nlo</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">nlo</skos:notation>
      <skos:prefLabel xml:lang="en">Ngul</skos:prefLabel>
      <dc:identifier>NLO</dc:identifier>
      <atold:op-code>NLO</atold:op-code>
      <at:op-code>NLO</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>NLO</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nlo</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Ngul (also Ngwii) is a Bantu language spoken in the Democratic Republic of the Congo. Together with Lwel, Ding and Nzadi, it belongs to the West-Coastal Bantu group, which is classified within the Volta-Congo primary branch. Like other Bantu languages, Ngul has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
