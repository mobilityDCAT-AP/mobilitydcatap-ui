   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/DZD"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="dzd">Daza</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">dzd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">dzd</skos:notation>
      <skos:prefLabel xml:lang="en">Daza</skos:prefLabel>
      <dc:identifier>DZD</dc:identifier>
      <atold:op-code>DZD</atold:op-code>
      <at:op-code>DZD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>DZD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>dzd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Daza or (in Hausa) Dazawa is listed by Blench (2006) as a Chadic language within the Bole group, spoken in a few villages of Darazo LGA, Bauchi State, Nigeria. It was confirmed to exist in 2021. The language is nearly extinct with only elderly speakers speaking the language. Native speakers have shifted to Hausa.</skos:definition>
   </skos:Concept>
