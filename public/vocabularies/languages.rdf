   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/NUG"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Yilngali</skos:altLabel>
      <skos:altLabel xml:lang="nug">Nungali</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">nug</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">nug</skos:notation>
      <skos:prefLabel xml:lang="en">Nungali</skos:prefLabel>
      <dc:identifier>NUG</dc:identifier>
      <atold:op-code>NUG</atold:op-code>
      <at:op-code>NUG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>NUG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nug</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Nungali, or Yilngali, is an Australian Aboriginal language within the Yirram sub-branch, which is believed to be extinct. It was spoken in the Northern Territory of Australia, around the upper Daly River. Nungali is not related to the Pama-Nyungan language family that spans the majority of Australia; however, it is a relative of Djamindjung. Both belong to the Mirndi language family.</skos:definition>
   </skos:Concept>
