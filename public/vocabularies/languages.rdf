         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>rie</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">The name for this purported language apparently came from the 1954 listing from David Thomas. Most linguists working in Southeast Asia have not heard of this language. The Ethnologue seems to be the sole source of information on this group.</skos:scopeNote>
      <at:end.use>2017-01-31</at:end.use>
