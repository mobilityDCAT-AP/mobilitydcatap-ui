      <skos:prefLabel xml:lang="en">Kita Maninkakan</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Kita maninkakan</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Kita maninkakan</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">malinščina</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">középmalinké</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">кита-манинкакан</skos:prefLabel>
