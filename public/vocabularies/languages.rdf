   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/RWL"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Luwira</skos:altLabel>
      <skos:altLabel xml:lang="rwl">Kiruwila</skos:altLabel>
      <skos:altLabel xml:lang="en">Rwira</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">rwl</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">rwl</skos:notation>
      <skos:prefLabel xml:lang="en">Ruwila</skos:prefLabel>
      <dc:identifier>RWL</dc:identifier>
      <atold:op-code>RWL</atold:op-code>
      <at:op-code>RWL</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>RWL</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>rwl</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Ruwila, also spelled as Luwira, is a narrow Bantu language spoken in central Tanzania. Together with other Sukuma-Nyamwezi languages it is classified within the Volta-Congo primary branch. Like other Bantu languages, Ruwila has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
