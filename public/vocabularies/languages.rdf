   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/KTD"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Kukatha</skos:altLabel>
      <skos:altLabel xml:lang="ktd">Kokata</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ktd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ktd</skos:notation>
      <skos:prefLabel xml:lang="en">Kokata</skos:prefLabel>
      <dc:identifier>KTD</dc:identifier>
      <atold:op-code>KTD</atold:op-code>
      <at:op-code>KTD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KTD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ktd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kokata, or Kukatha, is a Pama-Nyungan language spoken in the western desert region of Australia. It is one of the Wati languages. The name Wati tends to be used when considering the various varieties to be distinct languages, Western Desert when considering them dialects of a single language. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
