      <skos:prefLabel xml:lang="pl">literacki chiński</skos:prefLabel>
      <skos:prefLabel xml:lang="es">chino literario</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">литературен китайски</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Sínis Liteartha</skos:prefLabel>
