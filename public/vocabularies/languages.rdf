   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/NYH"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="nyh">Nyikina</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">nyh</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">nyh</skos:notation>
      <skos:prefLabel xml:lang="en">Nyikina</skos:prefLabel>
      <dc:identifier>NYH</dc:identifier>
      <atold:op-code>NYH</atold:op-code>
      <at:op-code>NYH</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>NYH</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nyh</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Nyikina is an endangered Australian Aboriginal language spoken by the Nyikina people in northern Western Australia. It is closely related to the extinct Warrwa language. Both belong to the small Nyulnyulan language family. Most languages in this family are extinct, with only three extant languages, all of which are almost extinct</skos:definition>
   </skos:Concept>
