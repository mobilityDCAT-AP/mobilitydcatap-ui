   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/BAP"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="bap">Bantawa</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">bap</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">bap</skos:notation>
      <skos:prefLabel xml:lang="en">Bantawa</skos:prefLabel>
      <dc:identifier>BAP</dc:identifier>
      <atold:op-code>BAP</atold:op-code>
      <at:op-code>BAP</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>BAP</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>bap</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Bantawa is a Kiranti language spoken in the eastern Himalayan hills of eastern Nepal by Kirati Bantawa ethnic groups. The Kiranti languages form a branch of the Sino-Tibetan languages, one of the largest language families in the world. Kirati Bantawa groups use a syllabic alphabet system known as Kirat Rai.</skos:definition>
   </skos:Concept>
