      </at:op-mapped-code>
      <skos:definition xml:lang="en">Gan is a member of the Sinitic languages of the Sino-Tibetan language family, and Hakka is the closest Chinese variety to Gan in terms of phonetics. It is spoken in the Jiangxi province and the neighbouring provinces.</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/ZHO"/>
   </skos:Concept>
