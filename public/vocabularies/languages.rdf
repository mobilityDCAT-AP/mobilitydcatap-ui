   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MYQ"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
