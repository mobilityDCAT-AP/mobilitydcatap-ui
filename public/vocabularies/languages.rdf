   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/DJN"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Kumertuo</skos:altLabel>
      <skos:altLabel xml:lang="en">Djauan</skos:altLabel>
      <skos:altLabel xml:lang="djn">Jawoyn</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">djn</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">djn</skos:notation>
      <skos:prefLabel xml:lang="en">Jawoyn</skos:prefLabel>
      <dc:identifier>DJN</dc:identifier>
      <atold:op-code>DJN</atold:op-code>
      <at:op-code>DJN</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>DJN</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>djn</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Jawoyn, or Djauan, also known as Kumertuo, is a moribund Gunwinyguan language spoken only by elders in Arnhem Land, Australia. Jawoyn is not related to the Pama-Nyungan language family that spans the majority of Australia. However, it is related to the extinct Warrayic languages.</skos:definition>
   </skos:Concept>
