                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="auu">Auye</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">auu</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">auu</skos:notation>
      <skos:prefLabel xml:lang="en">Auye</skos:prefLabel>
      <dc:identifier>AUU</dc:identifier>
      <atold:op-code>AUU</atold:op-code>
      <at:op-code>AUU</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>AUU</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>auu</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Auye (Auwje) and Moi-Wadea (Moi, Maniwo, Dao) are the two varieties of a Papuan language group spoken in the Paniai lakes region of the Indonesian province of Central Papua. Both belong to the Nuclear Trans New Guinea language family.</skos:definition>
   </skos:Concept>
