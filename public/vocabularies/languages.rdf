   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MAI"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="mai">Maithili</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mai</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mai</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2B">mai</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2T">mai</skos:notation>
      <skos:prefLabel xml:lang="en">Maithili</skos:prefLabel>
      <dc:identifier>MAI</dc:identifier>
      <atold:op-code>MAI</atold:op-code>
      <at:op-code>MAI</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MAI</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2b</dc:source>
            <at:legacy-code>mai</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mai</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2t</dc:source>
            <at:legacy-code>mai</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Maithili is an Indo-Aryan language variety in the broader Indo-European language family. It is spoken in the Mithila region in north-eastern India and Nepal. It is one of the 22 scheduled languages of India. In the 1960s and the 1970s, when the Maithili speakers demanded a separate Mithila state, the speakers of the closely related varieties, Angika and Bajjika, made counter-demands for recognition of their languages.</skos:definition>
   </skos:Concept>
