      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="svr">Savara</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">svr</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">svr</skos:notation>
      <skos:prefLabel xml:lang="en">Savara</skos:prefLabel>
      <dc:identifier>SVR</dc:identifier>
      <atold:op-code>SVR</atold:op-code>
      <at:op-code>SVR</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SVR</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>svr</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Hammarstrom (2015) states that it has been checked quite carefully that no Dravidian language exists matching the name Savara or any of the other information in the entry (p.c. David Stampe 2011). Barb Waugh (SIL) responded to queries about Savara stating that she did not believe that the language existed at all. She only knew Savara as an alternate name for Sora [srb], a Munda language.</skos:scopeNote>
      <at:end.use>2016-01-15</at:end.use>
   </skos:Concept>
