      <skos:altLabel xml:lang="mvw">Machinga</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mvw</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mvw</skos:notation>
      <skos:prefLabel xml:lang="en">Machinga</skos:prefLabel>
      <dc:identifier>MVW</dc:identifier>
      <atold:op-code>MVW</atold:op-code>
      <at:op-code>MVW</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MVW</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mvw</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Machinga is a Bantu language spoken in Tanzania and northern Mozambique. Together with Makonde (kde), Matambwe (wtb) and Ndonde Hamba (njd), it forms the Makonde group, which is classified within the Volta-Congo primary branch. Like other Bantu languages, Machinga has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
