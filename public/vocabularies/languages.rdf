      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Wangganguru</skos:altLabel>
      <skos:altLabel xml:lang="wgg">Wangkangurru</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wgg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wgg</skos:notation>
      <skos:prefLabel xml:lang="en">Wangkangurru</skos:prefLabel>
      <dc:identifier>WGG</dc:identifier>
      <atold:op-code>WGG</atold:op-code>
      <at:op-code>WGG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WGG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wgg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Wangkangurru is a moribund Pama-Nyungan language spoken in Simpson Desert area in the state of South Australia. It classified within the Karnic sub-branch of the Pama–Nyungan languages, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
