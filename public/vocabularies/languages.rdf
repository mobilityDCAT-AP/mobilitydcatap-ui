   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/BVR"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="bvr">Burarra</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">bvr</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">bvr</skos:notation>
      <skos:prefLabel xml:lang="en">Burarra</skos:prefLabel>
      <dc:identifier>BVR</dc:identifier>
      <atold:op-code>BVR</atold:op-code>
      <at:op-code>BVR</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>BVR</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>bvr</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Burarra is a stable Australian Aboriginal language spoken in Arnhem Land. It is closely related to Gurr-goni, and both belong to the Maningrida group of languages. This group is sometimes classified with the Gunwinyguan languages in a proposed Macro-Gunwinyguan family, which is distinct from the Pama–Nyungan language family.</skos:definition>
   </skos:Concept>
