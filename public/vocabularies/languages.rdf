      <atold:op-code>SEH</atold:op-code>
      <at:op-code>SEH</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SEH</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>seh</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Sena is a Bantu language spoken in Mozambique (Malawian Sena), Malawi (Barwe) and Mozambique (Mozambiquean Sena). Sena is one of the Nyasa languages. Sena is one of Zimbabwe‘s 16 official languages. In Mozambique, it is one of the main vernaculars.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/AJP"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="ar">اللهجة الشامية الجنوبية</skos:altLabel>
      <skos:altLabel xml:lang="ajp">al-lahja š-šāmiyya l-janūbiyya</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ajp</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ajp</skos:notation>
      <skos:prefLabel xml:lang="en">South Levantine Arabic</skos:prefLabel>
      <dc:identifier>AJP</dc:identifier>
      <atold:op-code>AJP</atold:op-code>
      <at:op-code>AJP</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>AJP</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ajp</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Academic sources do not classify sedentary Levantine Arabic varieties into North and South. There is no evidence that North Levantine Arabic and South Levantine Arabic are linguistically well-defined entities. There is no separate development of the two varieties. In particular, native speakers do not define their language as “North Levantine” or “South Levantine”.</skos:scopeNote>
      <at:end.use>2023-01-20</at:end.use>
   </skos:Concept>
