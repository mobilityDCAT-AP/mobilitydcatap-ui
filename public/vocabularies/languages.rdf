                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="dud">Hun-Saare</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">dud</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">dud</skos:notation>
      <skos:prefLabel xml:lang="en">Hun-Saare</skos:prefLabel>
      <dc:identifier>DUD</dc:identifier>
      <atold:op-code>DUD</atold:op-code>
      <at:op-code>DUD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>DUD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>dud</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Hun-Saare should be split into two languages [ut-Hun, uth and us-Saare, uss]. What was assummed to be one language [dud] is two distinst languages which each have their own name for their language. These languages are not mutually intelligible.</skos:scopeNote>
      <at:end.use>2019-01-25</at:end.use>
   </skos:Concept>
