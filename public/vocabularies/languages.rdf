   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MHN"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="de">Fersentalerisch</skos:altLabel>
      <skos:altLabel xml:lang="de">Bersntolerisch</skos:altLabel>
      <skos:altLabel xml:lang="mhn">Mócheno</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mhn</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mhn</skos:notation>
      <skos:prefLabel xml:lang="en">Mòcheno</skos:prefLabel>
      <dc:identifier>MHN</dc:identifier>
      <atold:op-code>MHN</atold:op-code>
      <at:op-code>MHN</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MHN</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mhn</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Mòcheno (Italian pronunciation: ˈmɔːkeno) is an Upper German variety spoken in three towns of the Bersntol (Italian: Valle del Fersina), in Trentino, northeastern Italy. Mòcheno is closely related to Bavarian and is variously classified either as a Southern Bavarian variety or a separate language of its own. Mòcheno speakers reportedly partially understand Bavarian, Cimbrian, or Standard German. However, many essential differences in grammar, vocabulary, and pronunciation render it difficult for speakers of Standard German to understand. Like other Germanic languages, Mòcheno belongs to the Indo-European languages, the world’s largest language family by number of native speakers.</skos:definition>
   </skos:Concept>
