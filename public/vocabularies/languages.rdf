   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/ZMD"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="zmd">Maridan</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">zmd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">zmd</skos:notation>
      <skos:prefLabel xml:lang="en">Maridan</skos:prefLabel>
      <dc:identifier>ZMD</dc:identifier>
      <atold:op-code>ZMD</atold:op-code>
      <at:op-code>ZMD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ZMD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>zmd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Maridan is an endangered Australian Aboriginal language traditionally spoken in the Daly River area of the Northern Territory. It belongs to the small family of Western Daly languages, and more specifically to its Marithielic sub-branch.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/KMB"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="kmb">Kimbundu</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">kmb</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">kmb</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2T">kmb</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2B">kmb</skos:notation>
      <skos:prefLabel xml:lang="en">Kimbundu</skos:prefLabel>
      <dc:identifier>KMB</dc:identifier>
      <atold:op-code>KMB</atold:op-code>
      <at:op-code>KMB</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KMB</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kmb</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2t</dc:source>
            <at:legacy-code>kmb</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2b</dc:source>
            <at:legacy-code>kmb</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kimbundu is a narrow Bantu language spoken in the north-west of Angola. It is the second-most-widely-spoken Bantu language in Angola. Together with Mpinda (pnd) and Kibala (blv), it belongs to the Mbundu group, which is classified within the Volta-Congo primary branch. Like other Bantu languages, Mpinda has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
