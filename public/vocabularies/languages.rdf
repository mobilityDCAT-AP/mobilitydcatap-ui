   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/SDM"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="sdm">Semandang</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">sdm</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">sdm</skos:notation>
      <skos:prefLabel xml:lang="en">Semandang</skos:prefLabel>
      <dc:identifier>SDM</dc:identifier>
      <atold:op-code>SDM</atold:op-code>
      <at:op-code>SDM</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SDM</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>sdm</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">While Semandang does have many dialects, Gerai and Beginci are definitely NOT dialects of Semandang and should have their own language code. Semandang is a very large language group with at least 12 different dialects, Kualan being by far the biggest. Gerai is a very small language group and is made up of just one dialect. Thus, semandang [sdm] split into Semandang [sdq], Beginci [ebc] and Gerai [gef]</skos:scopeNote>
      <at:end.use>2020-01-23</at:end.use>
   </skos:Concept>
