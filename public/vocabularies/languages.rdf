      <skos:prefLabel xml:lang="cs">jazyk ndau</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">N-dabhais</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">език ндау</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">ndau</skos:prefLabel>
      <skos:prefLabel xml:lang="es">ndau</skos:prefLabel>
      <skos:prefLabel xml:lang="da">ndau</skos:prefLabel>
