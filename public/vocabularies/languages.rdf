   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/XSJ"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="xsj">Subi</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xsj</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xsj</skos:notation>
      <skos:prefLabel xml:lang="en">Subi</skos:prefLabel>
      <dc:identifier>XSJ</dc:identifier>
      <atold:op-code>XSJ</atold:op-code>
      <at:op-code>XSJ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XSJ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xsj</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Subi is a minor East Bantu language spoken on the southern shore of Lake Victoria. It is closely related to Zinza (zin). Both languages are classified within the Volta-Congo primary branch of the Atlantic-Congo language family. Like other Bantu languages, Subi has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/ISH"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="ish">Esan</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ish</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ish</skos:notation>
      <skos:prefLabel xml:lang="en">Esan</skos:prefLabel>
      <dc:identifier>ISH</dc:identifier>
      <atold:op-code>ISH</atold:op-code>
      <at:op-code>ISH</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ISH</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ish</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Esan is an Edoid language spoken in Edo State in Nigeria. With its dialects, Ẹkpoma (or Ekpon) and Iguepen, it forms the Esan subgroup. Similar to the more well-known Bantu languages, Esan also features noun class systems, which are a key characteristic used to identify the broader Atlantic–Congo language family, to which Esan belongs as part of the Volta–Congo primary branch.</skos:definition>
   </skos:Concept>
