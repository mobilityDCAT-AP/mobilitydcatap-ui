         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Jinyu is a group of Chinese linguistic varieties spoken in northern China, including most of Shanxi province, much of central Inner Mongolia, and adjoining areas in Hebei, Henan, and Shaanxi provinces. The status of Jin is disputed among linguists; some prefer to include it within Mandarin, but others set it apart as a closely related but separate sister group.</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/ZHO"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/CZH"
