   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/TVX"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Tevorang</skos:altLabel>
      <skos:altLabel xml:lang="tvx">Taivoan</skos:altLabel>
      <skos:altLabel xml:lang="en">Taivuan</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">tvx</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">tvx</skos:notation>
      <skos:prefLabel xml:lang="en">Taivoan</skos:prefLabel>
      <dc:identifier>TVX</dc:identifier>
      <atold:op-code>TVX</atold:op-code>
      <at:op-code>TVX</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TVX</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>tvx</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Taivoan, or Taivuan, is a dormant Formosan language under revitalisation. It was spoken in the Siraya region of Taiwan. Taivoan used to be regarded as a dialect of Siraya, but now more evidence has shown that they should be classified as separate languages. Taivoan belongs to the East Formosan primary branch of the Austronesian language family. Like many Austronesian languages, Taivoan is characterised by voice alternations in its clause structure and productive morphology, including affixation and reduplication to form new words.</skos:definition>
   </skos:Concept>
