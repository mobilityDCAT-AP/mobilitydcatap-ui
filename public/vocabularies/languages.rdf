      <skos:prefLabel xml:lang="nl">Tunesische Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="da">tunesisk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="et">tuneesia viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Tuneżina</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">tunisiskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni tunisina</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Tunisia</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">tunisiečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta na Túinéise</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">tunizijski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">tuniški znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">tunéziai jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual tunisina</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">тунизийски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">tuniský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes tunisienne</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Tunisian Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Tunesische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">tunisialainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos tunecina</skos:prefLabel>
      <skos:prefLabel xml:lang="el">τυνησιακή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">tuniský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">tunezyjski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">tunisiešu zīmju valoda</skos:prefLabel>
