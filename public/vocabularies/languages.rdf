      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ppr</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ppr</skos:notation>
      <skos:prefLabel xml:lang="en">Piru</skos:prefLabel>
      <dc:identifier>PPR</dc:identifier>
      <atold:op-code>PPR</atold:op-code>
      <at:op-code>PPR</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>PPR</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ppr</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">“At the head of Piru Bay, a very small number of elderly in Piru village still remember the indigenous language. Although Dyen (1978:392) was doubtful about the classification of this speech community, it can be demonstrated that Piru is a dialect of Luhu, a fact which Van Hoevell correctly stated in 1877.</skos:scopeNote>
      <at:end.use>2013-01-23</at:end.use>
   </skos:Concept>
