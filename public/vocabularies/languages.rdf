      <skos:prefLabel xml:lang="es">lengua de signos letona</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Latvian Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Lettische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Laitvia</skos:prefLabel>
      <skos:prefLabel xml:lang="el">λετονική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">lotyšský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Letonia</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">latviešu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">lett jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">latvijski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">latvijski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes lettone</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">latvių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni lettone</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">latvialainen vittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Letse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">lettiskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">łotewski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Latvjana</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">латвийски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="et">läti viipekeel</skos:prefLabel>
      <dc:identifier>LSL</dc:identifier>
      <atold:op-code>LSL</atold:op-code>
