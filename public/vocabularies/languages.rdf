   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/TCU"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="tcu">Chinatú</skos:altLabel>
      <skos:altLabel xml:lang="tcu">Turuachi</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">tcu</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">tcu</skos:notation>
      <skos:prefLabel xml:lang="tcu">Southeastern Tarahumara</skos:prefLabel>
      <dc:identifier>TCU</dc:identifier>
      <atold:op-code>TCU</atold:op-code>
      <at:op-code>TCU</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TCU</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>tcu</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Southeastern Tarahumara is a Southern Uto-Aztecan language spoken in northern Mexico. Together with Lowland Tarahumara (tac), Central Tarahumara (tar), Northern Tarahumara (thh) and Southwestern Tarahumara (twr), it forms the Tarahumaran group. The native name of Tarahumara language is Rarámuri or Ralámuli ra'ícha.</skos:definition>
   </skos:Concept>
