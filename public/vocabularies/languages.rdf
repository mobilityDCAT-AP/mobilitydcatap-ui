   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/TNF"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="tnf">Tangshewi</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">tnf</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">tnf</skos:notation>
      <skos:prefLabel xml:lang="en">Tangshewi</skos:prefLabel>
      <dc:identifier>TNF</dc:identifier>
      <atold:op-code>TNF</atold:op-code>
      <at:op-code>TNF</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TNF</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>tnf</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Lexical similiarity of Dari and Tangshewi is between 86% and 90%. Comprehension testing of Eastern Farsi (Dari) showed that Dari is highly intelligible for the Tangshewi people. Thus, Tangshewi (tnf) merged into [prs] Dari.</skos:scopeNote>
      <at:end.use>2010-01-18</at:end.use>
   </skos:Concept>
