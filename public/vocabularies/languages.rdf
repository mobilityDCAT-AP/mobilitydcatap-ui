   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/NBJ"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="nbj">Ngarinyman</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">nbj</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">nbj</skos:notation>
      <skos:prefLabel xml:lang="en">Ngarinyman</skos:prefLabel>
      <dc:identifier>NBJ</dc:identifier>
      <atold:op-code>NBJ</atold:op-code>
      <at:op-code>NBJ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>NBJ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nbj</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Ngarinyman is an endangered Pama–Nyungan language spoken by the Ngarinyman in the Northern Territory, Australia. It is closely related to Gurindji, and sometimes considered a dialect of Gurindji. Both belong to the Ngumpin sub-group within the Pama-Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages.</skos:definition>
   </skos:Concept>
