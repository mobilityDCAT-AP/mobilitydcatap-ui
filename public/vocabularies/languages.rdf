   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/VKI"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="vki">Ija-Zuba</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">vki</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">vki</skos:notation>
      <skos:prefLabel xml:lang="en">Ija-Zuba</skos:prefLabel>
      <dc:identifier>VKI</dc:identifier>
      <atold:op-code>VKI</atold:op-code>
      <at:op-code>VKI</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>VKI</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>vki</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Ija-Zuba, although sharing a general identity as Koro, represent two languages that are linguistically different, with the Ija representing Koro Nulu and Zuba representing Koro Zuba. Thus, Ija-Zuba [wki] split into Koro Nulu [vkn] and Koro Zuba [vkz]</skos:scopeNote>
      <at:end.use>2021-01-15</at:end.use>
   </skos:Concept>
