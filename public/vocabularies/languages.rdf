   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/YUB"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="yub">Yugambal</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">yub</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">yub</skos:notation>
      <skos:prefLabel xml:lang="en">Yugambal</skos:prefLabel>
      <dc:identifier>YUB</dc:identifier>
      <atold:op-code>YUB</atold:op-code>
      <at:op-code>YUB</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>YUB</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>yub</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Yugambal is an extinct Australian Aboriginal language formerly spoken in northern New South Wales. It may have been a Kuric language. However, it has been confused with the Bundjalung dialect of Yugambeh in the literature. According to Glottolog, Yugambal is closely related to Bigambal. In any case, Yugambal belongs to the Pama–Nyungan family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
