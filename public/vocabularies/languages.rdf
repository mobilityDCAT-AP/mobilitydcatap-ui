      <skos:prefLabel xml:lang="sk">posunkový jazyk Trinidadu a Tobaga</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νοηματική γλώσσα Τρίνινταντ και Τομπέιγκο</skos:prefLabel>
