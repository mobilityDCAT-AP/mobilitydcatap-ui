      <at:authority-code>SNB</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>snb</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Iban and Sebuyau originated from the same area of Indonesia in about 1500, and have not diverged much since then. Though they had a separate ethnic identification for a time, the languages have remained the same.</skos:scopeNote>
      <at:end.use>2022-01-20</at:end.use>
   </skos:Concept>
