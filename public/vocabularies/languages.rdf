      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">bij</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">bij</skos:notation>
      <skos:prefLabel xml:lang="en">Vaghat-Ya-Bijim-Legeri</skos:prefLabel>
      <dc:identifier>BIJ</dc:identifier>
      <atold:op-code>BIJ</atold:op-code>
      <at:op-code>BIJ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>BIJ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>bij</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">the SIL Nigeria Survey Team lead by Yakubu Danladi visited Bijim [jbm], Luggere, Tiyaa [tyy], and Kadung [dkg] speaking villages. Luggere was reported to be a variety of Bijim while Tiyaa (formerly known as Ya) and Kadung are viewed as different languages.</skos:scopeNote>
      <at:end.use>2021-01-15</at:end.use>
   </skos:Concept>
