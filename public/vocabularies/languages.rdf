      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Kaco'</skos:altLabel>
      <skos:altLabel xml:lang="xkk">Kachok'</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xkk</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xkk</skos:notation>
      <skos:prefLabel xml:lang="en">Kachok'</skos:prefLabel>
      <dc:identifier>XKK</dc:identifier>
      <atold:op-code>XKK</atold:op-code>
      <at:op-code>XKK</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XKK</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xkk</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kachok (Kacoʼ) belongs to the Bahnaric primary branch of the Austroasiatic language family. It is spoken in northeastern Cambodia, especially in Ratanakiri Province. Together with its closest relative, Romam, Kachok forms the Lamamic group, though the two languages are quite distinct.</skos:definition>
   </skos:Concept>
