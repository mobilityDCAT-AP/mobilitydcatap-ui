   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/VJK"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="vjk">बज्जिका</skos:altLabel>
      <skos:altLabel xml:lang="en">Vajjika</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">vjk</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">vjk</skos:notation>
      <skos:prefLabel xml:lang="en">Bajjika</skos:prefLabel>
      <dc:identifier>VJK</dc:identifier>
      <atold:op-code>VJK</atold:op-code>
      <at:op-code>VJK</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>VJK</at:authority-code>
      <skos:definition xml:lang="en">Bajjika is an Indo-Aryan language variety, which in turn belongs to the Indo-European language family. It is spoken in the north-western part of Bihar, India and in Nepal. It is also classified as a dialect of Maithili language and is known as Western Maithili. In the 1960s and the 1970s, when the Maithili speakers demanded a separate Mithila state, the Angika and Bajjika speakers made counter-demands for recognition of their languages.</skos:definition>
   </skos:Concept>
