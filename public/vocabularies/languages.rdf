   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/HUC"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="huc">ǂʼAmkoe</skos:altLabel>
      <skos:altLabel xml:lang="en">ǂ'Amkhoe</skos:altLabel>
      <skos:altLabel xml:lang="en">ǂHoan</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">huc</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">huc</skos:notation>
      <skos:prefLabel xml:lang="en">ǂHua</skos:prefLabel>
      <dc:identifier>HUC</dc:identifier>
      <atold:op-code>HUC</atold:op-code>
      <at:op-code>HUC</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>HUC</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>huc</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">ǂHua, or ǂʼAmkoe, formerly called by the dialectal name ǂHoan, is a severely endangered Kxʼa language of Botswana. ǂHua was shown to be related to the Juu languages by Honken and Heine (2010), and these have since been classified together in the Kxʼa language family.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/KOX"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
