      <skos:prefLabel xml:lang="sk">madagaskarský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">madagasgiskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Madagassische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Madagascar Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Mhadagascar</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos de Madagascar</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">madagaskarski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">madagaskariečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali ta’ Madagascar</skos:prefLabel>
