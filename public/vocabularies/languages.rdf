      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Tyerrenoterpanner</skos:altLabel>
      <skos:altLabel xml:lang="xph">Tyerrenoterpanner</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xph</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xph</skos:notation>
      <skos:prefLabel xml:lang="en">North Midlands Tasmanian</skos:prefLabel>
      <dc:identifier>XPH</dc:identifier>
      <atold:op-code>XPH</atold:op-code>
      <at:op-code>XPH</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XPH</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xph</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">North Midland Tasmanian, or Tyerrernotepanner, was an Aboriginal language of northeastern Tasmania, along the Tamar River and inland of Ben Lomond and Great Oyster Bay. Tyerrernotepanner is attested in the 125 words of the Port Dalrymple vocabulary collected by J.-P. Gaimard in the Tamar River region.</skos:definition>
   </skos:Concept>
