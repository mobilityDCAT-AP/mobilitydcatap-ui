      <skos:prefLabel xml:lang="da">new zealandsk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="no">nyzealandsk tegnspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">novozélandský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta na Nua-Shéalainne</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">новозеландский жестовый язык</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni della Nuova Zelanda</skos:prefLabel>
      <skos:prefLabel xml:lang="en">New Zealand Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">nowozelandzki język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νεοζηλανδική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual neozelandesa</skos:prefLabel>
      <skos:prefLabel xml:lang="uk">новозеландська мова жестів</skos:prefLabel>
      <skos:prefLabel xml:lang="is">nýsjálenskt táknmál</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">novozélandský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="sr">новозеландски знаковни језик</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes néo-zélandaise</skos:prefLabel>
      <skos:prefLabel xml:lang="et">uus-meremaa viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">új-zélandi jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Jaunzēlandes zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Nieuw-Zeelandse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">nyzeeländskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali ta’ New Zealand</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos neozenlandesa</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от Нова Зеландия</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">uusiseelantilainen viittomakieli</skos:prefLabel>
      <dc:identifier>NZS</dc:identifier>
      <atold:op-code>NZS</atold:op-code>
      <at:op-code>NZS</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>NZS</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nzs</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">New Zealand Sign Language is a sign language used in New Zealand. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
