   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/XMH"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="xmh">Kugu-Muminh</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xmh</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xmh</skos:notation>
      <skos:prefLabel xml:lang="en">Kugu-Muminh</skos:prefLabel>
      <dc:identifier>XMH</dc:identifier>
      <atold:op-code>XMH</atold:op-code>
      <at:op-code>XMH</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XMH</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xmh</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kugu-Muminh is an endangered Australian Aboriginal language spoken by Wik peoples on the Cape York Peninsula of Queensland. Kuku-Muminh is closely related to Kuku-Mu'inh (xmp) and Kuku-Uwanh (uwa). All belong to the Paman sub-branch within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
