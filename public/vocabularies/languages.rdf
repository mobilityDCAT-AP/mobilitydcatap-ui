   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/XYB"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="xyb">Yandjibara</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xyb</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xyb</skos:notation>
      <skos:prefLabel xml:lang="en">Yandjibara</skos:prefLabel>
      <dc:identifier>XYB</dc:identifier>
      <atold:op-code>XYB</atold:op-code>
      <at:op-code>XYB</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XYB</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xyb</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Yandjibara is an extinct Pama-Nyungan language within the Maric sub-branch. It is closely related to Bidjara. It was spoken in Queensland, Australia. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
