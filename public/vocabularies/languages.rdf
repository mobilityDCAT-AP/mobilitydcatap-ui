   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/LRG"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Gulumirrgin</skos:altLabel>
      <skos:altLabel xml:lang="lrg">Laragia</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">lrg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">lrg</skos:notation>
      <skos:prefLabel xml:lang="en">Laragia</skos:prefLabel>
      <dc:identifier>LRG</dc:identifier>
      <atold:op-code>LRG</atold:op-code>
      <at:op-code>LRG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>LRG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>lrg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Laragia, also known as Gulumirrgin, is a moribund Australian Aboriginal language spoken by just six people near the city of Darwin in northern Australia as of 1983. Only 41 people claimed to know the Laragiya language in 2021. Laragiya was once considered a language isolate, but Mark Harvey has made a case for it being part of a family of Darwin Region languages.</skos:definition>
   </skos:Concept>
