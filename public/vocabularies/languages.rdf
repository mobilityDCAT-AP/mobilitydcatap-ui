   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/TJJ"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="tjj">Yangathimri</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">tjj</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">tjj</skos:notation>
      <skos:prefLabel xml:lang="en">Tjungundji</skos:prefLabel>
      <dc:identifier>TJJ</dc:identifier>
      <atold:op-code>TJJ</atold:op-code>
      <at:op-code>TJJ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TJJ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>tjj</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Tjungundji, also known as Yangathimri, is a Pama-Nyungan language spoken in central and western Cape York Peninsula in northern Queensland, Australia. Together with the extinct Anguthimri language, it is classified within the Paman branch and more specifically within the Northern Pama sub-branch. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
