      <skos:prefLabel xml:lang="es">lengua de signos catalana</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Katalanische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne catalan</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">katalán jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="el">καταλανική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual catalã</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes catalane</skos:prefLabel>
      <dc:identifier>CSC</dc:identifier>
