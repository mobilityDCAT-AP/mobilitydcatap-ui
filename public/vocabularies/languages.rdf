      <skos:prefLabel xml:lang="sl">južnoafriški znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni sudafricana</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">jihoafrický znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="no">sørafrikansk tegnspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">eteläafrikkalainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Zuid-Afrikaanse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νοτιοαφρικανική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Africa de Sud</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">sydafrikanskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Pietų Afrikos gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali tal-Afrika t’Isfel</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos sudafricana</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от Южна Африка</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual sul-africana</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">dél-afrikai jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">juhoafrický posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Südafrikanische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="et">lõuna-aafrika viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta na hAfraice Theas</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">južnoafrički znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">południowoafrykański język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dienvidāfrikas zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="da">sydafrikansk tegnsprog</skos:prefLabel>
      <dc:identifier>SFS</dc:identifier>
      <atold:op-code>SFS</atold:op-code>
      <at:op-code>SFS</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SFS</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>sfs</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">South African Sign Language is a sign language used in South Africa. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
