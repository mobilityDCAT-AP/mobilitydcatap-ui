   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/KKY"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Guguyimidjir</skos:altLabel>
      <skos:altLabel xml:lang="kky">Guugu Yimidhirr</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">kky</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">kky</skos:notation>
      <skos:prefLabel xml:lang="en">Guugu Yimidhirr</skos:prefLabel>
      <dc:identifier>KKY</dc:identifier>
      <atold:op-code>KKY</atold:op-code>
      <at:op-code>KKY</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KKY</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kky</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Guugu Yimidhirr is a Pama-Nyungan language spoken by the Guugu Yimithirr people of Far North Queensland, Australia. Most of the speakers today live at the community of Hope Vale, not far from Cooktown. Guugu Yimithirr is the source language of the word kangaroo (gangurru). It is more closely related to Yalandyic and Yidinic languages. Pama–Nyungan language family is the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
