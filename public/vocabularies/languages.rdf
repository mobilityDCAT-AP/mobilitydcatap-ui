   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/KDV"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="kdv">Kado</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">kdv</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">kdv</skos:notation>
      <skos:prefLabel xml:lang="en">Kado</skos:prefLabel>
      <dc:identifier>KDV</dc:identifier>
      <atold:op-code>KDV</atold:op-code>
      <at:op-code>KDV</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KDV</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kdv</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Research conducted in 2008 showed that Kadu [zkd] and Kanan [zkn] speakers do not adequately understand each other's languages, and have to switch to Burmese in order to communicate with speakers from the other community. [Thus, Kado, kdv, should be deprecated.]</skos:scopeNote>
      <at:end.use>2012-02-03</at:end.use>
   </skos:Concept>
