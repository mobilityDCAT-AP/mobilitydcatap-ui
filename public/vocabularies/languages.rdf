      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="byy">Buya</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">byy</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">byy</skos:notation>
      <skos:prefLabel xml:lang="en">Buya</skos:prefLabel>
      <dc:identifier>BYY</dc:identifier>
      <atold:op-code>BYY</atold:op-code>
      <at:op-code>BYY</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>BYY</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>byy</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Buya [byy] is given as an unclassifed Southern Bantoid language of the DRC without a location. As with Borna [bxx], this too must emanate from Welmers (1971:788-789). Since that is the only source mentioning such a language with exactly that much (lack of) information. In all likelihood, Buya [byy] is a rendering of a DRC language already counted in another E16 entry, presumbly Buyu [byi].</skos:scopeNote>
      <at:end.use>2015-01-12</at:end.use>
   </skos:Concept>
