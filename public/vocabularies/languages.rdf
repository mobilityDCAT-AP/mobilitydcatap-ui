      <skos:prefLabel xml:lang="el">βαλενθιανά</skos:prefLabel>
      <skos:prefLabel xml:lang="uk">валенсійська мова</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">valencijski</skos:prefLabel>
      <dc:identifier>0D0</dc:identifier>
      <atold:op-code>0D0</atold:op-code>
      <at:op-code>0D0</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>0D0</at:authority-code>
      <skos:historyNote xml:lang="en">This authority code is retired as according to RFC 5646 and iana subtag-registry the first part of the code must not have decimals.</skos:historyNote>
      <at:end.use>2018-04-15</at:end.use>
      <skos:definition xml:lang="en">Valencian is a Catalan dialect spoken in the Valencian Community in Spain.The Valencian Academy of the Language considers Catalan and Valencian to be simply two names for the same language.</skos:definition>
      <skos:definition xml:lang="fr">Le valencien est un dialecte catalan parlé dans la Communauté de Valence en Espagne.L’Académie valencienne de la langue considère simplement le catalan et le valencien comme deux noms pour la même langue.</skos:definition>
      <skos:changeNote xml:lang="en">Valencian has no ISO-639 language codes.</skos:changeNote>
      <skos:changeNote xml:lang="fr">Le valencien n'a pas de codes ISO 639.</skos:changeNote>
   </skos:Concept>
