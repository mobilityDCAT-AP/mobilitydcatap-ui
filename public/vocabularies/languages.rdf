      <skos:altLabel xml:lang="en">Dao</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">daz</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">daz</skos:notation>
      <skos:prefLabel xml:lang="en">Moi-Wadea</skos:prefLabel>
      <dc:identifier>DAZ</dc:identifier>
      <atold:op-code>DAZ</atold:op-code>
      <at:op-code>DAZ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>DAZ</at:authority-code>
