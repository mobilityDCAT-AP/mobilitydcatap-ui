      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>CXH</at:authority-code>
      <skos:definition xml:lang="en">Cha'ari is an Afro-Asiatic language spoken in Nigeria. It belongs to the endangered Western Chadic sub-branch whose speakers are shifting to Hausa. Together with Tulai and Zeem, it forms the Nuclear Zeemic group.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/XMU"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="xmu">Kamu</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xmu</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xmu</skos:notation>
      <skos:prefLabel xml:lang="en">Kamu</skos:prefLabel>
      <dc:identifier>XMU</dc:identifier>
      <atold:op-code>XMU</atold:op-code>
      <at:op-code>XMU</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XMU</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xmu</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kamu is an extinct Australian Aboriginal language formerly spoken by the Kamu people along the Daly River in the Northern Territory. It is often grouped with Matngala in the small Eastern Daly group, unrelated to the larger Australian Aboriginal language families.</skos:definition>
   </skos:Concept>
