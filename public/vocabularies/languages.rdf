   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/HNG"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="hng">Kihungu</skos:altLabel>
      <skos:altLabel xml:lang="hng">Dihungu</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">hng</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">hng</skos:notation>
      <skos:prefLabel xml:lang="en">Hungu</skos:prefLabel>
      <dc:identifier>HNG</dc:identifier>
      <atold:op-code>HNG</atold:op-code>
      <at:op-code>HNG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>HNG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>hng</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Hungu is a Southern Bantoid language spoken in Angola. It is considered an endangered language. Hungu belongs to the Kikongo group, which is classified within the Volta-Congo branch. Like other Bantu and Bantoid languages, hungu has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
