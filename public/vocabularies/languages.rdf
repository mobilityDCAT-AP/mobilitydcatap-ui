      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Narau</skos:altLabel>
      <skos:altLabel xml:lang="bpp">Kaure</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">bpp</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">bpp</skos:notation>
      <skos:prefLabel xml:lang="en">Kaure</skos:prefLabel>
      <dc:identifier>BPP</dc:identifier>
      <atold:op-code>BPP</atold:op-code>
      <at:op-code>BPP</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>BPP</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>bpp</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kaure is a Papuan language of West Papua. It is spoken in the villages of Lereh, Harna, Wes, Masta and Aurina. Narau is either a dialect or a closely related language. Kaure and Kosare (Kosadle) are clearly related languages, but their relation to other Papuan languages has not been clarified.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MZG"
