      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="yiy">Yir Yoront</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">yiy</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">yiy</skos:notation>
      <skos:prefLabel xml:lang="en">Yir Yoront</skos:prefLabel>
      <dc:identifier>YIY</dc:identifier>
      <atold:op-code>YIY</atold:op-code>
      <at:op-code>YIY</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>YIY</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>yiy</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Dr. Claire Bowern has done recent fieldwork in the area and provided us with exact centroid coordinates of the area where the languages are spoken, and although extrapolating language relationship from geographical proximity is sometimes dangerous the two distinct sets of centroid coordinates in this case supports the claim that the languages are separate. Thus, Yir Yoront [yiy] split into Yir Yoront [yyr] and Yirrk-Mel [yrm].</skos:scopeNote>
      <at:end.use>2013-01-23</at:end.use>
   </skos:Concept>
