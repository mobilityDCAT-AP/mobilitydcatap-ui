      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2b</dc:source>
            <at:legacy-code>min</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="fr">Le minangkabau est une langue austronésienne parlée en Indonésie, dans le nord de l’île de Sumatra.Il fait partie des langues malaïques qui représentent un des sous-groupes du malayo-polynésien occidental.</skos:definition>
      <skos:definition xml:lang="en">Minangkabau is an Austronesian language spoken by the Minangkabau of West Sumatra. The language is also a lingua franca along the western coastal region of the province of North Sumatra, and is even used in parts of Aceh, where the language is called Aneuk Jamee. It is also spoken in some parts of Malaysia.There are great grammatical similarities between the Minangkabau language and Malay.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/ADB"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="adb">Atauran</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">adb</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">adb</skos:notation>
      <skos:prefLabel xml:lang="en">Atauran</skos:prefLabel>
      <dc:identifier>ADB</dc:identifier>
      <atold:op-code>ADB</atold:op-code>
      <at:op-code>ADB</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ADB</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>adb</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Atauran is an Austronesian language spoken on Atauro island and in Manatuto Municipality, East Timor. It belongs to the Malayo-Polynesian sub-branch of Austronesian languages and is closely related to Wetarese and Galoli. The three main dialects of Atauran are Rasua, Raklungu and Hresuk.</skos:definition>
   </skos:Concept>
