      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="lgs">Língua Gestual Guineense</skos:altLabel>
      <skos:altLabel xml:lang="pt">Língua gestual guineense</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">lgs</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">lgs</skos:notation>
      <skos:prefLabel xml:lang="en">Guinea-Bissau Sign Language</skos:prefLabel>
      <dc:identifier>LGS</dc:identifier>
      <atold:op-code>LGS</atold:op-code>
      <at:op-code>LGS</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>LGS</at:authority-code>
      <skos:definition xml:lang="en">Guinea-Bissau Sign Language is an incipient sign language evolving from the single school for the deaf in Guinea-Bissau, which was founded in Bissau in 2003. It is not directly related to the Portuguese sign language, although it has borrowed the alphabet from it.</skos:definition>
   </skos:Concept>
