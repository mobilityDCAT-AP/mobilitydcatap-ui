   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/THD"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Thayore</skos:altLabel>
      <skos:altLabel xml:lang="thd">Kuuk Thayorre</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">thd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">thd</skos:notation>
      <skos:prefLabel xml:lang="en">Kuuk Thayorre</skos:prefLabel>
      <dc:identifier>THD</dc:identifier>
      <atold:op-code>THD</atold:op-code>
      <at:op-code>THD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>THD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>thd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kuuk Thayorre, also known as Thayore, is a stable Pama-Nyungan language spoken in the settlement Pormpuraaw on the western part of the Cape York Peninsula in Queensland, Australia. It is thought to be related to the extinct Kuuk-Yak language. Kuuk Thayorre is classified within the Paman branch and more specifically within the Southwest Pama sub-branch. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
