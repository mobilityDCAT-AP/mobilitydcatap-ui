   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/SMA"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="sma">åarjelsaemien gïele</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">sma</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2B">sma</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2T">sma</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">sma</skos:notation>
      <skos:prefLabel xml:lang="sv">sydsamiska</skos:prefLabel>
      <skos:prefLabel xml:lang="no">sørsamisk</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">eteläsaame</skos:prefLabel>
      <skos:prefLabel xml:lang="se">lullisámegiella</skos:prefLabel>
      <skos:prefLabel xml:lang="et">lõunasaami keel</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">южносаа́мский язы́к</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Southern Sami</skos:prefLabel>
      <dc:identifier>SMA</dc:identifier>
      <atold:op-code>SMA</atold:op-code>
      <at:op-code>SMA</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SMA</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2b</dc:source>
            <at:legacy-code>sma</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2t</dc:source>
            <at:legacy-code>sma</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>sma</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Southern Sami (åarjelsaemien gïele) is the southernmost Sami language, spoken in Norway and Sweden. It is an endangered language. Like Baltic-Finnic languages, Sami languages are a branch of the Uralic language family. The designated main municipality of Southern Sami in Norway is Snåasen Municipality. In Sweden, Sami is one of five recognised minority languages.</skos:definition>
   </skos:Concept>
