      </at:op-mapped-code>
      <skos:definition xml:lang="en">Northern Ping is a member of a pair of Sinitic languages spoken mainly in Guilin in northern Guangxi and in Hunan. Pinghua is a trade language, and many of its speakers are genetically distinct from most other Han Chinese.</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/ZHO"/>
   </skos:Concept>
