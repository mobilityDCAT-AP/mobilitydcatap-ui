   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MNT"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="mnt">Maykulan</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mnt</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mnt</skos:notation>
      <skos:prefLabel xml:lang="en">Maykulan</skos:prefLabel>
      <dc:identifier>MNT</dc:identifier>
      <atold:op-code>MNT</atold:op-code>
      <at:op-code>MNT</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MNT</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mnt</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">It is our proposal that the entry currently listed as "Maykulan" (mnt) in Ethnologue 16 has a series of "alternate names" which actually represent a collection of languages under a Mayi group (currently Mayabic). These languages--Mayi-Kulan [xyk], Mayi-Thakurti [xyt], Mayi-Yapi [xyj], and Wunumara [wnn] -- will join the level of the existing Mayaguduna (xmy) and Ngawun (nxn).</skos:scopeNote>
      <at:end.use>2013-01-23</at:end.use>
   </skos:Concept>
