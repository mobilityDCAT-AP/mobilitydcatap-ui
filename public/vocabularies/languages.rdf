      <skos:prefLabel xml:lang="sv">kalanga</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">kalanga</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">kalanga</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">kalanga</skos:prefLabel>
