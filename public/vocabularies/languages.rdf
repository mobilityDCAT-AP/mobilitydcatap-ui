      <skos:prefLabel xml:lang="el">ζαμπιανή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Zambijas zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes zambienne</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">zambiskt teckenspråk</skos:prefLabel>
