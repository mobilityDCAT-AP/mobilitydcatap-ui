      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0002"/>
      <skos:altLabel xml:lang="nsp">Nepalese Sign Language</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">nsp</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">nsp</skos:notation>
      <skos:prefLabel xml:lang="el">νεπαλεζική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от Непал</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">nepalski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">nepalski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Nepalesische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni del Nepal</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">nepaliečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Nepalese Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Nepaliża</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Nepalese Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">nepalilainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">nepálský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Neipeal</skos:prefLabel>
      <skos:prefLabel xml:lang="et">nepali viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="da">nepalesisk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes népalaise</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">nepalski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual nepalesa</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">nepáli jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">nepalesiskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">nepálsky posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">nepāliešu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos nepalesa</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Nepal</skos:prefLabel>
      <dc:identifier>NSP</dc:identifier>
      <atold:op-code>NSP</atold:op-code>
      <at:op-code>NSP</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>NSP</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nsp</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Nepalese Sign Language is a sign language used in Nepal. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
