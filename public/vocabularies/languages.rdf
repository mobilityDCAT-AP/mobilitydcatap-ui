      <skos:prefLabel xml:lang="lv">meksikāņu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Mexicaanse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="el">μεξικανική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Mexican Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Mexic</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual mexicana</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni messicana</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">mexikói jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="et">mehhiko viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">mehiški znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">meksikolainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Messikana</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Mheicsiceo</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Mexikanische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes mexicaine</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">meksički znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">meksykański język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">mexický znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="da">mexicansk tegnsprog</skos:prefLabel>
      <dc:identifier>MFS</dc:identifier>
      <atold:op-code>MFS</atold:op-code>
