   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/KAA"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="kaa">Qaraqalpaq tili</skos:altLabel>
      <skos:altLabel xml:lang="en">Karakalpak</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2T">kaa</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">kaa</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2B">kaa</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">kaa</skos:notation>
      <skos:prefLabel xml:lang="en">Kara-Kalpak</skos:prefLabel>
      <dc:identifier>KAA</dc:identifier>
      <atold:op-code>KAA</atold:op-code>
      <at:op-code>KAA</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KAA</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2t</dc:source>
            <at:legacy-code>kaa</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2b</dc:source>
            <at:legacy-code>kaa</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kaa</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Karakalpak is a Turkic language spoken by Karakalpaks in Karakalpakstan. It is divided into two dialects, Northeastern Karakalpak and Southwestern Karakalpak. It developed alongside Nogai and neighbouring Kazakh languages, being markedly influenced by both. Typologically, Karakalpak belongs to the Kipchak branch of the Turkic languages, thus being closely related to and highly mutually intelligible with Kazakh and Nogai.</skos:definition>
   </skos:Concept>
