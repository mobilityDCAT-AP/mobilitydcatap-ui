   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/AJT"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="ar">لهجة يهودية تونسية</skos:altLabel>
      <skos:altLabel xml:lang="ajt">Lahja Yahudiya Tunisiya</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ajt</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ajt</skos:notation>
      <skos:prefLabel xml:lang="en">Judeo-Tunisian Arabic</skos:prefLabel>
      <dc:identifier>AJT</dc:identifier>
      <atold:op-code>AJT</atold:op-code>
      <at:op-code>AJT</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>AJT</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ajt</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Judeo-Tunisian Arabic is a variety of Tunisian Arabic. It is true that it includes three regional varieties (Goulette, Sousse and Djerba). It is also true that it has several phonological and morphological distinctive characteristics that distinguish it from other Tunisian varieties. However, other dialects of Tunisian Arabic also have distinctive features
that separate them from the Tunis dialect of Tunisian Arabic. That is why I propose to consider Judeo-Tunisian Arabic as a dialect of Tunisian Arabic.</skos:scopeNote>
      <at:end.use>2022-01-20</at:end.use>
   </skos:Concept>
