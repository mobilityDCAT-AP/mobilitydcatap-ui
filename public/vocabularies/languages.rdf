      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="kgd">Kataang</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">kgd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">kgd</skos:notation>
      <skos:prefLabel xml:lang="en">Kataang</skos:prefLabel>
      <dc:identifier>KGD</dc:identifier>
      <atold:op-code>KGD</atold:op-code>
      <at:op-code>KGD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KGD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kgd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">The current iso code of [kgd] conflates three language varieties, which we call Northern Katang [ncq], Southern Katang [sct] and Katang Ta'oiq, the last of which is properly viewed as a dialect of Upper Ta'oih [tth].</skos:scopeNote>
      <at:end.use>2017-01-31</at:end.use>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/NAY"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="nay">Ngarrindjeri</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">nay</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">nay</skos:notation>
      <skos:prefLabel xml:lang="en">Ngarrindjeri</skos:prefLabel>
      <dc:identifier>NAY</dc:identifier>
      <atold:op-code>NAY</atold:op-code>
      <at:op-code>NAY</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>NAY</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nay</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Ngarrindjeri is a dormant Aboriginal language spoken in South Australia. It belongs to the Pama–Nyungan languages, the most widespread family of Australian Aboriginal languages, comprising over 300 of Australia’s roughly 400 Aboriginal languages. There were 312 speakers of Ngarrindjerri recorded in the 2016 Australian census. Language maintenance and revival has increased during the early 21st century.</skos:definition>
   </skos:Concept>
