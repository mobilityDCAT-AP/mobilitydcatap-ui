   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/WAL"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Wolaitta</skos:altLabel>
      <skos:altLabel xml:lang="wal">Wolaytta Doonaa</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wal</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2B">wal</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wal</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2T">wal</skos:notation>
      <skos:prefLabel xml:lang="en">Wolaytta</skos:prefLabel>
      <dc:identifier>WAL</dc:identifier>
      <atold:op-code>WAL</atold:op-code>
      <at:op-code>WAL</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WAL</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wal</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2b</dc:source>
            <at:legacy-code>wal</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2t</dc:source>
            <at:legacy-code>wal</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Wolaytta is a North Omotic language of the Ometo group spoken in the Wolayita Zone and some other parts of southwestern Ethiopia. It is the native language of the Welayta people. The estimates of the population vary greatly because it is not agreed where the boundaries of the language are. There are conflicting claims about how widely Wolaytta is spoken. Some hold that Melo, Oyda, and Gamo-Gofa-Dawro are also dialects, but most sources, including Glottolog and ISO 639-3 now list these as separate languages.</skos:definition>
   </skos:Concept>
