            <at:legacy-code>pmc</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Grimes (1995: 3) indicates that Palumata (now extinct) was a dialect of Hukumina (also extinct). He lists alternate names for Palumata as Palamata, Balamata, and Pala Mada.</skos:scopeNote>
      <at:end.use>2016-01-15</at:end.use>
   </skos:Concept>
