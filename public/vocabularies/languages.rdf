      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Wyandotte</skos:altLabel>
      <skos:altLabel xml:lang="wyn">Wandat</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wyn</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wyn</skos:notation>
      <skos:prefLabel xml:lang="en">Wyandot</skos:prefLabel>
      <dc:identifier>WYN</dc:identifier>
      <atold:op-code>WYN</atold:op-code>
      <at:op-code>WYN</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WYN</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wyn</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Wyandot (also Wyandotte, Wandat) is the Iroquoian language traditionally spoken by the people known as Wyandot or Wyandotte, descended from the Tionontati. It is considered a sister to the Huron-Wendat language, spoken by descendants of the Huron-Wendat Confederacy.</skos:definition>
   </skos:Concept>
