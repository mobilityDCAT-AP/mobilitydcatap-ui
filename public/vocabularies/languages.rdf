   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/XHM"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="xhm">ภาษาเขมรสมัยกลาง</skos:altLabel>
      <skos:altLabel xml:lang="en">Middle Khmer</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xhm</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xhm</skos:notation>
      <skos:prefLabel xml:lang="en">Middle Khmer (1400 to 1850 CE)</skos:prefLabel>
      <dc:identifier>XHM</dc:identifier>
      <atold:op-code>XHM</atold:op-code>
      <at:op-code>XHM</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XHM</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xhm</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Middle Khmer is the historical stage of the Khmer language as it existed between the 14th and 18th centuries, spanning the period between Old Khmer and the modern language. The beginning of the Middle Khmer period roughly coincides with the fall of the Angkorian Khmer Empire to the Siamese Ayutthaya Kingdom and the period of Cambodian history popularly referred to as the Post-Angkor Period.</skos:definition>
   </skos:Concept>
