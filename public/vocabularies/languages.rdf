   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/ENM"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="enm">Middle English (1100-1500)</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2B">enm</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">enm</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">enm</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2T">enm</skos:notation>
      <skos:prefLabel xml:lang="en">Middle English (1100-1500)</skos:prefLabel>
      <dc:identifier>ENM</dc:identifier>
      <atold:op-code>ENM</atold:op-code>
      <at:op-code>ENM</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ENM</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2t</dc:source>
            <at:legacy-code>enm</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>enm</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2b</dc:source>
            <at:legacy-code>enm</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Middle English (abbreviated to ME) is the forms of the English language that were spoken in England after the Norman Conquest of 1066, until the late 15th century, roughly coinciding with the High and Late Middle Ages. The Middle English dialects displaced the Old English dialects under the influence of Anglo-Norman French and Old Norse, and were in turn replaced in England by Early Modern English. During the Middle English period, many Old English grammatical features either became simplified or disappeared altogether. Like English, Middle English is classified as a Western Germanic language within the Indo-European language family.</skos:definition>
   </skos:Concept>
