      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="wyb">Wangaaybuwan</skos:altLabel>
      <skos:altLabel xml:lang="wyb">Wayil</skos:altLabel>
      <skos:altLabel xml:lang="wyb">Ngiyambaa</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wyb</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wyb</skos:notation>
      <skos:prefLabel xml:lang="en">Wangaaybuwan-Ngiyambaa</skos:prefLabel>
      <dc:identifier>WYB</dc:identifier>
      <atold:op-code>WYB</atold:op-code>
      <at:op-code>WYB</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WYB</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wyb</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Wangaaybuwan-Ngiyambaa is an endangered Australian Aboriginal language traditionally spoken by the Wangaaypuwan and Wayilwan peoples of New South Wales. Wangaaybuwan-Ngiyambaa is closely related to Wiradjuri (wrh). Together, they form the Wiradhuric sub-group within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
