      <skos:altLabel xml:lang="ads">Adamorobe Sign Language</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ads</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ads</skos:notation>
      <skos:prefLabel xml:lang="pt">língua gestual de Adamorobe</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Adamorobo gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">adamorobe znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">język migowy Adamarobe</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">adamorobelainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali ta’ Adamorobe</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">adamorobei jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="is">adomoróbe-táknmál</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Adamorobe</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Adamorobes zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos de Adamorobe</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Adamorobe-Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Adamorobe</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νοηματική γλώσσα Ανταμορόμπε</skos:prefLabel>
      <skos:prefLabel xml:lang="et">adamorobe viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">adamorobský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="da">adamorobe tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">adamorobski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Gebarentaal van Adamorobe</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni di Adamorobe</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Adamorobe-teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes d’Adamorobe</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от Адаморобе</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">posunkový jazyk dediny Adamorobe</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Adamorobe Sign Language</skos:prefLabel>
      <dc:identifier>ADS</dc:identifier>
      <atold:op-code>ADS</atold:op-code>
      <at:op-code>ADS</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ADS</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ads</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Adamorobe Sign Language is a sign language used in Adamorobe village in Ghana. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
