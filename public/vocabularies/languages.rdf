      <skos:prefLabel xml:lang="ro">limbajul prin semne din Afganistan</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">afghanskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Afghaanse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">afganistanski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">afganistanski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos afgana</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">афгански жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">afganistaniečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual afegã</skos:prefLabel>
      <dc:identifier>AFG</dc:identifier>
      <atold:op-code>AFG</atold:op-code>
      <at:op-code>AFG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>AFG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>afg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Afghan Sign Language is a sign language used in Afghanistan. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
