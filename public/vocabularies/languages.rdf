      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="slq">Salchuq</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">slq</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">slq</skos:notation>
      <skos:prefLabel xml:lang="en">Salchuq</skos:prefLabel>
      <dc:identifier>SLQ</dc:identifier>
      <atold:op-code>SLQ</atold:op-code>
      <at:op-code>SLQ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SLQ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>slq</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Ethnologue seems to be the only source for Salchuq [slq]. Almost all online sources point to Wikipedia, and Wikipedia has only Ethnologue as a source (Eberhard et al 2022). All the way back to the 11th edition (1988), there has only been one piece of information in the Salchuq entry: "May be a dialect of South Azerbaijani."</skos:scopeNote>
      <at:end.use>2023-01-20</at:end.use>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/GGE"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Guragone</skos:altLabel>
      <skos:altLabel xml:lang="gge">Gurr-goni</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">gge</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">gge</skos:notation>
      <skos:prefLabel xml:lang="en">Gurr-goni</skos:prefLabel>
      <dc:identifier>GGE</dc:identifier>
      <atold:op-code>GGE</atold:op-code>
      <at:op-code>GGE</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>GGE</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>gge</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Gurr-goni, or Guragone, is an endangered Australian Aboriginal language spoken in Arnhem Land. In 2011 it had about 60 speakers, all of whom were also fluent in Burarra or Kuninjku. It is closely related to Burarra, and both belong to the Maningrida group of languages. This group is sometimes classified with the Gunwinyguan languages in a proposed Macro-Gunwinyguan family, which is distinct from the Pama–Nyungan language family.</skos:definition>
   </skos:Concept>
