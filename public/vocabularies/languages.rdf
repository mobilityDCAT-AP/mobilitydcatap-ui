      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="kox">Coxima</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">kox</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">kox</skos:notation>
      <skos:prefLabel xml:lang="en">Coxima</skos:prefLabel>
      <dc:identifier>KOX</dc:identifier>
      <atold:op-code>KOX</atold:op-code>
      <at:op-code>KOX</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KOX</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kox</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Alan Wares, in correspondence with Barbara Grimes (5/28/1971), stated that Coxima should be deleted as "non-existent." Moreover, the Ethnologue has not added any information to the Coxima language entry in nearly 40 years. Mention of this language is missing from all the major sources on South American languages.</skos:scopeNote>
      <at:end.use>2016-01-15</at:end.use>
   </skos:Concept>
