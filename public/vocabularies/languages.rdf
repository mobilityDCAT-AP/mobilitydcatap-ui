   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/XPD"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Paredareme</skos:altLabel>
      <skos:altLabel xml:lang="xpd">Paredarerme</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xpd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xpd</skos:notation>
      <skos:prefLabel xml:lang="en">Oyster Bay Tasmanian</skos:prefLabel>
      <dc:identifier>XPD</dc:identifier>
      <atold:op-code>XPD</atold:op-code>
      <at:op-code>XPD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XPD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xpd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Oyster Bay Tasmanian (also known as Paredarerme, Paytirami or Poredareme) is an Aboriginal language of Tasmania in the reconstruction of Claire Bowern. It was spoken along the central eastern coast of the island by the Oyster Bay tribe, and in the interior by the Big River tribe. Big River Tasmanian is attested in a list of 268 words collected by George Augustus Robinson. Coastal vocabularies include the Oyster Bay list of Robinson (357 words), and a second collected by Joseph Milligan of 1 040 words published in 1857 and 1859. The last is the longest vocabulary of any variety of Tasmanian.</skos:definition>
   </skos:Concept>
