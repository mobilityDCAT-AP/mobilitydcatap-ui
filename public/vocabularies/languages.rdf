   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/ANT"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Antikarinya</skos:altLabel>
      <skos:altLabel xml:lang="ant">Antakarinya</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ant</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ant</skos:notation>
      <skos:prefLabel xml:lang="en">Antakarinya</skos:prefLabel>
      <dc:identifier>ANT</dc:identifier>
      <atold:op-code>ANT</atold:op-code>
      <at:op-code>ANT</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ANT</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ant</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Antakarinya, or Antikarinya, is a Pama-Nyungan language spoken in the central desert region of Australia. It is one of the Wati languages. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
