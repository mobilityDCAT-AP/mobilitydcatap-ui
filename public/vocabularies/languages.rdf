   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/DYN"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Dhanggatti</skos:altLabel>
      <skos:altLabel xml:lang="dyn">Dhanggatti</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">dyn</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">dyn</skos:notation>
      <skos:prefLabel xml:lang="en">Dyangadi</skos:prefLabel>
      <dc:identifier>DYN</dc:identifier>
      <atold:op-code>DYN</atold:op-code>
      <at:op-code>DYN</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>DYN</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>dyn</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Dyangadi, also known as Dhanggatti, is a Pama-Nyungan language, once spoken by the Djangadi of the Macleay Valley and surrounding high country of the Great Dividing Range in New South Wales, Australia. There is an ongoing program of language-revival. Dyangadi is related to the extinct Nganyaywana language. Both have been called the Macleay Valley languages. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
