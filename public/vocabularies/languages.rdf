      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="asd">Asas</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">asd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">asd</skos:notation>
      <skos:prefLabel xml:lang="en">Asas</skos:prefLabel>
      <dc:identifier>ASD</dc:identifier>
      <atold:op-code>ASD</atold:op-code>
      <at:op-code>ASD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ASD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>asd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">In the past, the Kou (Sinsauru) [snz] language was mistakenly classified as two separate languages: Asas [asd] and Sinsauru [snz]. John Z'graggen, in his 1975 paper "The Languages of the Madang District," gave an alternate name of "Kow" for both of the languages he called Asas [asd] and Sinsauru [snz].</skos:scopeNote>
      <at:end.use>2019-01-25</at:end.use>
   </skos:Concept>
