   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/THH"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="thh">Rarámuri (THH)</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">thh</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">thh</skos:notation>
      <skos:prefLabel xml:lang="en">Northern Tarahumara</skos:prefLabel>
      <dc:identifier>THH</dc:identifier>
      <atold:op-code>THH</atold:op-code>
      <at:op-code>THH</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>THH</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>thh</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Northern Tarahumara is a Southern Uto-Aztecan language spoken in northern Mexico. Together with Lowland Tarahumara (tac), Central Tarahumara (tar), Southeastern Tarahumara (tcu) and Southwestern Tarahumara (twr), it forms the Tarahumaran group. The native name of Tarahumara language is Rarámuri or Ralámuli ra'ícha.</skos:definition>
   </skos:Concept>
