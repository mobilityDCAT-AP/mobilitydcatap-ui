      <skos:altLabel xml:lang="trv">Sediq</skos:altLabel>
      <skos:altLabel xml:lang="en">Seediq</skos:altLabel>
      <skos:altLabel xml:lang="en">Taroko</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">trv</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">trv</skos:notation>
