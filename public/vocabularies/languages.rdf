   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/TJP"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="tjp">Tjupany</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">tjp</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">tjp</skos:notation>
      <skos:prefLabel xml:lang="en">Tjupany</skos:prefLabel>
      <dc:identifier>TJP</dc:identifier>
      <atold:op-code>TJP</atold:op-code>
      <at:op-code>TJP</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TJP</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>tjp</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Tjupany belongs to the Pama-Nyungan language family. It is spoken in Australia’s Western Desert region. Together with the extinct Pini language, it is classified within the Wati sub-branch. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
