         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>plj</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">According to Decker and Aregbesola (2020), a forthcoming report available on request, the varieties identified as the Polci cluster is a combination of linguistically and socially different languages. Thus, Split into Pesse [pze], Nyamzak-Dir-Mbarimi [nzr], Zul [zlu], and Buli [uly].</skos:scopeNote>
      <at:end.use>2023-01-23</at:end.use>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/ALH"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="alh">Alawa</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">alh</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">alh</skos:notation>
      <skos:prefLabel xml:lang="en">Alawa</skos:prefLabel>
      <dc:identifier>ALH</dc:identifier>
      <atold:op-code>ALH</atold:op-code>
      <at:op-code>ALH</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ALH</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>alh</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Alawa is a moribund Australian Aboriginal language spoken by the Alawa people of the Northern Territory. By 2021, the number of people speaking it at home had dropped to 5. Alawa is a member of the Arnhem, or Macro-Gunwinyguan family, the second-largest Australian language family after Pama–Nyungan, but this language family is not universally accepted.</skos:definition>
   </skos:Concept>
