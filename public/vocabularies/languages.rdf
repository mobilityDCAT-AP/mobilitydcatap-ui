      <skos:prefLabel xml:lang="en">Assan</skos:prefLabel>
      <dc:identifier>XSS</dc:identifier>
      <atold:op-code>XSS</atold:op-code>
      <at:op-code>XSS</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XSS</at:authority-code>
      <at:op-mapped-code>
