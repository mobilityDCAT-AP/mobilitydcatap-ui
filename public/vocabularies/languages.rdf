      </at:op-mapped-code>
      <skos:definition xml:lang="en">Middle Persian written in the Manichaean script is a Western Middle Iranian language which became the literary language of the Sasanian Empire. It is the linguistic ancestor of Modern Persian, the official language of Iran (also known as Farsi), Afghanistan (Dari) and Tajikistan (Tajik).</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/FAS"/>
   </skos:Concept>
