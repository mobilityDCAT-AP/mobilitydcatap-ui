   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/TWR"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="twr">Rarámuri (TWR)</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">twr</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">twr</skos:notation>
      <skos:prefLabel xml:lang="en">Southwestern Tarahumara</skos:prefLabel>
      <dc:identifier>TWR</dc:identifier>
      <atold:op-code>TWR</atold:op-code>
      <at:op-code>TWR</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TWR</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>twr</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Southwestern Tarahumara is a Southern Uto-Aztecan language spoken in northern Mexico. Together with Lowland Tarahumara (tac), Central Tarahumara (tar), Southeastern Tarahumara (tcu) and Northern Tarahumara (thh), it forms the Tarahumaran group. The native name of Tarahumara language is Rarámuri or Ralámuli ra'ícha.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/WRH"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="wrh">Wiradjuri</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wrh</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wrh</skos:notation>
      <skos:prefLabel xml:lang="en">Wiradjuri</skos:prefLabel>
      <dc:identifier>WRH</dc:identifier>
      <atold:op-code>WRH</atold:op-code>
      <at:op-code>WRH</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WRH</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wrh</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Wiradjuri is an endangered Australian Aboriginal language traditionally spoken by the Wiradjuri people of New South Wales. A revival is under way, with the language being taught in schools, TAFE college, and at Charles Sturt University. Wiradjuri is closely related to Wangaaybuwan-Ngiyambaa (wyb). Together, they form the Wiradhuric sub-group within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
