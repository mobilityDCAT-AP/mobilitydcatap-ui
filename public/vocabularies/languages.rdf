      <skos:prefLabel xml:lang="es">lengua de signos egipcia</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">egiptovski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Egyptian Sign Language</skos:prefLabel>
