            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>csd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Chiangmai Sign Language is a sign language used in Chiang Mai city in Thailand. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
