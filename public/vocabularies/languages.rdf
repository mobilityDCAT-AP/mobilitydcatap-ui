      <skos:prefLabel xml:lang="it">lingua dei segni del Guatemala</skos:prefLabel>
      <skos:prefLabel xml:lang="et">guatemala viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">guatemalalainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от Гватемала</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Ghuatamala</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">guatemalský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos guatemalteca</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">gvetamalski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Guatemala</skos:prefLabel>
      <skos:prefLabel xml:lang="el">γουατεμαλεζική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">гватемальский жестовый язык</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Guatemalteekse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">guatemalský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Guatemala-Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">guatemalanskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">gvatemaliečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="da">guatemalansk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">gvatemalski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">gwatemalski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali tal-Gwatemala</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual guatemalteca</skos:prefLabel>
