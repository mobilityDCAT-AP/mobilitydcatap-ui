      <skos:altLabel xml:lang="en">Andaman Hindi</skos:altLabel>
      <skos:altLabel xml:lang="hca">Andaman Hindi</skos:altLabel>
      <skos:altLabel xml:lang="hca">अण्डमान क्रियोल हिन्दी</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">hca</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">hca</skos:notation>
      <skos:prefLabel xml:lang="el">κρεολική της χιντι των νησιών Άνταμαν</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">hindi créole des îles Andaman</skos:prefLabel>
      <skos:prefLabel xml:lang="et">andamani kreooli hindi</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">andamanų kreolų hindi</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">hindi creolă andamaneză</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">hindi andamańskie</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Andamanees creools Hindi</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Criól Hiondúise Andaman</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">hindiin perustuva andamaanienkreoli</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">andamanská kreolská hindčina</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">andamán-szigeteki kreol hindi</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">crioulo hindi das ilhas Andamão</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">andamanski kreolski hindi</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">андаманский креольский хинди</skos:prefLabel>
      <skos:prefLabel xml:lang="uk">андаманский креольский хинди</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Andamanen-Kreol-Hindi</skos:prefLabel>
      <skos:prefLabel xml:lang="es">hindi criollo andamanés</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">andamanská kreolská hindština</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Ħindi Kreol tal-Gżejjer Andaman</skos:prefLabel>
      <skos:prefLabel xml:lang="da">andamansk hindikreolsk</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">andamanu kreoliskā hindi valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">andamanesisk kreol-hindi</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Andaman Creole Hindi</skos:prefLabel>
      <skos:prefLabel xml:lang="it">hindi creolo delle Andamane</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">andamanska kreolska hindijščina</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">андамански креолски хинди</skos:prefLabel>
      <dc:identifier>HCA</dc:identifier>
      <atold:op-code>HCA</atold:op-code>
      <at:op-code>HCA</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>HCA</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>hca</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Andaman Creole Hindi is a trade language of the Andaman Islands, spoken as a native language especially in Port Blair and villages to the south. It is described as a creolization of Hindustani, Bengali, and Malayalam.</skos:definition>
   </skos:Concept>
