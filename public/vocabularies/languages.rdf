      <skos:altLabel xml:lang="jus">Jumla Sign Language</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">jus</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">jus</skos:notation>
      <skos:prefLabel xml:lang="de">Jumla-Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos de Jumla</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">jumlanski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Jumla-teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">jumlai jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Jumla Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Jumla viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език на Джумла</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">jumelský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Džumlos gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni di Jumla</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne Jumla</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">jumlas zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Jumla-tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νοηματική γλώσσα της Jumla</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali ta’ Jumla</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">jumla znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Jumla-gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes de Jumla</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">jumlalainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual de Júmela</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Jumla</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">jumelský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">język migowy Jumla</skos:prefLabel>
      <dc:identifier>JUS</dc:identifier>
      <atold:op-code>JUS</atold:op-code>
      <at:op-code>JUS</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>JUS</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>jus</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Jumla Sign Language is a sign language used in Jumla village in Nepal. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
