      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">gse</skos:notation>
      <skos:prefLabel xml:lang="it">lingua dei segni del Ghana</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes ghanéenne</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali tal-Ghana</skos:prefLabel>
      <skos:prefLabel xml:lang="el">γκανεζική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">ghananskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos de Ghana</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от Гана</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">ganski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">ganski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="et">ghana viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual ganesa</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">ghanský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">ghanský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="da">ghanesisk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">ganiečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Ghanaian Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">ghański język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Ghana</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Ghána</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">ghánai jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Ghanese Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Ghanaische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">ghanalainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Ganas zīmju valoda</skos:prefLabel>
