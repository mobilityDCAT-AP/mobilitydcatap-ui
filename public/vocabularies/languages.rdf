      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Bengkala</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual de Báli</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">bengkalski znakovni jezik</skos:prefLabel>
