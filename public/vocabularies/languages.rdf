      <skos:prefLabel xml:lang="mk">иро́нский</skos:prefLabel>
      <skos:prefLabel xml:lang="sr">иро́нский</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">иро́нский</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">iron osetščina</skos:prefLabel>
