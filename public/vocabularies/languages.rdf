      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="tlw">South Wemale</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">tlw</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">tlw</skos:notation>
      <skos:prefLabel xml:lang="en">South Wemale</skos:prefLabel>
      <dc:identifier>TLW</dc:identifier>
      <atold:op-code>TLW</atold:op-code>
      <at:op-code>TLW</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TLW</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>tlw</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Taguchi, who originally stated that they are differen langauges, recently sent me an e-mail stating the following "My survey report in 1996-7 concluded that the North and South Wemale should be identified as two different languages. However, after many years of interactions of Wemale community people I learned and can now conclude that they can communicate with each other
without difficulty. Thus, South Wemale [tlw] merged into North Wemale [weo].</skos:scopeNote>
      <at:end.use>2012-02-03</at:end.use>
   </skos:Concept>
