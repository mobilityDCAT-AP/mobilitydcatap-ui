      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">eth</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">eth</skos:notation>
      <skos:prefLabel xml:lang="lv">etiopiešu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">etiopų gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes éthiopienne</skos:prefLabel>
      <skos:prefLabel xml:lang="da">etiopisk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Ethiopische Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">etiopski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">etiopski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">etióp jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">etiopský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos de etíope</skos:prefLabel>
      <skos:prefLabel xml:lang="el">αιθιοπική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Etjopjana</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">etiópsky posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni etiope</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta na hAetóipe</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">etiopialainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual etíope</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Äthiopische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Ethiopian Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">etiopski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">етиопски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">etiopiskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Etiopia</skos:prefLabel>
      <skos:prefLabel xml:lang="et">etioopia viipekeel</skos:prefLabel>
      <dc:identifier>ETH</dc:identifier>
      <atold:op-code>ETH</atold:op-code>
      <at:op-code>ETH</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ETH</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>eth</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Ethiopian Sign Language is a sign language used in Ethiopia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
