      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="ppa">Pao</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ppa</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ppa</skos:notation>
      <skos:prefLabel xml:lang="en">Pao</skos:prefLabel>
      <dc:identifier>PPA</dc:identifier>
      <atold:op-code>PPA</atold:op-code>
      <at:op-code>PPA</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>PPA</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ppa</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">As Harald Hammarstrom (2015) states, it Request for Change to ISO 639-3 Language Code, page 3 is highly possible that Pao, as a name of a Scheduled Tribe in the Bagheli-speaking area of Madhya Pradesh, was confused with the Tibeto-Burman language of the same name [blk], spoken in Myanmar.</skos:scopeNote>
