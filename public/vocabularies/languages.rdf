      <skos:prefLabel xml:lang="en">Swedish Sign Language</skos:prefLabel>
      <dc:identifier>SWL</dc:identifier>
      <atold:op-code>SWL</atold:op-code>
      <at:op-code>SWL</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SWL</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>swl</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Swedish Sign Language is a sign language used in Sweden. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
