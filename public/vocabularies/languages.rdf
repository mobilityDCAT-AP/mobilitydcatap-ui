      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="zmm">Marimanindji</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">zmm</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">zmm</skos:notation>
      <skos:prefLabel xml:lang="en">Marramaninyshi</skos:prefLabel>
      <dc:identifier>ZMM</dc:identifier>
      <atold:op-code>ZMM</atold:op-code>
      <at:op-code>ZMM</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ZMM</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>zmm</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Marramaninyshi is an endangered Australian Aboriginal language spoken by Marramaninyshi in the central Daly River area of the Northern Territory. It is closely related to the Marithielic languages and a part of the small Western Daly group, unrelated to the larger Australian Aboriginal language families.</skos:definition>
   </skos:Concept>
