      <skos:prefLabel xml:lang="pl">jugosławiański język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">jugoslávský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne iugoslav</skos:prefLabel>
      <dc:identifier>YSL</dc:identifier>
      <atold:op-code>YSL</atold:op-code>
      <at:op-code>YSL</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>YSL</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ysl</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Yugoslavian Sign Language is a sign language used in countries of the former Yougoslavia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
