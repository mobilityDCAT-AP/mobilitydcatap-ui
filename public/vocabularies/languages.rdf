      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta na Nigéire</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Niġerjana</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">nigēriešu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">nigeryjski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νιγηριανή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">nigériai jelnyelv</skos:prefLabel>
      <dc:identifier>NSI</dc:identifier>
      <atold:op-code>NSI</atold:op-code>
      <at:op-code>NSI</at:op-code>
