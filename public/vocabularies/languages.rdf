   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/WNY"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="wny">Wanyi</skos:altLabel>
      <skos:altLabel xml:lang="en">Waanyi</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wny</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wny</skos:notation>
      <skos:prefLabel xml:lang="en">Wanyi</skos:prefLabel>
      <dc:identifier>WNY</dc:identifier>
      <atold:op-code>WNY</atold:op-code>
      <at:op-code>WNY</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WNY</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wny</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Wanyi, also spelt Waanyi, is an endangered Australian Aboriginal language spoken by the Wanyi people of the lower gulf area of Northern Queensland. Although earlier thought to be extinct, as of the 2016 Australian census, there were 16 speakers of the language. Together with the closely related Garrwa language, Wanyi and Garrwa are not currently classified within any larger Aboriginal language family; instead they form their own Garrwan language family.</skos:definition>
   </skos:Concept>
