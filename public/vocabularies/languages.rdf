   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/XIP"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="xip">Xipináwa</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xip</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xip</skos:notation>
      <skos:prefLabel xml:lang="en">Xipináwa</skos:prefLabel>
      <dc:identifier>XIP</dc:identifier>
      <atold:op-code>XIP</atold:op-code>
      <at:op-code>XIP</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XIP</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xip</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">The Ethnologue has no information on Xipináwa [xip], except for a referenct to "SIL 1976." Loukotka (1968:172) indicates that this language is unattested. Citing this same source, Hammarstrom (2015) states that Xipináwa cannot be asserted to have been a separate language.</skos:scopeNote>
      <at:end.use>2016-01-15</at:end.use>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/IIN"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="iin">Thiin</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">iin</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">iin</skos:notation>
      <skos:prefLabel xml:lang="en">Thiin</skos:prefLabel>
      <dc:identifier>IIN</dc:identifier>
      <atold:op-code>IIN</atold:op-code>
      <at:op-code>IIN</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>IIN</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>iin</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Thiin is a nearly extinct Mantharta language of the Pilbara region in Western Australia. It is closely related to Djiwarli (dze). Together with other Mantharta languages it belongs to the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/LDD"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="ldd">Luri</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ldd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ldd</skos:notation>
      <skos:prefLabel xml:lang="en">Luri</skos:prefLabel>
      <dc:identifier>LDD</dc:identifier>
      <atold:op-code>LDD</atold:op-code>
      <at:op-code>LDD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>LDD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ldd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Luri is an extinct Afro-Asiatic language of Bauchi State in Nigeria. It is part of the Barawa cluster, which is in turn part of the West Chadic branch. Its closest living related languages are Pesse, Zul, Buli and Dir-Nyamzak-Mbarimi. Together, they form the Polci-Luri group.</skos:definition>
   </skos:Concept>
