      <skos:altLabel xml:lang="cca">Cauca</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">cca</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">cca</skos:notation>
      <skos:prefLabel xml:lang="en">Cauca</skos:prefLabel>
      <dc:identifier>CCA</dc:identifier>
      <atold:op-code>CCA</atold:op-code>
      <at:op-code>CCA</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>CCA</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>cca</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Glottolog lists Cauca as "unattested". It is presumed to be from the Cauca Valley, but no such language is known, unless it's the undemonstrated Quimbaya, which is attested in about 10 words. But there are doubts as to whether 8 of these two words are really attributable to the language of the Quimbaya ethnic group.</skos:scopeNote>
      <at:end.use>2020-01-23</at:end.use>
   </skos:Concept>
