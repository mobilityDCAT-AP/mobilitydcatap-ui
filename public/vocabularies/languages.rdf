      <dc:identifier>MWK</dc:identifier>
      <atold:op-code>MWK</atold:op-code>
      <at:op-code>MWK</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MWK</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mwk</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kita Maninkakan, or Central Malinke, is a Manding language spoken by about a million people in Mali, where it is a national language. About 10% are ethnically Fula. Manding languages are a sub-branch of Mande languages that are part of the hypothetical Niger-Congo language family. However, as the Mande languages lack the noun-class morphology, linguists increasingly treat Mande and Atlantic–Congo as independent language families and reject the Niger-Congo hypothesis.</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/MAN"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/EMK"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0002"/>
