      <skos:altLabel xml:lang="dgr">Tłı̨chǫ</skos:altLabel>
      <skos:altLabel xml:lang="en">Dogrib</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">dgr</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2B">dgr</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">dgr</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2T">dgr</skos:notation>
      <skos:prefLabel xml:lang="en">Tlicho</skos:prefLabel>
      <dc:identifier>DGR</dc:identifier>
      <atold:op-code>DGR</atold:op-code>
      <at:op-code>DGR</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>DGR</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2b</dc:source>
            <at:legacy-code>dgr</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>dgr</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2t</dc:source>
            <at:legacy-code>dgr</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Tlicho, also known as Tłı̨chǫ Yatıì or the Dogrib language, is a Northern Athabaskan language spoken by the Tłı̨chǫ (Dogrib people) First Nations of the Canadian Northwest Territories. It is part of the Na-Dené language family and the disputed Dené–Yeniseian hypothesis.</skos:definition>
   </skos:Concept>
