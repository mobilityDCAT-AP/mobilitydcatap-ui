      <skos:prefLabel xml:lang="pl">nambya</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Nambya</skos:prefLabel>
      <skos:prefLabel xml:lang="it">nambya</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">nambya</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">nambya</skos:prefLabel>
      <skos:prefLabel xml:lang="es">nambya</skos:prefLabel>
