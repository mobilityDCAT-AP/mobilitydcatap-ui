      </at:op-mapped-code>
      <skos:definition xml:lang="en">Southern Ping Chinese is a member of a pair of Sinitic languages spoken mainly in southern Guangxi, around the city of Nanning. Pinghua is a trade language spoken as a second language by speakers of Zhuang languages. Some speakers are officially classified as Zhuang, and many are genetically distinct from most other Han Chinese.</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/ZHO"/>
   </skos:Concept>
