   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/YII"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="yii">Yidiny</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">yii</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">yii</skos:notation>
      <skos:prefLabel xml:lang="en">Yidiny</skos:prefLabel>
      <dc:identifier>YII</dc:identifier>
      <atold:op-code>YII</atold:op-code>
      <at:op-code>YII</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>YII</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>yii</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Yidiny is an endangered Australian Aboriginal language spoken in the northeast of Queensland by the Yidinji people. It is closely related to Djabugay, and both are sometimes placed in a separate Yidinyic branch of the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/GNQ"
