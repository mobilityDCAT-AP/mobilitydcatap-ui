   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/BYM"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="bym">Bidyara</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">bym</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">bym</skos:notation>
      <skos:prefLabel xml:lang="en">Bidyara</skos:prefLabel>
      <dc:identifier>BYM</dc:identifier>
      <atold:op-code>BYM</atold:op-code>
      <at:op-code>BYM</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>BYM</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>bym</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Bidjara is an endangered Pama-Nyungan language within the Maric sub-branch. In 1980, it was spoken by 20 elders in Queensland, Australia, between the towns of Tambo and Augathella, or the Warrego and Langlo Rivers. There are many dialects of the language, including Gayiri and Gunggari. Some of them are being revitalised and are being taught in local schools in the region. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
