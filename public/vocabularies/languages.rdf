   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/WWR"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="wwr">Warrwa</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wwr</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wwr</skos:notation>
      <skos:prefLabel xml:lang="en">Warrwa</skos:prefLabel>
      <dc:identifier>WWR</dc:identifier>
      <atold:op-code>WWR</atold:op-code>
      <at:op-code>WWR</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WWR</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wwr</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Warrwa is an extinct Australian Aboriginal language formerly spoken in the Derby Region of Western Australia, near Broome. It is closely related to the Nyikina language (nyh). Both belong to the small Nyulnyulan language family. Most languages in this family are extinct, with only three extant languages, all of which are almost extinct.</skos:definition>
   </skos:Concept>
