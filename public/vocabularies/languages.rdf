   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/KDZ"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="kdz">Kwaja</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">kdz</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">kdz</skos:notation>
      <skos:prefLabel xml:lang="en">Kwaja</skos:prefLabel>
      <dc:identifier>KDZ</dc:identifier>
      <atold:op-code>KDZ</atold:op-code>
      <at:op-code>KDZ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KDZ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kdz</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kwaja is a Southern Bantoid language spoken in the Nkambé District of the Donga-Mantung Department in Cameroon’s northwestern region. Alongside Ndaktup (ncp), it is a Grassfields language within the Volta-Congo primary branch. Like other Bantu languages, Kwaja has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
