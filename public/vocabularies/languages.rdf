      <skos:prefLabel xml:lang="cs">mosambický znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Mozambikanische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Mozambikaanse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от Мозамбик</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">mosambikilainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">moçambikiskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">mozambički znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni del Mozambico</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">mozambiki jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">mozambiški znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">mozambikiečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos de Mozambique</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali tal-Mozambique</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Mhósaimbíc</skos:prefLabel>
      <skos:prefLabel xml:lang="el">μοζαμβικανή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">мозамбикский жестовый язык</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes mozambicaine</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">mozambijski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Mozambican Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual moçambicana</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">mozambický posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="et">mosambiigi viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Mozambikas zīmju valoda</skos:prefLabel>
      <dc:identifier>MZY</dc:identifier>
      <atold:op-code>MZY</atold:op-code>
      <at:op-code>MZY</at:op-code>
