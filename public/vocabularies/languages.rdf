      <skos:prefLabel xml:lang="mt">Malaj Standard</skos:prefLabel>
      <skos:prefLabel xml:lang="el">τυποποιημένα μαλαισιανά</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">malaeză standard</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">standardimalaiji</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Standard Malay </skos:prefLabel>
      <skos:prefLabel xml:lang="de">Malaysisch</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Malaeis Chaighdeánach</skos:prefLabel>
