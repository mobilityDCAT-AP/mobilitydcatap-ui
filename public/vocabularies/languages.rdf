   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/WIG"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="wig">Wik-Ngathana</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wig</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wig</skos:notation>
      <skos:prefLabel xml:lang="en">Wik Ngathan</skos:prefLabel>
      <dc:identifier>WIG</dc:identifier>
      <atold:op-code>WIG</atold:op-code>
      <at:op-code>WIG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WIG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wig</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Wik Ngathan is an endangered Australian language spoken by Wik Ngathan people on the Cape York Peninsula of Queensland. It is closely related to Wikalkan (wik). Both belong to the Wik sub-group, and, on a broader level, to the Paman branch of the Pama-Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/KCZ"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="kcz">Konongo</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">kcz</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">kcz</skos:notation>
      <skos:prefLabel xml:lang="en">Konongo</skos:prefLabel>
      <dc:identifier>KCZ</dc:identifier>
      <atold:op-code>KCZ</atold:op-code>
      <at:op-code>KCZ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KCZ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kcz</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Konongo is a narrow Bantu language spoken in central Tanzania. Together with other Sukuma-Nyamwezi languages it is classified within the Volta-Congo primary branch. Like other Bantu languages, Konongo has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
