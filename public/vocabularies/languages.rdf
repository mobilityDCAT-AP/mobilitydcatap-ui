      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">sum</skos:notation>
      <skos:prefLabel xml:lang="en">Sumo-Mayangna</skos:prefLabel>
      <dc:identifier>SUM</dc:identifier>
      <atold:op-code>SUM</atold:op-code>
      <at:op-code>SUM</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SUM</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>sum</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Ulwa is the southernmost surviving member of the Sumu language subfamily. It is not mutually intelligible with its northern Sumu neighbor, the Mayangna language. Thus, Sumo-Mayangna [sum] split into Mayangna [yan] and Ulwa [ulw].</skos:scopeNote>
      <at:end.use>2010-01-18</at:end.use>
   </skos:Concept>
