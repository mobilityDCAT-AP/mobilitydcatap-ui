   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/ASW"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0002"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0002"/>
      <skos:altLabel xml:lang="asw">Australian Aborigines Sign Language</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">asw</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">asw</skos:notation>
      <skos:prefLabel xml:lang="fi">Australian aboriginaalien viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език на австралийските аборигени</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">znakovni jezik avstralskih staroselcev (Aboridžini)</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni aborigena australiana</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos de los aborígenes australianos</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Australijos aborigenų gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Aborigines-Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">znakový jazyk Austrálců</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Austraalia aborigeenide viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual aborígene da Austrália</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Australische aborigine-gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes des aborigènes d’Australie</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">austrálsky pôvodný posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Austrālijas aborigēnu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="da">det australske oprindelige folks tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali tal-Aboriġini Awstraljani</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Bhundúchasaigh na hAstráile</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">ausztrál aboriginal jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νοηματική γλώσσα των αυτοχθόνων της Αυστραλίας</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Australian Aborigines Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne al aborigenilor australieni</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">australiskt aboriginskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">жестовые языки австралийских аборигенов</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">znakovni jezik australskih aboridžina</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">australijski aborygeński język migowy</skos:prefLabel>
      <dc:identifier>ASW</dc:identifier>
      <atold:op-code>ASW</atold:op-code>
      <at:op-code>ASW</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ASW</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>asw</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Australian Aborigines Sign Language is a sign language used in Australia by aborigines communities. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
