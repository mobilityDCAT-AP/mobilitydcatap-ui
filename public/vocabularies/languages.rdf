      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xms</skos:notation>
      <skos:prefLabel xml:lang="en">Moroccan Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni marocchina</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">марокканский жестовый язык</skos:prefLabel>
