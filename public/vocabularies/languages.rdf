   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/HAN"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="han">Hangaza</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">han</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">han</skos:notation>
      <skos:prefLabel xml:lang="en">Hangaza</skos:prefLabel>
      <dc:identifier>HAN</dc:identifier>
      <atold:op-code>HAN</atold:op-code>
      <at:op-code>HAN</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>HAN</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>han</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Hangaza is an East Bantu language spoken in north-western Tanzania. It is closely related to Shubi (suj). Both languages are classified within the Volta-Congo primary branch of the Atlantic-Congo language family. Like other Bantu languages, Shubi has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
