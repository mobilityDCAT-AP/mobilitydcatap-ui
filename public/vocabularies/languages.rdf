   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/GIA"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="gia">Kija</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">gia</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">gia</skos:notation>
      <skos:prefLabel xml:lang="en">Kija</skos:prefLabel>
      <dc:identifier>GIA</dc:identifier>
      <atold:op-code>GIA</atold:op-code>
      <at:op-code>GIA</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>GIA</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>gia</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kija is an endangered Australian Aboriginal language spoken by about 200 people, most of whom live in the region from Halls Creek to Kununurra and west to Lansdowne and Tableland Stations in Western Australia. It is a member of the small Jarrakan language family, a non-Pama-Nyungan family in the East Kimberley.</skos:definition>
   </skos:Concept>
