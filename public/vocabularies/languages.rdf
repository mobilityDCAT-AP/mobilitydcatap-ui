   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/LBY"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Lamu-Lamu</skos:altLabel>
      <skos:altLabel xml:lang="lby">Lamalama</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">lby</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">lby</skos:notation>
      <skos:prefLabel xml:lang="en">Lamalama</skos:prefLabel>
      <dc:identifier>LBY</dc:identifier>
      <atold:op-code>LBY</atold:op-code>
      <at:op-code>LBY</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>LBY</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>lby</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Lamalama, or Lamu-Lamu, is a Pama-Nyungan language spoken in Queensland, Australia. It belongs to the Paman branch and more specifically to the Lamalamic group of languages. It is closely related to Morrobalama (umg). The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
