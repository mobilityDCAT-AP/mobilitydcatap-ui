            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xss</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Assan is considered to have been a dialect of Kott (Werner 1998). Glottolog lists Assan and Kott as belonging to the same language.</skos:scopeNote>
      <at:end.use>2023-01-20</at:end.use>
