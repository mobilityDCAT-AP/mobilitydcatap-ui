      <skos:prefLabel xml:lang="fr">langue des signes salvadorienne</skos:prefLabel>
      <skos:prefLabel xml:lang="el">σαλβαδοριανή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">salvadorilainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">salvadori jelnyelv</skos:prefLabel>
