      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0002"/>
      <skos:altLabel xml:lang="mzg">Monastic Sign Language</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mzg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mzg</skos:notation>
      <skos:prefLabel xml:lang="sk">posunkový jazyk Monastic</skos:prefLabel>
      <skos:prefLabel xml:lang="el">μοναστηριακή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos monacal</skos:prefLabel>
      <skos:prefLabel xml:lang="uk">монастирські жестові мови</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">samostanski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">samostanski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Monastika</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">монашески жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">mnišský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Monastic Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">szerzetesi jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni monastica</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Monastieke Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne monastic</skos:prefLabel>
      <skos:prefLabel xml:lang="da">klostertegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="et">munkade viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">vienuolių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">munkkien viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">mūku zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes monastique</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Mönchische Gebärdensprachen</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">monastyczny język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">klosterteckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Mhainistreach</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">linguagens gestuadas monásticas</skos:prefLabel>
      <dc:identifier>MZG</dc:identifier>
      <atold:op-code>MZG</atold:op-code>
      <at:op-code>MZG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MZG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mzg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Monastic Sign Language is a sign language used by Christian monks, mainly in Europe. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
