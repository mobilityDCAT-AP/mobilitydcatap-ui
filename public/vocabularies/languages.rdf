      <skos:prefLabel xml:lang="hr">dominikanski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Dominican Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="el">δομινικανή νοηματική γλώσσα</skos:prefLabel>
