   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/PZN"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Para Naga</skos:altLabel>
      <skos:altLabel xml:lang="pzn">Jejara</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">pzn</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">pzn</skos:notation>
      <skos:prefLabel xml:lang="en">Jejara Naga</skos:prefLabel>
      <dc:identifier>PZN</dc:identifier>
      <atold:op-code>PZN</atold:op-code>
      <at:op-code>PZN</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>PZN</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>pzn</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Jejara Naga is a Tibeto-Burman language classified under the Kuki-Chin–Naga sub-branch of the Sino-Tibetan language family. The Jejara Naga, also known as the Para Naga, are one of the major Naga peoples of Myanmar and primarily inhabit the area around Lay Shi Township.</skos:definition>
   </skos:Concept>
