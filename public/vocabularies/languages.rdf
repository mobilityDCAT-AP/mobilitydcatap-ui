      <skos:prefLabel xml:lang="it">tonga (Zambia)</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">tonga (Zambia)</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">tonga (Zambia)</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">čitonga (Zambija)</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Tonga (Zambia)</skos:prefLabel>
