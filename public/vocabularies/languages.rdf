      <skos:altLabel xml:lang="rsi">langue des signes de Rennellese</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">rsi</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">rsi</skos:notation>
      <skos:prefLabel xml:lang="sl">rennellese znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Rennellese-gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">rennell-bellona jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos de Rennell</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Renela salas zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">rennellský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">реннеллский жестовый язык</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Rennellese-Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Rennellese-teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Rennellese Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Insula Rennell</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">rennellinsaarelainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Rennelli saare viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual de Rennell</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Renelio gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">rennellský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">ренелски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Rennelliża</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Rennellese-tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">rennellski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni rennellese</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Oileán Rennell</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes de Rennellese</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νοηματική γλώσσα του Rennell</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">język migowy Rennellese</skos:prefLabel>
      <dc:identifier>RSI</dc:identifier>
      <atold:op-code>RSI</atold:op-code>
      <at:op-code>RSI</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>RSI</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>rsi</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">The "language", as described by Kuschel 1974, would clearly be considered a home sign system today, since it was only ever used by one deaf person and his hearing associates. This is not to criticize the Deaf person's intelligence and inventiveness, but simple to say that his communication system does not fit the criteria for inclusion in ISO 639-3. There never was a community of users in the usual sense, something that Kuschel goes to great lengths to demonstrate.</skos:scopeNote>
      <at:end.use>2017-01-31</at:end.use>
      <skos:definition xml:lang="en">Rennellese Sign Language is an extinct sign language used Rennell Island, in Solomon Islands. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
