      <skos:prefLabel xml:lang="da">guineansk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="el">γουιανική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">gvinejski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">gvinejski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Guineische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">guinejský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от Гвинея</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">guineanskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Guinese Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos guineana</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Gvinejas zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">guineai jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">gvinėjiečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">gwinejski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual da Guiné-Conacri</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta na Guine</skos:prefLabel>
      <skos:prefLabel xml:lang="et">guinea viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">guinejský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">guinealainen viittomakieli</skos:prefLabel>
