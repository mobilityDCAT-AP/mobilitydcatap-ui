      <skos:prefLabel xml:lang="et">laose viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Laos</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">laoški znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">laosiešu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от Лаос</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">laoský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Laotiaanse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="da">laotisk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">laosilainen viittomakieli</skos:prefLabel>
