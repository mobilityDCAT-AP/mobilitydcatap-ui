      <skos:prefLabel xml:lang="bg">жестомимичен език от Кения</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">kenijski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes kényane</skos:prefLabel>
