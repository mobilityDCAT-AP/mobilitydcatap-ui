      <skos:prefLabel xml:lang="da">israelsk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">izraelski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Iosrael</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">israeliskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">izraelský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">izraeliečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual israelita</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni israeliana</skos:prefLabel>
      <skos:prefLabel xml:lang="el">ισραηλινή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Israelische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">izraeli jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">izraelski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">izraelski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos israelí</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">izraelský posunkový jazyk</skos:prefLabel>
