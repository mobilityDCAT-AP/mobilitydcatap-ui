      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nbf</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Based on first-hand experience by SIL researchers, Naxi (Naxi Proper) [nxq] and Narua (Mosuo) [nru] are almost completely unintelligible with previously unexposed speakers only being able to understand isolated words of the other's speech.</skos:scopeNote>
      <at:end.use>2011-05-18</at:end.use>
   </skos:Concept>
