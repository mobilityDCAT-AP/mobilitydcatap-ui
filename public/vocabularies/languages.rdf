      <skos:prefLabel xml:lang="hr">salvadorski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Salvadoran Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Salvadorjana</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual salvadorenha</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni del Salvador</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">salvadorský znakový jazyk</skos:prefLabel>
