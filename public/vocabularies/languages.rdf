   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/DZG"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="dzg">Daza</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">dzg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">dzg</skos:notation>
      <skos:prefLabel xml:lang="en">Dazaga</skos:prefLabel>
      <dc:identifier>DZG</dc:identifier>
      <atold:op-code>DZG</atold:op-code>
      <at:op-code>DZG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>DZG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>dzg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Dazaga (also known as Daza) belongs to the Saharan primary branch of the putative Nilo-Saharan language family. It is spoken by the Daza people in northern Chad and eastern Niger. Within the Saharan branch – which also includes the Kanuri, Kanembu, and Tebu languages – Dazaga is classified as part of the Western Saharan subgroup. The constituent families of Nilo-Saharan are quite diverse. One characteristic feature is a tripartite singulative-collective-plurative number system.</skos:definition>
   </skos:Concept>
