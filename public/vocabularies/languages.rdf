      <skos:prefLabel xml:lang="bg">жестомимичен език от Никарагуа</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes nicaraguayenne</skos:prefLabel>
      <skos:prefLabel xml:lang="tr">nikaragua işaret dili</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Nicaragua</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos nicaragüense</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">nicaraguanskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">nicaragualainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">nikaragvanski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">nikaragviečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">никарагуанский жестовый язык</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">nikaragujský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Nikaragvas zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="no">nicaraguansk tegnspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">nikaragujský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="da">nicaraguansk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni del Nicaragua</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νικαραγουανή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">nicaraguai jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual nicaraguense</skos:prefLabel>
      <skos:prefLabel xml:lang="sr">никарагвански знаковни језик</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali tan-Nikaragwa</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Nicearagua</skos:prefLabel>
      <skos:prefLabel xml:lang="et">nicaragua viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">nikaragovski znakovni jezik</skos:prefLabel>
      <dc:identifier>NCS</dc:identifier>
