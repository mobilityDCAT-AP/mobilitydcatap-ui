      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">tbb</skos:notation>
      <skos:prefLabel xml:lang="en">Tapeba</skos:prefLabel>
      <dc:identifier>TBB</dc:identifier>
      <atold:op-code>TBB</atold:op-code>
      <at:op-code>TBB</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TBB</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>tbb</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Ethnologue (1996) declared that the Tapeba ethnic group, numbering 984, was monolingual in Portuguese [por]. Hammarstrom (2015) says that Tapeba is unattested and cannot be asserted to have been a separate language. Other major publications on South American languages do not mention the name Tapeba.</skos:scopeNote>
      <at:end.use>2020-01-23</at:end.use>
   </skos:Concept>
