   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/LVL"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Lori</skos:altLabel>
      <skos:altLabel xml:lang="lvl">Lwel</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">lvl</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">lvl</skos:notation>
      <skos:prefLabel xml:lang="en">Lwel</skos:prefLabel>
      <dc:identifier>LVL</dc:identifier>
      <atold:op-code>LVL</atold:op-code>
      <at:op-code>LVL</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>LVL</at:authority-code>
      <skos:definition xml:lang="en">Lwel is a Bantu language spoken in the Democratic Republic of the Congo. Together with Ngwii, Nzadi, and Ding, it belongs to the West-Coastal Bantu group, which is classified within the Volta-Congo primary branch. Like other Bantu languages, Lwel has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
