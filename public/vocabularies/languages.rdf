   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/WOA"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Tyaraity</skos:altLabel>
      <skos:altLabel xml:lang="woa">Kuwema</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">woa</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">woa</skos:notation>
      <skos:prefLabel xml:lang="en">Kuwema</skos:prefLabel>
      <dc:identifier>WOA</dc:identifier>
      <atold:op-code>WOA</atold:op-code>
      <at:op-code>WOA</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WOA</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>woa</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kuwema, also known as Tyaraity, is a dormant Australian Aboriginal language traditionally spoken along the Daly River in the Northern Territory. Kuwema is related to Malak Malak. They were formerly classified as independent members of the Northern Daly languages, but are now considered a language isolate.</skos:definition>
   </skos:Concept>
