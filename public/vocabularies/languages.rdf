      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="zua">Zeem</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">zua</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">zua</skos:notation>
      <skos:prefLabel xml:lang="en">Zeem</skos:prefLabel>
      <dc:identifier>ZUA</dc:identifier>
      <atold:op-code>ZUA</atold:op-code>
      <at:op-code>ZUA</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ZUA</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>zua</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">The current Ethnologue listing (Eberhard et al. 2022), has Cha’ari [cxh], Dokshi [dsk], Dyarim [dyr], Tulai [tvi], and Zeem as dialects of Zeem. However, the findings of the survey authored by Decker and Araokanmi 2022 showed that Zeem is neither a cluster of related languages nor a language with several dialects. They are five distinct languages and should be given separate identifiers.</skos:scopeNote>
      <at:end.use>2023-01-20</at:end.use>
   </skos:Concept>
