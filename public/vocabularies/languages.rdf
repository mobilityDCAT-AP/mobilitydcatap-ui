      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="tne">Tinoc Kallahan</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">tne</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">tne</skos:notation>
      <skos:prefLabel xml:lang="en">Tinoc Kallahan</skos:prefLabel>
      <dc:identifier>TNE</dc:identifier>
      <atold:op-code>TNE</atold:op-code>
      <at:op-code>TNE</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TNE</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>tne</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">The name for the languages (although they should actually be treated as dialects of one language) referred to in Ethnologue as Kallahan Tinoc (tne) and Kallahan Kayapa (kak) should be "Kalanguya" because this is the name used by native speakers of both dialects. Thus, Tinoc Kallahan [tne] merged into Kalanguya [kak].</skos:scopeNote>
      <at:end.use>2016-01-15</at:end.use>
   </skos:Concept>
