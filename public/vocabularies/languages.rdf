      <skos:prefLabel xml:lang="en">Nambya</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Nambja</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">nambijština</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">nambja</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">nambja</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">nambja</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νάμπια</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">nâmbia</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">език намбя</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">nambya</skos:prefLabel>
      <dc:identifier>NMQ</dc:identifier>
      <atold:op-code>NMQ</atold:op-code>
      <at:op-code>NMQ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>NMQ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nmq</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Nambya is a Bantu language spoken by the Nambya people. It is spoken in northwestern Zimbabwe, particularly in the town of Hwange with a few speakers in northeastern Botswana. It is either classified as a dialect of Kalanga or as a closely related language. The Zimbabwean constitution recognises Nambya and Kalanga as separate indigenous languages. Nambya is one of Zimbabwe‘s 16 official languages.</skos:definition>
   </skos:Concept>
