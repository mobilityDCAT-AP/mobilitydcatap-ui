      <skos:prefLabel xml:lang="el">μαλαισιανή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Malaysian Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta na Malaeisia</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">malesialainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">malajski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">malaiziešu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Malaysia</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos malasia</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">malezyjski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">malajsijský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Malaysische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Malasjana</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">малайский жестовый язык</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual malaia</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">малайзийски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="et">malaisia viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">malajiečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes malaisienne</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">malajský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="da">malaysisk tegnsprog</skos:prefLabel>
      <dc:identifier>XML</dc:identifier>
      <atold:op-code>XML</atold:op-code>
