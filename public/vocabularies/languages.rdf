   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/NBR"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="nns">Ningye</skos:altLabel>
      <skos:altLabel xml:lang="nbr">Gbantu</skos:altLabel>
      <skos:altLabel xml:lang="nbr">Janda</skos:altLabel>
      <skos:altLabel xml:lang="nbr">Numbu</skos:altLabel>
      <skos:altLabel xml:lang="nbr">Numana</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">nbr</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">nbr</skos:notation>
      <skos:prefLabel xml:lang="en">Numana</skos:prefLabel>
      <dc:identifier>NBR</dc:identifier>
      <atold:op-code>NBR</atold:op-code>
      <at:op-code>NBR</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>NBR</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nbr</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Numana is a Plateau language of Nigeria. It is a dialect cluster comprising the main dialects Gbantu, Janda, Numbu and Ningye. Numana is classified within the Volta-Congo primary branch of the Atlantic–Congo lineage, the largest demonstrated language family in Africa. Like related Bantu and Bantoid languages, Numana has a noun class system, a characteristic feature of languages belonging to this lineage.</skos:definition>
   </skos:Concept>
