   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/RRM"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="rrm">Te Rē Mōriori</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">rrm</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">rrm</skos:notation>
      <skos:prefLabel xml:lang="en">Moriori</skos:prefLabel>
      <dc:identifier>RRM</dc:identifier>
      <atold:op-code>RRM</atold:op-code>
      <at:op-code>RRM</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>RRM</at:authority-code>
      <skos:definition xml:lang="en">Moriori, or ta rē Moriori ('the Moriori language'), is a Polynesian language most closely related to New Zealand Māori. It is part of the Austronesian language family. It is spoken by the Moriori, the indigenous people of New Zealand's Chatham Islands (Rēkohu in Moriori), an archipelago located east of the South Island. Moriori went extinct as a first language at the turn of the 20th century, but revitalisation attempts are ongoing.</skos:definition>
   </skos:Concept>
