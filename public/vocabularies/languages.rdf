   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/WRB"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Warluwara</skos:altLabel>
      <skos:altLabel xml:lang="wrb">Waluwarra</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wrb</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wrb</skos:notation>
      <skos:prefLabel xml:lang="en">Waluwarra</skos:prefLabel>
      <dc:identifier>WRB</dc:identifier>
      <atold:op-code>WRB</atold:op-code>
      <at:op-code>WRB</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WRB</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wrb</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Warluwara, also known as Warluwara, is an extinct Australian Aboriginal language of Queensland. It had a developed signed form of their language. It is related to the Ngarru group of languages within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
