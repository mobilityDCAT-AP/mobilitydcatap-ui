   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/AWG"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="awg">Anguthimri</skos:altLabel>
      <skos:altLabel xml:lang="en">Mpakwithi</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">awg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">awg</skos:notation>
      <skos:prefLabel xml:lang="en">Anguthimri</skos:prefLabel>
      <dc:identifier>AWG</dc:identifier>
      <atold:op-code>AWG</atold:op-code>
      <at:op-code>AWG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>AWG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>awg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Anguthimri (Jupangati, Angadimi) is an extinct Pama-Nyungan language formerly spoken on the Cape York Peninsula of Queensland, Australia, by the Anguthimri people who lived in the area from the mouth of the Mission River north to Pennefather River and west to Duyfken Point. Anguthimri falls under the Paman branch and more specifically under the Northern Pama sub-branch. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
