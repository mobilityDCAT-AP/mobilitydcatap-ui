   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/PTI"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Wangkatha</skos:altLabel>
      <skos:altLabel xml:lang="pti">Pindiini</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">pti</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">pti</skos:notation>
      <skos:prefLabel xml:lang="en">Pindiini</skos:prefLabel>
      <dc:identifier>PTI</dc:identifier>
      <atold:op-code>PTI</atold:op-code>
      <at:op-code>PTI</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>PTI</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>pti</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Pindiini, also known as Wangkatha, is a Pama-Nyungan language spoken in the western desert region of Australia. It is one of the Wati languages. The name Wati tends to be used when considering the various varieties to be distinct languages, Western Desert when considering them dialects of a single language. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
