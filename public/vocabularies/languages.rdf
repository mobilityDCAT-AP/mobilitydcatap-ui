      <skos:prefLabel xml:lang="pt">língua gestual de Ban Khor</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Ban-Khor-Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes de Ban Khor</skos:prefLabel>
