      <skos:altLabel xml:lang="fr">nanzva</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">nmq</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">nmq</skos:notation>
      <skos:prefLabel xml:lang="de">Nambya</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">nambya</skos:prefLabel>
      <skos:prefLabel xml:lang="da">nambya</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">nambya</skos:prefLabel>
