   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/NYX"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="nyx">Nganyaywana</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">nyx</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">nyx</skos:notation>
      <skos:prefLabel xml:lang="en">Nganyaywana</skos:prefLabel>
      <dc:identifier>NYX</dc:identifier>
      <atold:op-code>NYX</atold:op-code>
      <at:op-code>NYX</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>NYX</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nyx</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Nganyaywana is an extinct Pama-Nyungan language, once spoken in the Macleay Valley in New South Wales, Australia. Nganyaywana is closely related to Dyangadi, and both have been called the Macleay Valley languages. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
