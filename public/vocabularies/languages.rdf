      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="aog">Kanda</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">aog</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">aog</skos:notation>
      <skos:prefLabel xml:lang="en">Angoram</skos:prefLabel>
      <dc:identifier>AOG</dc:identifier>
      <atold:op-code>AOG</atold:op-code>
      <at:op-code>AOG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>AOG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>aog</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Angoram, also known as Pondo and called Kanda by its speakers, is a Papuan language spoken along the northern coastal region of Papua New Guinea. Maramba, listed in Ethnologue, has been found to be a dialect of Angoram that is spoken in Maramba village. Angoram belongs to the small Ramu-Lower Sepik language family.</skos:definition>
   </skos:Concept>
