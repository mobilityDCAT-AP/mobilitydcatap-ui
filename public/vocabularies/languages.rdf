      <skos:prefLabel xml:lang="nl">Sierra Leoonse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes sierra-léonaise</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νοηματική γλώσσα Σιέρα Λεόνε</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Sierra-Leonische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">sierraleonský znakový jazyk</skos:prefLabel>
