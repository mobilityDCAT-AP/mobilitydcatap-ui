      <skos:prefLabel xml:lang="el">νοηματική γλώσσα Προβιντένσια</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual de Providência</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">providencijský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Providencia</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">znakovni jezik otoka Providencia</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Providencia</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от о. Провиденсия</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali ta’ Providencia</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Providencia-teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni di Providence</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Providences zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Apvaizdos salos gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Gebarentaal van Providencia</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">posunkový jazyk ostrova Providence</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos de Providencia</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Providencia-szigeti jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">znakovni jezik Providencia</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Providencia viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Providencia tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes de Providencia</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Providencia Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Providencia-Gebärdensprache</skos:prefLabel>
      <dc:identifier>PRZ</dc:identifier>
      <atold:op-code>PRZ</atold:op-code>
      <at:op-code>PRZ</at:op-code>
