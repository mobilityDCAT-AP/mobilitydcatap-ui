      <skos:prefLabel xml:lang="ro">limbajul prin semne din Egipt</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">egyptský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual egípcia</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">egyptiläinen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="da">egyptisk tegnsprog</skos:prefLabel>
