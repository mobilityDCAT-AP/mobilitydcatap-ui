      <skos:prefLabel xml:lang="de">Polnische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">polski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Pollakka</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">poljski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Polish Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">lenkų gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni polacca</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">poljski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="da">polsk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">poļu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">puolalainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta na Polainne</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Polonia</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos polaca</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">polskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Poolse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes polonaise</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">полски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">polský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="et">poola viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="el">πολωνική νοηματική γλώσσα</skos:prefLabel>
      <dc:identifier>PSO</dc:identifier>
      <atold:op-code>PSO</atold:op-code>
      <at:op-code>PSO</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>PSO</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>pso</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Polish Sign Language is a sign language used in Poland. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/SNE"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="sne">Bau Bidayuh</skos:altLabel>
      <skos:altLabel xml:lang="en">Jagoi</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">sne</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">sne</skos:notation>
      <skos:prefLabel xml:lang="en">Bau Bidayuh</skos:prefLabel>
      <dc:identifier>SNE</dc:identifier>
      <atold:op-code>SNE</atold:op-code>
      <at:op-code>SNE</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SNE</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>sne</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Bau Bidayuh is a Dayak language of Borneo. It is closely related to the Bukar-Sadung Bidayuh (sdo), Biatah Bidayuh (bth) and Tringgus-Sembaan Bidayuh (trx) languages. Bau Bidayuh belongs to the Malayo-Polyneasian primary branch of the Austronesian language family. Two main morphological characteristics of the Malayo-Polynesian languages are a system of affixation and reduplication to form new words.</skos:definition>
   </skos:Concept>
