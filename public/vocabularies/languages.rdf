   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/XBY"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Butchulla</skos:altLabel>
      <skos:altLabel xml:lang="en">Batyala</skos:altLabel>
      <skos:altLabel xml:lang="xby">Batjala</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xby</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xby</skos:notation>
      <skos:prefLabel xml:lang="en">Batjala</skos:prefLabel>
      <dc:identifier>XBY</dc:identifier>
      <atold:op-code>XBY</atold:op-code>
      <at:op-code>XBY</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XBY</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xby</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Batjala is an endangered Australian Aboriginal language traditionally spoken by the Butchulla people in K'gari (Fraser Island) of Queensland. Batjala is closely related to Gabi-Gabi (gbw). Both belong to the Waka-Kabic sub-group within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
