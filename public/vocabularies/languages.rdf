   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/SNZ"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="snz">Kou</skos:altLabel>
      <skos:altLabel xml:lang="en">Sinsauru</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">snz</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">snz</skos:notation>
      <skos:prefLabel xml:lang="en">Kou</skos:prefLabel>
      <dc:identifier>SNZ</dc:identifier>
      <atold:op-code>SNZ</atold:op-code>
      <at:op-code>SNZ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SNZ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>snz</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kou (Kow), or Sinsauru, is a Rai Coast language spoken in Madang Province, Papua New Guinea. The putative 'Asas' language is just the Kou spoken in Asas village. Rai Coast group belongs to the Trans–New Guinea languages spoken on the island of New Guinea and neighboring islands, a region corresponding to the country Papua New Guinea as well as parts of Indonesia. Trans–New Guinea is perhaps the third-largest language family in the world by number of languages.</skos:definition>
   </skos:Concept>
