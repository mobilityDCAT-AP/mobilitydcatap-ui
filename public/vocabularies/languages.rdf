      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Wanman</skos:altLabel>
      <skos:altLabel xml:lang="wbt">Warnman</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wbt</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wbt</skos:notation>
      <skos:prefLabel xml:lang="en">Warnman</skos:prefLabel>
      <dc:identifier>WBT</dc:identifier>
      <atold:op-code>WBT</atold:op-code>
      <at:op-code>WBT</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WBT</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wbt</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Warnman is an endangered Pama-Nyungan language spoken near Jigalong in Western Australia. It is one of the Wati languages of the Western Desert. The name Wati tends to be used when considering the various varieties to be distinct languages, Western Desert when considering them dialects of a single language. Warnman is most closely related to Martu Wangka (mpj). The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
