      <skos:definition xml:lang="en">Indian Sign Language is a sign language used in India. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/LII"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="lii">Lingkhim</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">lii</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">lii</skos:notation>
      <skos:prefLabel xml:lang="en">Lingkhim</skos:prefLabel>
      <dc:identifier>LII</dc:identifier>
      <atold:op-code>LII</atold:op-code>
      <at:op-code>LII</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>LII</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>lii</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">In the Ethnologue, Lingkhim [lii], is listed as a separate Western Kiranti language, but the Saam [raq] entry already represents the Western Kiranti language of Lingkhim (a place name, see van Driem 2001:623, 704-705), so the Lingkhim entry is spurious.</skos:scopeNote>
      <at:end.use>2015-01-12</at:end.use>
   </skos:Concept>
