   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/SKK"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="skk">Sok</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">skk</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">skk</skos:notation>
      <skos:prefLabel xml:lang="en">Sok</skos:prefLabel>
      <dc:identifier>SKK</dc:identifier>
      <atold:op-code>SKK</atold:op-code>
      <at:op-code>SKK</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SKK</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>skk</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Sidwell &amp; Jacq (2003) consider Oi [Oy], Sok, and Cheng [Jeng] to be dialects of the same language. Oy and Jeng share 95% lexical similarity, well above the threshhold for dialects on one language (p. 6). As for Sok, Sidwell &amp; Jacq (2003) report that "they consider themselves as Oi [Oy] (Oi-Sok). Thus, Sok [skk] merged into Oy [oyb].</skos:scopeNote>
      <at:end.use>2017-01-31</at:end.use>
   </skos:Concept>
