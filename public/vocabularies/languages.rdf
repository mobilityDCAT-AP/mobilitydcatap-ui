         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kurnai is an Australian Aboriginal language spoken in Gippsland in south-east Victoria. Bidawal (ihw) was either a divergent dialect or a closely related language. The Kurnai called their own dialect mŭk-dhang, and that of the Bidawal kwai-thang (‘rough speech’). Both languages are classified within the Ganaic branch of the Pama-Nyungan languages, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/CSV"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="csv">Sumtu</skos:altLabel>
      <skos:altLabel xml:lang="en">Sumtu</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">csv</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">csv</skos:notation>
      <skos:prefLabel xml:lang="en">Sumtu Chin</skos:prefLabel>
      <dc:identifier>CSV</dc:identifier>
      <atold:op-code>CSV</atold:op-code>
      <at:op-code>CSV</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>CSV</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>csv</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Sumtu Chin is a Tibeto-Burman language falling under the Kuki-Chin sub-branch of the Sino-Tibetan language family. Sumtu is spoken in Ann, Minbya, and Myebon townships in Rakhine State, Myanmar. Compared to Sinitic languages, Kuki-Chin languages are tonal but less so, and they are less isolating and more morphologically structured. They also tend to display areal features with neighbouring Austro-Asiatic languages.</skos:definition>
   </skos:Concept>
