   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/XMX"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Maden</skos:altLabel>
      <skos:altLabel xml:lang="xmx">Kawit</skos:altLabel>
      <skos:altLabel xml:lang="xmx">Rajau</skos:altLabel>
      <skos:altLabel xml:lang="xmx">Wail</skos:altLabel>
      <skos:altLabel xml:lang="xmx">Tepin</skos:altLabel>
      <skos:altLabel xml:lang="xmx">Butlih</skos:altLabel>
      <skos:altLabel xml:lang="xmx">Fiat</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xmx</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xmx</skos:notation>
      <skos:prefLabel xml:lang="en">Salawati</skos:prefLabel>
      <dc:identifier>XMX</dc:identifier>
      <atold:op-code>XMX</atold:op-code>
      <at:op-code>XMX</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XMX</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xmx</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Salawati, also known as Maden, belongs to the Malayo-Polynesian primary branch of the Austronesian language family. It is spoken on Salawati Island, in the Raja Ampat Islands in Indonesian New Guinea. There is some uncertainty as to whether the dialects comprise a single language or two separate ones (divided geographically between the west and east sides of the island).</skos:definition>
   </skos:Concept>
