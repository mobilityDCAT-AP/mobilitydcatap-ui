      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xpf</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xpf</skos:notation>
      <skos:prefLabel xml:lang="en">Southeast Tasmanian</skos:prefLabel>
      <dc:identifier>XPF</dc:identifier>
      <atold:op-code>XPF</atold:op-code>
      <at:op-code>XPF</at:op-code>
