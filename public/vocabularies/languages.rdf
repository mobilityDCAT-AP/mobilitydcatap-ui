      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="xbe">Bigambal</skos:altLabel>
      <skos:altLabel xml:lang="en">Pikumbul</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xbe</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xbe</skos:notation>
      <skos:prefLabel xml:lang="en">Bigambal</skos:prefLabel>
      <dc:identifier>XBE</dc:identifier>
      <atold:op-code>XBE</atold:op-code>
      <at:op-code>XBE</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XBE</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xbe</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Bigambal is an extinct Australian Aboriginal language formerly spoken in Goondiwindi Region, Queensland. According to Glottolog, Bigambal is closely related to Yugambal. In any case, Bigambal belongs to the Pama–Nyungan family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
