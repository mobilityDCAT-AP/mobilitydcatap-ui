         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Tanzanian Sign Language is a sign language used in Tanzania. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/KOJ"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="koj">Sara Dunjo</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">koj</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">koj</skos:notation>
      <skos:prefLabel xml:lang="en">Sara Dunjo</skos:prefLabel>
      <dc:identifier>KOJ</dc:identifier>
      <atold:op-code>KOJ</atold:op-code>
      <at:op-code>KOJ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KOJ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>koj</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Sara Dunjo [koj] is listed as a separate language, but our only information on Dunjo (Tucker and Bryan 1956:57, Caprile 1981:239) in the past century claims that it is a dialect (of the city Njounjou) of the language in the Sara Kaba Naa [kwv] entry (where indeed Dunje is listed as a dialect).</skos:scopeNote>
      <at:end.use>2015-01-12</at:end.use>
   </skos:Concept>
