      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">lzh</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">lzh</skos:notation>
