      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0002"/>
      <skos:altLabel xml:lang="fss">Finland-Swedish Sign Language</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">fss</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">fss</skos:notation>
      <skos:prefLabel xml:lang="lv">Somijas zviedru zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">suomenruotsalainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne suedez-finlandez</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Finland-Zweedse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Finnland – schwedische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">finnországi svéd jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">финско-шведски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni finlandese-svedese</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Finland-Swedish Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual sueca da Finlândia</skos:prefLabel>
      <skos:prefLabel xml:lang="et">soome rootsi viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos sueco-finlandesa</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">znakovni jezik švedsko govoreče skupnosti na Finskem</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Shualainnis na Fionlainne</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">fínsko-švédsky posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="el">φινλανδοσουηδική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">finsko-švedski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Suomijos švedų gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">finskošvédský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">fińsko-szwedzki język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Finlandssvenskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes finno-suédoise</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Finlandiża - Żvediża</skos:prefLabel>
      <skos:prefLabel xml:lang="da">finsk-svensk tegnsprog</skos:prefLabel>
      <dc:identifier>FSS</dc:identifier>
      <atold:op-code>FSS</atold:op-code>
      <at:op-code>FSS</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>FSS</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>fss</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Finland-Swedish Sign Language is a sign language used in Swedish community in Finland. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
