      <skos:prefLabel xml:lang="lv">Šveices vācu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">švýcarsko-německý znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Żvizzera - Ġermaniża</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni svizzero-tedesca</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Šveicarijos vokiečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Elveția germanofonă</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">švicarsko-njemački znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos germano-suiza</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">švajčiarsko-nemecký posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="da">schweizisk-tysk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">znakovni jezik nemško govoreče skupnosti v Švici</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">szwajcarsko-niemiecki język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">sveitsinsaksalainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Swiss-German Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">швейцарски немски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="el">ελβετογερμανική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual alemã da Suíça</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">svájci német jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Zwitserduitse Gebarentaal</skos:prefLabel>
