   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/SYY"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0002"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0002"/>
      <skos:altLabel xml:lang="syy">Al-Sayyid Bedouin Sign Language</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">syy</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">syy</skos:notation>
      <skos:prefLabel xml:lang="pt">língua gestual dos beduínos de Al-Sayyid</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νοηματική γλώσσα των βεδουίνων Al-Sayyid</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne al beduinilor din al-Sayyid</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">beduiński język migowy Al.-Sayyid</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">ал-сайидски бедуински жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">as-sajjidský beduínský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes bédouine d’Al-Sayyid</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Al-Sayyid beduinski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Al-Sayyid Bedouin-gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">al-Sayyid-beduiinien viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Al-Sayyid-Beduinen-Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Bheidiúnach Al-Sayyid</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Saido beduinų gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">znakovni jezik plemena Al-Sayyid Bedouin</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Al-Sayyid Bedouin Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos de los beduinos Al‑Sayyid</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">as-sajjidský beduínsky posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Bedwina ta’ Al-Sayyid</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Al Saīdas beduīnu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Al-Sayyidi beduiinide viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">al-sayyidi beduin jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Al-Sayyid-beduin-teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni beduina di Al-Sayyid</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Al-Sayyid-beduin-tegnsprog</skos:prefLabel>
      <dc:identifier>SYY</dc:identifier>
      <atold:op-code>SYY</atold:op-code>
      <at:op-code>SYY</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SYY</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>syy</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Al-Sayyid Bedouin Sign Language is a village sign language used by the al-Sayyid Bedouin tribe in Israel. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
