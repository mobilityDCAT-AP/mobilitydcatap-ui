   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MEM"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Mangarla</skos:altLabel>
      <skos:altLabel xml:lang="mem">Mangala</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mem</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mem</skos:notation>
      <skos:prefLabel xml:lang="en">Mangala</skos:prefLabel>
      <dc:identifier>MEM</dc:identifier>
      <atold:op-code>MEM</atold:op-code>
      <at:op-code>MEM</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MEM</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mem</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Mangala, also know as Mangarla, is a critically endangered Australian Aboriginal language spoken by the Mangala people in the north-western area of the Great Sandy Desert, inland from the coast. Together with its closest relative, Karajarri (gbd), it belongs to the Marrngu subgroup of the Pama-Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages.</skos:definition>
   </skos:Concept>
