   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/ZIN"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Dzinda</skos:altLabel>
      <skos:altLabel xml:lang="zin">Zinza</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">zin</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">zin</skos:notation>
      <skos:prefLabel xml:lang="en">Zinza</skos:prefLabel>
      <dc:identifier>ZIN</dc:identifier>
      <atold:op-code>ZIN</atold:op-code>
      <at:op-code>ZIN</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ZIN</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>zin</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Zinza is an East Bantu language spoken on the southern shore of Lake Victoria. It is classified within the Volta-Congo primary branch of the Atlantic-Congo language family. Like other Bantu languages, Zinza has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
