         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Huizhou Chinese is a group of closely related Sinitic languages spoken over a small area in and around the historical region of Huizhou, plus in southern Anhui and in neighbouring Zhejiang and Jiangxi. Its classification is disputed, with some linguists classifying it as Wu Chinese, others as Gan, and still others setting it apart as a primary branch of Chinese.</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/ZHO"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/LZH"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
