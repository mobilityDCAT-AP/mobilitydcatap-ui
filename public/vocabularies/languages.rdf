   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/WLH"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="wlh">Welaun</skos:altLabel>
      <skos:altLabel xml:lang="en">Bekais</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wlh</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wlh</skos:notation>
      <skos:prefLabel xml:lang="en">Welaun</skos:prefLabel>
      <dc:identifier>WLH</dc:identifier>
      <atold:op-code>WLH</atold:op-code>
      <at:op-code>WLH</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WLH</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wlh</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Welaun (also known as Bekais or Wekais) is an Austronesian language belonging to the Malayo-Polynesian primary branch spoken on the border of East Timor and West Timor (a part of Indonesia). It is closely related to Tetun. On the basis of historical comparative analysis (presented in Edwards 2019), Welaun can be shown to be a member of the Central Timor subgroup.</skos:definition>
   </skos:Concept>
