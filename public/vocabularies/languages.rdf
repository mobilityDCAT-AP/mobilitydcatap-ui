   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/JRT"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="jrt">d͡ʒækɜ́to</skos:altLabel>
      <skos:altLabel xml:lang="en">Jorto</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">jrt</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">jrt</skos:notation>
      <skos:prefLabel xml:lang="en">Jakattoe</skos:prefLabel>
      <dc:identifier>JRT</dc:identifier>
      <atold:op-code>JRT</atold:op-code>
      <at:op-code>JRT</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>JRT</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>jrt</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Jakattoe is a West Chadic language spoken in Plateau State, Nigeria. It was identified by Roger Blench in 2016. It is spoken by about 500 people in one village, Dokan Tofa, which is located on the Jos-Shendam road in Plateau State. Blench (2017) suggests that Jakattoe may be related to spurious records of the Jorto language. Jakattoe speakers claim that their language is related to Goemai. Along with Berber, Cushitic, Egyptian and Semitic branches, Chadic belongs to the Afro-Asiatic language family, constituting the fourth-largest language family after Indo-European, Sino-Tibetan, and Niger–Congo.</skos:definition>
   </skos:Concept>
