      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="gbc">Garawa</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">gbc</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">gbc</skos:notation>
      <skos:prefLabel xml:lang="en">Garawa</skos:prefLabel>
      <dc:identifier>GBC</dc:identifier>
      <atold:op-code>GBC</atold:op-code>
      <at:op-code>GBC</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>GBC</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>gbc</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">The many correspondences in grammar, especially the pronoun inventories, confirm the conclusion that these languages are closely related, but at the same time the substantial differences in grammar suggest that they must be mutually unintelligible -- closely related languages rather than dialects of a language</skos:scopeNote>
      <at:end.use>2012-02-03</at:end.use>
   </skos:Concept>
