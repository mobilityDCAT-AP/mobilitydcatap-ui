   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MGX"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="mgx">Omati</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mgx</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mgx</skos:notation>
      <skos:prefLabel xml:lang="en">Omati</skos:prefLabel>
      <dc:identifier>MGX</dc:identifier>
      <atold:op-code>MGX</atold:op-code>
      <at:op-code>MGX</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MGX</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mgx</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Omati is the name of a village, and not the name of a language, so the name Omati should be replaced by the two new names: Mouwase and Barikewa. Although reports indicate that there is some mutual intelligibility between speakers of the Mouwase [jmw] and Barikewa [jbk] languages, speakers of these languages see themselves as having distinct linguistic identities.</skos:scopeNote>
      <at:end.use>2012-02-03</at:end.use>
   </skos:Concept>
