   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MJT"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="mjt">Sauria Paharia</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mjt</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mjt</skos:notation>
      <skos:prefLabel xml:lang="en">Sauria Paharia</skos:prefLabel>
      <dc:identifier>MJT</dc:identifier>
      <atold:op-code>MJT</atold:op-code>
      <at:op-code>MJT</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MJT</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mjt</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Sauria Paharia is a North Dravidian language spoken by the Malto people of East India. It is spoken in the West Bengal, Jharkhand, and Bihar states of India. There are two varieties of Malto: Sauria Paharia and Kumarbhag Paharia. The lexical similarity between the two is estimated to be 80%. The most closely related language to Malto is Kurukh. Together with Brahui, all three languages form the North Dravidian branch of the Dravidian language family. Kurukh is written in Devanagari, a script also used to write Indo-Aryan languages.</skos:definition>
   </skos:Concept>
