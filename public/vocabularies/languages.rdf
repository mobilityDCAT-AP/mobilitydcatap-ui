   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/YIN"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Yinchia</skos:altLabel>
      <skos:altLabel xml:lang="yin">Riang Lai</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">yin</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">yin</skos:notation>
      <skos:prefLabel xml:lang="en">Riang Lai</skos:prefLabel>
      <dc:identifier>YIN</dc:identifier>
      <atold:op-code>YIN</atold:op-code>
      <at:op-code>YIN</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>YIN</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>yin</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Riang Lai is a Palaungic language of Myanmar. It belongs to the Austro-Asiatic language family. Speakers are culturally assimilated with the Karen, but are Palaung by ancestry and their language is unrelated. Riang Lai (Yinchia) and Riang Lang (Yinnet) are sometimes considered distinct languages, sometimes the same language. Like many Austroasiatic languages, Palaungic languages are characterised by prefixation in its clause structure and larger than average vowel inventories.</skos:definition>
   </skos:Concept>
