      <skos:definition xml:lang="en">Central Min, or Min Zhong is a part of the Min group of varieties of Chinese. It is spoken in the valley of the Sha River in Sanming prefecture in the central mountain areas of Fujian.</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/ZHO"/>
   </skos:Concept>
