      <skos:prefLabel xml:lang="lv">marokāņu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="da">marokkansk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Marokkina</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">marocký posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">marokański język migowy</skos:prefLabel>
