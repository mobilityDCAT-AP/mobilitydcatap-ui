      <skos:prefLabel xml:lang="pt">língua gestual porto-riquenha</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Puerto Ricaanse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Puerto-ricanische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="da">puertoricansk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от Пуерто Рико</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni di Porto Rico</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">portorikanski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Phórtó Ríce</skos:prefLabel>
      <skos:prefLabel xml:lang="et">puerto rico viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">puertoricolainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Puerto Ricó-i jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">puertorikiečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Puerto Rico</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos portorriqueña</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">puertoricanskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes portoricaine</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">portorický posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Puertoriko zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">portorykański język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">portorický znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Puerto Rican Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">portoriški znakovni jezik</skos:prefLabel>
