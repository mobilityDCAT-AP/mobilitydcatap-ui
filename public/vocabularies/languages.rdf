      <skos:prefLabel xml:lang="lv">kalanga</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">kalanga</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">kalanga</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">kalanga</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">kalanga</skos:prefLabel>
      <skos:prefLabel xml:lang="it">kalanga</skos:prefLabel>
      <skos:prefLabel xml:lang="et">kalanga</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">kalanga</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">kalanga</skos:prefLabel>
      <skos:prefLabel xml:lang="es">kalanga</skos:prefLabel>
      <dc:identifier>KCK</dc:identifier>
      <atold:op-code>KCK</atold:op-code>
      <at:op-code>KCK</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KCK</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kck</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kalanga is a Bantu language spoken by the Kalanga people in Botswana and Zimbabwe with an extensive phoneme inventory. Kalanga is recognised as an official language by the Zimbabwean Constitution of 2013 and is taught in schools in areas where its speakers predominate. The Kalanga language is closely related to the Nambya, TshiVenda and KheLobedu languages of Zimbabwe and South Africa.</skos:definition>
   </skos:Concept>
