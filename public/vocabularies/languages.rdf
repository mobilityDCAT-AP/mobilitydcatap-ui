      <skos:prefLabel xml:lang="nl">Vlaams</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Pléimeannais</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">flamengo</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Flämisch</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">flamandă</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">flamländska</skos:prefLabel>
