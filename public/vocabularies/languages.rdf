      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Shetlandic</skos:altLabel>
      <skos:altLabel xml:lang="scz">Shaetlan</skos:altLabel>
      <skos:altLabel xml:lang="en">Shetland</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">scz</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">scz</skos:notation>
      <skos:prefLabel xml:lang="pl">szetlandzki</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">shetländska</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">šetlendiešu valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="es">setelandés</skos:prefLabel>
      <skos:prefLabel xml:lang="it">shetlandico</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">shetlandština</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Shaetlan</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Shaetlan</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Shaetlan</skos:prefLabel>
      <skos:prefLabel xml:lang="el">σετλανικά</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Shaetlan</skos:prefLabel>
      <skos:prefLabel xml:lang="et">šetlandi keel</skos:prefLabel>
      <skos:prefLabel xml:lang="da">shetlandsk</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">shetland</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">shetlandčina</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">shetlandês</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">šetlandiečių</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">shetlanti</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">shetlandeză</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">šetlandski</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">šetlandščina</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">шетландски</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Sealtainnis</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">shetlandi</skos:prefLabel>
      <dc:identifier>SCZ</dc:identifier>
      <atold:op-code>SCZ</atold:op-code>
      <at:op-code>SCZ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SCZ</at:authority-code>
      <skos:definition xml:lang="en">Shaetlan, also known as Shetland or Shetlandic, is a mixed language spoken in Shetland, an archipelago to the north of mainland Scotland. It emerged through the prolonged and stable bilingualism of Norn (the language of the previous settlers) and Lowlands Scots (mainly the varieties from Fife and Lothian) brought to Shetland from the early 15th century onward. It has been recognised as a highly distinct variety for centuries, and is now officially acknowledged as a language by ISO. It is classified within the North Germanic group of the Scandinavian branch of Indo-European languages.</skos:definition>
   </skos:Concept>
