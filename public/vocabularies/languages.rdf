   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/TAC"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="tac">Guazapar</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">tac</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">tac</skos:notation>
      <skos:prefLabel xml:lang="en">Lowland Tarahumara</skos:prefLabel>
      <dc:identifier>TAC</dc:identifier>
      <atold:op-code>TAC</atold:op-code>
      <at:op-code>TAC</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TAC</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>tac</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Lowland Tarahumara is a Southern Uto-Aztecan language spoken in northern Mexico. Together with Central Tarahumara (tar), Southeastern Tarahumara (tcu), Northern Tarahumara (thh) and Southwestern Tarahumara (twr), it forms the Tarahumaran group. The native name of Tarahumara language is Rarámuri or Ralámuli ra'ícha.</skos:definition>
   </skos:Concept>
