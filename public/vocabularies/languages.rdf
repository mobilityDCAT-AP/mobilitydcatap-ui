      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">emo</skos:notation>
      <skos:prefLabel xml:lang="en">Emok</skos:prefLabel>
      <dc:identifier>EMO</dc:identifier>
      <atold:op-code>EMO</atold:op-code>
      <at:op-code>EMO</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>EMO</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>emo</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">An Emok language (classified as extinct) in fact never existed. Emmo'ok is not the name of a language; it means simply 'our neighbour' in the languages of the Enlhet-Enenlhet
family. This explains why we have found no instances of a supposed Emok language</skos:scopeNote>
      <at:end.use>2014-02-03</at:end.use>
   </skos:Concept>
