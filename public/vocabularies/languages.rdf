      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali ta’ Trinidad u Tobago</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">znakový jazyk Trinidadu a Tobaga</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Trinidādas un Tobāgo zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Oileán na Tríonóide agus Thobága</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Trinidad och Tobago-teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">znakovni jezik Trinidada i Tobaga</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Trinidad og Tobago tegnsprog</skos:prefLabel>
