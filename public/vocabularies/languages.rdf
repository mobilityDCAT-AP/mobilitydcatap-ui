      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">myt</skos:notation>
      <skos:prefLabel xml:lang="en">Sangab Mandaya</skos:prefLabel>
      <dc:identifier>MYT</dc:identifier>
      <atold:op-code>MYT</atold:op-code>
      <at:op-code>MYT</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MYT</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>myt</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">The present codes for Mandaya (mrt, mry, and mst) do not represent dialects of Mandaya but data collection points when Andrew Gallman was gathering data for his dissertation some 30 years ago. In reality it is all the same language with a purer Mandaya in the mountains and more of a mixed variety of Mandaya along the coast.</skos:scopeNote>
      <at:end.use>2010-01-18</at:end.use>
   </skos:Concept>
