      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Munjan</skos:altLabel>
      <skos:altLabel xml:lang="xnu">Moondjan</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xnu</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xnu</skos:notation>
      <skos:prefLabel xml:lang="en">Nunukul</skos:prefLabel>
      <dc:identifier>XNU</dc:identifier>
      <atold:op-code>XNU</atold:op-code>
      <at:op-code>XNU</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XNU</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xnu</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Nunukul (Nununkul, Nunugal, Nunagal, misspelled "Nukunul"), or Munjan (Moonjan, Meanjin), is an extinct Pama-Nyungan language of Queensland in Australia. The people it is spoken by are called the Nunukul, but the language is called Moondjan.</skos:definition>
   </skos:Concept>
