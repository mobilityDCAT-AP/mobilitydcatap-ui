   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/WRK"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Karawa</skos:altLabel>
      <skos:altLabel xml:lang="wrk">Garrwa</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wrk</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wrk</skos:notation>
      <skos:prefLabel xml:lang="en">Garrwa</skos:prefLabel>
      <dc:identifier>WRK</dc:identifier>
      <atold:op-code>WRK</atold:op-code>
      <at:op-code>WRK</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WRK</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wrk</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Garrwa, also spelt Karawa, is an endangered Australian Aboriginal language spoken by the Garrwa people in the Northern Territory, whose traditional lands extended from east of the McArthur River at Borroloola to Doomadgee and the Nicholson River in Queensland. Together with the closely related Wanyi language, Garrwa and Wanyi are not currently classified within any larger Aboriginal language family; instead they form their own Garrwan language family.</skos:definition>
   </skos:Concept>
