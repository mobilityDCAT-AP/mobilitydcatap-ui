   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/USS"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Western Duka</skos:altLabel>
      <skos:altLabel xml:lang="uss">Saare</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">uss</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">uss</skos:notation>
      <skos:prefLabel xml:lang="en">us-Saare</skos:prefLabel>
      <dc:identifier>USS</dc:identifier>
      <atold:op-code>USS</atold:op-code>
      <at:op-code>USS</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>USS</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>uss</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">us-Saare, also known as Western Duka, is a Northwestern Kainji language of Nigeria. It is close to ut-Hun, also known as Eastern Duka. However, speakers use Saare for both languages. Noun class systems are a defining feature of the Atlantic–Congo languages, to which Kainji languages belong as part of the Volta-Congo primary branch and the Benue-Congo sub-branch.</skos:definition>
   </skos:Concept>
