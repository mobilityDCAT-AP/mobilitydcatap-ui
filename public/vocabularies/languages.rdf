      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="elp">Elpaputih</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">elp</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">elp</skos:notation>
      <skos:prefLabel xml:lang="en">Elpaputih</skos:prefLabel>
      <dc:identifier>ELP</dc:identifier>
      <atold:op-code>ELP</atold:op-code>
      <at:op-code>ELP</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ELP</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>elp</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">There are two languages on the Elpaputih Bay which may have been included in the Elpaputih language amq (Amahai), plh (Paulohi). These two languages are now nearly extinct. It seems probable that the lack of information caused Voeglin &amp; Voeglin to erroneously suggest that Elpaputih was it's own language.</skos:scopeNote>
      <at:end.use>2012-02-03</at:end.use>
   </skos:Concept>
