   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/LLO"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="llo">Khlor</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">llo</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">llo</skos:notation>
      <skos:prefLabel xml:lang="en">Khlor</skos:prefLabel>
      <dc:identifier>LLO</dc:identifier>
      <atold:op-code>LLO</atold:op-code>
      <at:op-code>LLO</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>LLO</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>llo</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">In January, 2018 I happened to be sitting next to a man from Sekong province. I asked him about Klor and to my shock and his, he reported that he himself was Klor. He confirmed that it is pronounced [klɔːr] with no aspiration and that the langauge is spoken only in Ko' [kɔʔ] village. He reported that Klor is completely mutually intellibile with Kriang and that he considers the Klor to be Kriang.</skos:scopeNote>
      <at:end.use>2019-01-25</at:end.use>
   </skos:Concept>
