   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/WKR"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="wkr">Kurnkopanut</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wkr</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wkr</skos:notation>
      <skos:prefLabel xml:lang="en">Keerray-Woorroong</skos:prefLabel>
      <dc:identifier>WKR</dc:identifier>
      <atold:op-code>WKR</atold:op-code>
      <at:op-code>WKR</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WKR</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wkr</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Keerray-Woorroong, also known as Kurnkopanut, is a Pama-Nyungan language spoken in Western District of Victoria, Australia. Together with its close relatives, it forms the Warrnambool dialect continuum and with slightly more distant Bunganditj the Warrnambool-Bunganditj group. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
