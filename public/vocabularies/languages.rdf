      <skos:prefLabel xml:lang="hr">zambijski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">zambijski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="et">sambia viipekeel</skos:prefLabel>
