   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/XPL"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Port Sorell</skos:altLabel>
      <skos:altLabel xml:lang="xpl">Port Sorell</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xpl</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xpl</skos:notation>
      <skos:prefLabel xml:lang="en">Port Sorell Tasmanian</skos:prefLabel>
      <dc:identifier>XPL</dc:identifier>
      <atold:op-code>XPL</atold:op-code>
      <at:op-code>XPL</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XPL</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xpl</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Port Sorell is an extinct aboriginal language of Tasmania in the reconstruction of Claire Bowern. It was spoken near Port Sorell, in the center of the north coast, just east of Northern Tasmanian proper. Dixon &amp; Crowley agree that there is unlikely to be a close connection to other varieties of Tasmanian. Port Sorell Tasmanian is attested from two word lists.</skos:definition>
   </skos:Concept>
