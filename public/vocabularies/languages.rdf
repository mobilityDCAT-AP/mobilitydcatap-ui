      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="pod">Ponares</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">pod</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">pod</skos:notation>
      <skos:prefLabel xml:lang="en">Ponares</skos:prefLabel>
      <dc:identifier>POD</dc:identifier>
      <atold:op-code>POD</atold:op-code>
      <at:op-code>POD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>POD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>pod</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Alan Wares, in correspondence with Barbara Grimes (5/28/1971), stated that Ponares should be deleted as "non-existent." The Ethnologue states that Ponares is a "Sáliba surname. [It] might have been a Piapoco or Achagua subgroup." Mention of this language is missing from all the major sources on South American languages.</skos:scopeNote>
      <at:end.use>2016-01-15</at:end.use>
   </skos:Concept>
