      <skos:prefLabel xml:lang="lv">Madagaskaras zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">malgaški znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="el">μαδαγασκαριανή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Madagascar</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Malagassische Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual malgaxe</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">madagarskarski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от Мадагаскар</skos:prefLabel>
