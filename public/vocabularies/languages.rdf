   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/IHW"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="ihw">mŭk-dhang</skos:altLabel>
      <skos:altLabel xml:lang="en">Bidawal</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ihw</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ihw</skos:notation>
      <skos:prefLabel xml:lang="en">Bidhawal</skos:prefLabel>
      <dc:identifier>IHW</dc:identifier>
      <atold:op-code>IHW</atold:op-code>
      <at:op-code>IHW</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>IHW</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ihw</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Bidhawal was an Australian Aboriginal language, either a dialect of or closely related to the Kurnai language. The Bidawal called their own dialect mŭk-dhang (‘good speech’), and that of the neighbouring Kurnai gūnggala-dhang 'strangers' language'. Both languages are classified within the Ganaic branch of the Pama-Nyungan languages, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
