   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/AMI"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="ami">Amis</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ami</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ami</skos:notation>
      <skos:prefLabel xml:lang="en">Amis</skos:prefLabel>
      <dc:identifier>AMI</dc:identifier>
      <atold:op-code>AMI</atold:op-code>
      <at:op-code>AMI</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>AMI</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ami</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Amis is a Formosan language spoken on the east coast of Taiwan by the Amis people. It belongs to the East Formosan primary branch of the Austronesian language family. Like many Austronesian languages, Amis is characterised by voice alternations in its clause structure and productive morphology, including affixation and reduplication to form new words.</skos:definition>
   </skos:Concept>
