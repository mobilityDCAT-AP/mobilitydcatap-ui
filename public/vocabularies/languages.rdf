   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/PFE"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="pfe">Per muure</skos:altLabel>
      <skos:altLabel xml:lang="en">Peere</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">pfe</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">pfe</skos:notation>
      <skos:prefLabel xml:lang="en">Pere</skos:prefLabel>
      <dc:identifier>PFE</dc:identifier>
      <atold:op-code>PFE</atold:op-code>
      <at:op-code>PFE</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>PFE</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>pfe</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Pere or Peere is a Bantu language spoken in Cameroon. It belongs to the Cameroon-Ubangian sub-branch within the Volta-Congo primary branch. Like other Bantu languages, Pere has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
