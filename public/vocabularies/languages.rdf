   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/YCR"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="ycr">宜蘭クレオール</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ycr</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ycr</skos:notation>
      <skos:prefLabel xml:lang="en">Yilan Creole</skos:prefLabel>
      <dc:identifier>YCR</dc:identifier>
      <atold:op-code>YCR</atold:op-code>
      <at:op-code>YCR</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>YCR</at:authority-code>
      <skos:definition xml:lang="en">Yilan Creole is a Japanese-based creole of Taiwan considered to be part of the Japonic language family. It arose in the 1930s and 1940s, with contact between Japanese colonists and the native Atayal people of southern Yilan County. Yilan Creole is mutually unintelligible with both Japanese and Atayal. The vocabulary of a speaker born in 1974 was 70% Japanese and 30% Atayal, but the grammar of the creole does not closely resemble either of the source languages.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/UMG"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Umbuygamu</skos:altLabel>
      <skos:altLabel xml:lang="umg">Morrobalama</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">umg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">umg</skos:notation>
      <skos:prefLabel xml:lang="en">Morrobalama</skos:prefLabel>
      <dc:identifier>UMG</dc:identifier>
      <atold:op-code>UMG</atold:op-code>
      <at:op-code>UMG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>UMG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>umg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Morrobalama is an extinct Pama-Nyungan language once spoken in Princess Charlotte Bay in far-north Queensland in Australia. It belongs to the Paman branch and more specifically to the Lamalamic group of languages. It is closely related to Lamalama (lby). The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
