   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/GBD"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="gbd">Karajarri</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">gbd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">gbd</skos:notation>
      <skos:prefLabel xml:lang="en">Karajarri</skos:prefLabel>
      <dc:identifier>GBD</dc:identifier>
      <atold:op-code>GBD</atold:op-code>
      <at:op-code>GBD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>GBD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>gbd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Karajarri is an endangered Australian Aboriginal language spoken by the Karajarri people along the coast of northwestern Australia. Together with its closest relative, Mangala (mem), it belongs to the Marrngu subgroup of the Pama-Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages.</skos:definition>
   </skos:Concept>
