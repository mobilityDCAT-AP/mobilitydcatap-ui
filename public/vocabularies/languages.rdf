      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ukv</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ukv</skos:notation>
      <skos:prefLabel xml:lang="en">Kuku</skos:prefLabel>
      <dc:identifier>UKV</dc:identifier>
      <atold:op-code>UKV</atold:op-code>
      <at:op-code>UKV</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>UKV</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ukv</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kuku, also called Kutuk na Kuku (Kuku language), is spoken in Southern Sudan and Northern Uganda. Together with Bari, it belongs to the Nuclear Barian group of the Eastern Nilotic branch of the Nilotic language family. Kuku was initially classified as a dialect of Bari.</skos:definition>
   </skos:Concept>
