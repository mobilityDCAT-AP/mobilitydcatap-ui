         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Bamako Sign Language is a sign language used in Bamako region in Mali. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/WDT"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Huron-Wendat</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">wdt</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">wdt</skos:notation>
      <skos:prefLabel xml:lang="en">Wendat</skos:prefLabel>
      <dc:identifier>WDT</dc:identifier>
      <atold:op-code>WDT</atold:op-code>
      <at:op-code>WDT</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>WDT</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>wdt</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Wendat (also Huron-Wendat) is the Iroquoian language traditionally spoken by descendants of the Huron-Wendat Confederacy. It is considered a sister to the Wyandot language, spoken by the people known as Wyandot or Wyandotte, descended from the Tionontati.</skos:definition>
   </skos:Concept>
