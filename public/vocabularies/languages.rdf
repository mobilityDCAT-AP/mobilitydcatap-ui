   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/BCK"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="bck">Bunuba</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">bck</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">bck</skos:notation>
      <skos:prefLabel xml:lang="en">Bunuba</skos:prefLabel>
      <dc:identifier>BCK</dc:identifier>
      <atold:op-code>BCK</atold:op-code>
      <at:op-code>BCK</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>BCK</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>bck</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Bunuba is an endangered Australian Aboriginal language spoken by some 41 older Bunuba adults, most of whom live in Junjuwa, an Aboriginal community in Fitzroy Crossing in Kimberley, Western Australia. Bunuba is not related to the Pama-Nyungan language family that spans the majority of Australia; however, it is a relative of Gooniyandi. Both belong to the Bunuban language family. Language maintenance and revival has increased during the later decades of the 20th century and the early 21st century due to the growing documentation of Bunuba language.</skos:definition>
   </skos:Concept>
