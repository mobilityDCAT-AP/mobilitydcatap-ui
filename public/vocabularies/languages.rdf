      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="uwa">Kuku-Uwanh</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">uwa</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">uwa</skos:notation>
      <skos:prefLabel xml:lang="en">Kuku-Uwanh</skos:prefLabel>
      <dc:identifier>UWA</dc:identifier>
      <atold:op-code>UWA</atold:op-code>
      <at:op-code>UWA</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>UWA</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>uwa</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kuku-Uwanh is an endangered Australian Aboriginal language spoken by Wik peoples on the Cape York Peninsula of Queensland. Kuku-Uwanh is closely related to Kuku-Muminh (xmh) and to Kuku-Mu'inh (xmp). All belong to the Paman sub-branch within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
