            <at:legacy-code>GD</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>TED</dc:source>
            <at:legacy-code>GD</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:exactMatch rdf:resource="http://id.loc.gov/vocabulary/iso639-1/gd"/>
      <skos:definition xml:lang="fr">Le gaélique écossais ou écossais est une langue celtique parlée en Écosse.Le gaélique écossais est reconnu par le Royaume-Uni comme langue régionale de l’Écosse, selon la charte européenne des langues régionales ou minoritaires.</skos:definition>
      <skos:definition xml:lang="en">Scottish Gaelic, sometimes also called Gaelic, is a Celtic language native to Scotland.Gaelic is an official language in Scotland and it is a recognised minority language of the United Kingdom, protected under the European Charter for Regional or Minority Languages.</skos:definition>
   </skos:Concept>
