            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>gse</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Ghanaian Sign Language is a sign language used in Ghana. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
