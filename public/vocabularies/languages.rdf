   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/NZD"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="nzd">Nzadi</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">nzd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">nzd</skos:notation>
      <skos:prefLabel xml:lang="en">Nzadi</skos:prefLabel>
      <dc:identifier>NZD</dc:identifier>
      <atold:op-code>NZD</atold:op-code>
      <at:op-code>NZD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>NZD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nzd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Nzadi is a Bantu language spoken in the Democratic Republic of the Congo. Together with Ngul (also Ngwii), Lwel and Ding, it belongs to the West-Coastal Bantu group, which is classified within the Volta-Congo primary branch. Like other Bantu languages, Nzadi has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
