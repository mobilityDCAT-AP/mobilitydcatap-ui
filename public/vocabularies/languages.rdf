            <at:legacy-code>cav</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Cavineña is a Tacanan indigenous language. It is one of the official languages of Bolivia.</skos:definition>
   </skos:Concept>
