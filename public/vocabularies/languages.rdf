   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/PSD"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0002"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0002"/>
      <skos:altLabel xml:lang="psd">Plains Indian Sign Language</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">psd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">psd</skos:notation>
      <skos:prefLabel xml:lang="sv">prärieindianskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Plains Indian viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Gebarentaal van de Prairie-indianen</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">tasankointiaanien viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="da">prærieindiansk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">posunkový jazyk Indiánov z plání</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">язык жестов североамериканских индейцев</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni delle pianure indiane</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual das Grandes Planícies</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne al amerindienilor de câmpie</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Ziemeļamerikas indiāņu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">znakovni jezik sjevernoameričkih Indijanaca</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Plains Indian-Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νοηματική γλώσσα Πλέινς Ίντιαν</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali tal-Pjanuri Indjani</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes des Indiens des Plaines</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos de las Grandes Llanuras</skos:prefLabel>
      <skos:prefLabel xml:lang="be">мова жэстаў паўночнаамерыканскіх індзейцаў</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">жестомимичен език от индийските равнини</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">znakový jazyk prérijních Indiánů</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">prerijų indėnų gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta na nIndiach Má</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">síksági indiánok jelnyelve</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">znakovni jezik ravninskih Ameriških staroselcev</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Plains Indian Sign Language</skos:prefLabel>
      <dc:identifier>PSD</dc:identifier>
      <atold:op-code>PSD</atold:op-code>
      <at:op-code>PSD</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>PSD</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>psd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Plains Indian Sign Language is a trade language (or international auxiliary language) that was once the lingua franca across central Canada, central and western United States and northern Mexico, used among the various Plains Nations. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
