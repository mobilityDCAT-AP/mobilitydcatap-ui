   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/XMP"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="xmp">Kuku-Mu'inh</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xmp</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xmp</skos:notation>
      <skos:prefLabel xml:lang="en">Kuku-Mu'inh</skos:prefLabel>
      <dc:identifier>XMP</dc:identifier>
      <atold:op-code>XMP</atold:op-code>
      <at:op-code>XMP</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XMP</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xmp</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kuku-Mu'inh is an extinct Australian Aboriginal language traditionally spoken by Wik peoples on the Cape York Peninsula of Queensland. Kuku-Mu'inh is closely related to Kuku-Muminh (xmh) and Kuku-Uwanh (uwa). All belong to the Paman sub-branch within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
