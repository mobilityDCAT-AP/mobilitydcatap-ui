   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/SHS"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="shs">Secwepemctsín</skos:altLabel>
      <skos:altLabel xml:lang="en">Secwepemctsin</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">shs</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">shs</skos:notation>
      <skos:prefLabel xml:lang="en">Shuswap</skos:prefLabel>
      <dc:identifier>SHS</dc:identifier>
      <atold:op-code>SHS</atold:op-code>
      <at:op-code>SHS</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SHS</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>shs</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Shuswap or secwepemctsín is an interior Salishan language spoken in the Central and Southern Interior of British Columbia between the Fraser River and the Rocky Mountains. The Interior Salish languages have a higher degree of closeness to each other than the more distant Coast Salish languages. Shuswap is an endangered language. According to the First Peoples' Cultural Council 200 people speak Shuswap as a mother tongue.</skos:definition>
   </skos:Concept>
