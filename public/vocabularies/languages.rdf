      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0002"/>
      <skos:altLabel xml:lang="ssr">Swiss-French Sign Language</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ssr</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ssr</skos:notation>
      <skos:prefLabel xml:lang="hr">švicarsko-francuski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">svájci francia jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">znakovni jezik francosko govoreče skupnosti v Švici</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Elveția francofonă</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Swiss-French Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">švajčiarsko-francúzsky posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">sveitsinranskalainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">szwajcarsko-francuski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos franco-suiza</skos:prefLabel>
      <skos:prefLabel xml:lang="da">schweizisk-fransk tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni svizzero-francese</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Westschweizer Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual francesa da Suíça</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Żvizzera - Franċiża</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">швейцарски френски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Šveicarijos prancūzų gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">schweizerfranskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes suisse romande</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Fhraincis na hEilvéise</skos:prefLabel>
      <skos:prefLabel xml:lang="et">šveitsi-prantsuse viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Šveices franču zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="el">ελβετογαλλική νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Zwitsers-Franse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">švýcarsko-francouzský znakový jazyk</skos:prefLabel>
      <dc:identifier>SSR</dc:identifier>
      <atold:op-code>SSR</atold:op-code>
      <at:op-code>SSR</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SSR</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ssr</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Swiss-French Sign Language is a sign language used in Switzerland by the French-speaking community. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
