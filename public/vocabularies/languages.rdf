         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Hazaragi is a member of the Western Iranian branch of the Indo-European language family. It is an eastern variety of Persian and closely related to Dari, one of the two official Languages of Afghanistan. The primary differences between Dari and Hazaragi are the accents and Hazaragi's greater array of many Turkic and Mongolic words and loanwords.</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/FAS"/>
   </skos:Concept>
