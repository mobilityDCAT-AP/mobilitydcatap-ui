      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="smi">Sámegielat</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">smi</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2B">smi</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_2T">smi</skos:notation>
      <skos:prefLabel xml:lang="no">samisk</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Saamelaiskielet</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">samiska</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Saami keeled</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">Саа́мские языки́</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Sami languages</skos:prefLabel>
      <dc:identifier>SMI</dc:identifier>
      <atold:op-code>SMI</atold:op-code>
      <at:op-code>SMI</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SMI</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2b</dc:source>
            <at:legacy-code>smi</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-2t</dc:source>
            <at:legacy-code>smi</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">Manually added collection language</skos:historyNote>
      <skos:definition xml:lang="en">The Sami languages, also rendered in English as Sámi and Saami, are a group of Uralic languages spoken by the indigenous Sami people of Northern Europe (in parts of northern Finland, Norway, Sweden, and the far northwest of Russia). There are, depending on the nature and terms of division, approximately nine living Sami languages, and much more if extinct varieties are included. The exonym Lappish is now often considered pejorative. The Sami languages form a dialect continuum in which the neighbouring languages are often intelligible to a fair degree, but two more widely separated varieties are not. There are, however, some sharp language boundaries, in particular between Northern Sami, Inari Sami and Skolt Sami whose traditional speech areas meet in Finland.</skos:definition>
   </skos:Concept>
