   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MFR"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="mfr">Marrithiyel</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mfr</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mfr</skos:notation>
      <skos:prefLabel xml:lang="en">Marrithiyel</skos:prefLabel>
      <dc:identifier>MFR</dc:identifier>
      <atold:op-code>MFR</atold:op-code>
      <at:op-code>MFR</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MFR</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mfr</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Marrithiyel is an endangered Australian Aboriginal language spoken by the Marrithiyel people whose traditional territory lay south of Darwin from Litchfield National Park and extend to the Daly River in the Northern Territory. It belongs to the small family of Western Daly languages, and more specifically to its Marithielic sub-branch.</skos:definition>
   </skos:Concept>
