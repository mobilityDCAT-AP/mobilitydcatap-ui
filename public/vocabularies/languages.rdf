      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Inawangga</skos:altLabel>
      <skos:altLabel xml:lang="ywg">Yinhawangka</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">ywg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">ywg</skos:notation>
      <skos:prefLabel xml:lang="en">Yinhawangka</skos:prefLabel>
      <dc:identifier>YWG</dc:identifier>
      <atold:op-code>YWG</atold:op-code>
      <at:op-code>YWG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>YWG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>ywg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Yinhawangka is an endangered Australian Aboriginal language spoken in Western Australia. Yinhawangka is classified as a member of the Ngayarta branch of the Pama–Nyungan languages. It is closely related to Banyjima (pnw). The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
