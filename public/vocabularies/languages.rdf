   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/LSN"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="lsn">藏语手语</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">lsn</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">lsn</skos:notation>
      <skos:prefLabel xml:lang="en">Tibetan Sign Language</skos:prefLabel>
      <dc:identifier>LSN</dc:identifier>
      <atold:op-code>LSN</atold:op-code>
      <at:op-code>LSN</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>LSN</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>lsn</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Tibetan Sign Language is the recently established deaf sign language of Tibet. It is the first recognized sign language for a minority in China. The Tibetan Sign Language Project was set up under the supervision of Handicap International in 2001 to create a standardized language, based primarily on the existing sign language of Lhasa, as a replacement for the regional sign languages of Tibet.</skos:definition>
   </skos:Concept>
