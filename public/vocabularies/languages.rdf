      <skos:altLabel xml:lang="en">Nhangu</skos:altLabel>
      <skos:altLabel xml:lang="jay">Yan-nhangu</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">jay</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">jay</skos:notation>
      <skos:prefLabel xml:lang="en">Yan-nhangu</skos:prefLabel>
