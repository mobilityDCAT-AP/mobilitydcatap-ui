      <skos:altLabel xml:lang="gdh">Gadjerawang</skos:altLabel>
      <skos:altLabel xml:lang="en">Gajirrabeng</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">gdh</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">gdh</skos:notation>
