   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/PND"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="pnd">Mpinda</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">pnd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">pnd</skos:notation>
      <skos:prefLabel xml:lang="en">Mpinda</skos:prefLabel>
      <dc:identifier>PND</dc:identifier>
      <atold:op-code>PND</atold:op-code>
      <at:op-code>PND</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>PND</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>pnd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Mpinda is a narrow Bantu language spoken in the north-west of Angola. Together with Kimbundu (kmb) and Kibala (blv), it belongs to the Mbundu group, which is classified within the Volta-Congo primary branch. Like other Bantu languages, Mpinda has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
