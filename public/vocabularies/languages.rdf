   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/KKM"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Kayon</skos:altLabel>
      <skos:altLabel xml:lang="kkm">Kiong</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">kkm</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">kkm</skos:notation>
      <skos:prefLabel xml:lang="en">Kiong</skos:prefLabel>
      <dc:identifier>KKM</dc:identifier>
      <atold:op-code>KKM</atold:op-code>
      <at:op-code>KKM</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KKM</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kkm</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kiong, also known as Kayon, is a nearly extinct Upper Cross River language of Nigeria. It is closely related to Durop. Like Bantu and Bantoid languages, Kiong has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa.</skos:definition>
   </skos:Concept>
