         <at:MappedCode>
            <dc:source>PUB</dc:source>
            <at:affected-table>PUB_LANG</at:affected-table>
            <at:legacy-code>0C</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <at:op-mapped-code>
