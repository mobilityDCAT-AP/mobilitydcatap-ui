   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/KUI"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="kui">Kalapálo</skos:altLabel>
      <skos:altLabel xml:lang="en">Kalapalo</skos:altLabel>
      <skos:altLabel xml:lang="kui">Kuikúro</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">kui</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">kui</skos:notation>
      <skos:prefLabel xml:lang="en">Kuikúro-Kalapálo</skos:prefLabel>
      <dc:identifier>KUI</dc:identifier>
      <atold:op-code>KUI</atold:op-code>
      <at:op-code>KUI</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>KUI</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>kui</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Kuikúro-Kalapálo is a Cariban language spoken by the Kuikuro and Kalapalo peoples in seven villages along the Culuene River in Brazil. Kuikúro-Kalapálo speak the same language but are ethnically distinct. A related Matipuhy language is spoken by the Matipu. Together, Kuikúro, Kalapálo and Matipuhy form the Nuclear Kuikuroan branch.</skos:definition>
   </skos:Concept>
