   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/PNW"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Panytyima</skos:altLabel>
      <skos:altLabel xml:lang="pnw">Banyjima</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">pnw</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">pnw</skos:notation>
      <skos:prefLabel xml:lang="en">Banyjima</skos:prefLabel>
      <dc:identifier>PNW</dc:identifier>
      <atold:op-code>PNW</atold:op-code>
      <at:op-code>PNW</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>PNW</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>pnw</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Banyjima, also known as Panytyima, is an endangered Australian Aboriginal language spoken in the Hamersley Range, in the Pilbara region of Western Australia. Panyjima is classified as a member of the Ngayarta branch of the Pama–Nyungan languages. It is closely related to Yinhawangka (ywg). The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
