      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">coy</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">coy</skos:notation>
      <skos:prefLabel xml:lang="en">Coyaima</skos:prefLabel>
