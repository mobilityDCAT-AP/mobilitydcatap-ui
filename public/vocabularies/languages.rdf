      <skos:prefLabel xml:lang="el">βολιβιανή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">bolíviai jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">bolivialainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Boliviaanse Gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Bolivian Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">bolivijski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos boliviana</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">bolivijski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">bolīviešu zīmju valoda</skos:prefLabel>
