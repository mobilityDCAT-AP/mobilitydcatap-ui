      <at:authority-code>GSM</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>gsm</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Guatemalan Sign Language is a sign language used in Guatemala. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
