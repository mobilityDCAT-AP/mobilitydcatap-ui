   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MEC"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="mec">Marra</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mec</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mec</skos:notation>
      <skos:prefLabel xml:lang="en">Marra</skos:prefLabel>
      <dc:identifier>MEC</dc:identifier>
      <atold:op-code>MEC</atold:op-code>
      <at:op-code>MEC</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MEC</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mec</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Marra is an endangered Australian Aboriginal language, traditionally spoken along the Gulf of Carpentaria coast in the Northern Territory around the Roper, Towns and Limmen Bight Rivers. Most Marra people now speak Kriol as their main language. Marra is a prefixing language. Unlike many languages in the area, it has little avoidance language. Marra is a member of the Arnhem, or Macro-Gunwinyguan family, the second-largest Australian language family after Pama–Nyungan, but this language family is not universally accepted.</skos:definition>
   </skos:Concept>
