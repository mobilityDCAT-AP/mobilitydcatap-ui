      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="rit">Ritharrngu</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">rit</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">rit</skos:notation>
      <skos:prefLabel xml:lang="en">Ritharrngu</skos:prefLabel>
      <dc:identifier>RIT</dc:identifier>
      <atold:op-code>RIT</atold:op-code>
      <at:op-code>RIT</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>RIT</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>rit</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Ritharrngu is a Pama-Nyungan language within the Yolngu sub-branch. It is spoken by the Ritharrngu people, also known as the Diakui, in Arnhem Land in Australia's Northern Territory. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
