   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/XBG"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="xbg">Booandik-ngolo</skos:altLabel>
      <skos:altLabel xml:lang="xbg">drualat-ngolonung</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">xbg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">xbg</skos:notation>
      <skos:prefLabel xml:lang="en">Bunganditj</skos:prefLabel>
      <dc:identifier>XBG</dc:identifier>
      <atold:op-code>XBG</atold:op-code>
      <at:op-code>XBG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XBG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xbg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Bunganditj, also known as drualat-ngolonung, is a Pama-Nyungan language spoken in south-western Victoria, Australia. Together with the closely related Warrnambool dialect continuum, it forms the Warrnambool-Bunganditj group. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
