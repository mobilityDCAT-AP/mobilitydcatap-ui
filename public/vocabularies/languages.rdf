   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/NCK"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Nakkara</skos:altLabel>
      <skos:altLabel xml:lang="nck">Na-kara</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">nck</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">nck</skos:notation>
      <skos:prefLabel xml:lang="en">Na-kara</skos:prefLabel>
      <dc:identifier>NCK</dc:identifier>
      <atold:op-code>NCK</atold:op-code>
      <at:op-code>NCK</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>NCK</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>nck</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Na-kara, also spelled Nakkara, is an endangered Australian Aboriginal language spoken by the Nagara people of Arnhem Land in the Northern Territory of Australia. It is closely related to Djeebbana (djj), and both belong to the Maningrida group of languages. This group is sometimes classified with the Gunwinyguan languages in a proposed Macro-Gunwinyguan family, which is distinct from the Pama–Nyungan language family.</skos:definition>
   </skos:Concept>
