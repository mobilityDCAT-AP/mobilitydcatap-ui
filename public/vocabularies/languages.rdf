      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="daf">Dan</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">daf</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">daf</skos:notation>
      <skos:prefLabel xml:lang="en">Dan</skos:prefLabel>
      <dc:identifier>DAF</dc:identifier>
      <atold:op-code>DAF</atold:op-code>
      <at:op-code>DAF</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>DAF</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>daf</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Kla-Dan [lda] is different enough from the Dan [dnj] to make mutual intelligibility marginal; the percentage of cognates in Swadesh's 100-wordlist between Kla-Dan and different Dan dialects varies between 88 and 90%. Kla-Dan and Dan have no common literature; Kla-Dan speakers have an ethnolinguistic identity of their own, separate from the rest of Dan.</skos:scopeNote>
      <at:end.use>2013-01-23</at:end.use>
   </skos:Concept>
