   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MEP"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Miriuwung</skos:altLabel>
      <skos:altLabel xml:lang="mep">Miriwoong</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mep</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mep</skos:notation>
      <skos:prefLabel xml:lang="en">Miriwoong</skos:prefLabel>
      <dc:identifier>MEP</dc:identifier>
      <atold:op-code>MEP</atold:op-code>
      <at:op-code>MEP</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MEP</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mep</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Miriwoong is an endangered Australian Aboriginal language spoken by the elder generation in or near Kununurra in Western Australia. However, younger generations tend to be familiar with a lot of Miriwoong vocabulary which they use when speaking Kimberley Kriol or Aboriginal English, and there is active language revitalisation. It has been classified as one of two Mirriwongic languages, the other being Gadjerawang. More recent work has established it as a member of the Jarrakan group.</skos:definition>
   </skos:Concept>
