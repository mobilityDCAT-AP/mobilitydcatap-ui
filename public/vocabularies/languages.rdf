      <skos:prefLabel xml:lang="sl">libijski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="et">liibüa viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta na Libia</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">либийски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">libijski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni libica</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">líbiai jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos libia</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Libyan Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">libāņu zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes libyenne</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">libyskt teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">libyjský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Libjana</skos:prefLabel>
      <skos:prefLabel xml:lang="el">λιβυκή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">libyalainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual líbia</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">líbyjský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Libysche Gebärdensprache</skos:prefLabel>
