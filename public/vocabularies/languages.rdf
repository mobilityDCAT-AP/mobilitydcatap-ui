      <skos:prefLabel xml:lang="da">Chiangmai-tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">csiangmaji jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">chiangmaiský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes de Chiang Mai</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Chiangmai-gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Chiangmai Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali ta’ Chiangmai</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">język migowy Ching Mai</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">čiangmajski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="et">chiangmai viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">čhīanmai zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne Chiangmai</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni di Chiang Mai</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos de Chiangmai</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Chiangmai</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">чиангмайски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Chiang Mai-teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">chiangmaiský posunkový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Chiangmai-Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νοηματική γλώσσα του Chiangmai</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">chiangmailainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual de Chiang Mai</skos:prefLabel>
