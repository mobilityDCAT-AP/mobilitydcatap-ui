   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/DMF"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="dmf">Obɛri Ɔkaimɛ</skos:altLabel>
      <skos:altLabel xml:lang="en">Medefidrin</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">dmf</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">dmf</skos:notation>
      <skos:prefLabel xml:lang="en">Medefaidrin</skos:prefLabel>
      <dc:identifier>DMF</dc:identifier>
      <atold:op-code>DMF</atold:op-code>
      <at:op-code>DMF</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>DMF</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>dmf</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Medefaidrin (Medefidrin), or Obɛri Ɔkaimɛ, is a constructed language and script created as a Christian sacred language by an Ibibio congregation in 1930s Nigeria. It has its roots in glossolalia ('speaking in tongues'). Speakers consider Medefaidrin to be a 'spirit language'. It was created by two leaders of the church, Michael Ukpong and Akpan Akpan Udofia. They state that the Holy Spirit revealed the words of the language to Ukpong, while Udofia wrote them down. At the time Ibibio was not a written language, and Udofia created a script to write Medefaidrin.</skos:definition>
   </skos:Concept>
