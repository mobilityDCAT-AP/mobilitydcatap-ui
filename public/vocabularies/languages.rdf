      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mhh</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mhh</skos:notation>
