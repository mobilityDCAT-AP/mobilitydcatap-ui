      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>lmz</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Glottolog lists Lumbee as "unattested". Lumbee, in modern times, can be understood to refer to the variety of English used by Lumbee Native Americans (Wolfram and Dannenberg 1999, Scott 2008).</skos:scopeNote>
      <at:end.use>2020-01-23</at:end.use>
