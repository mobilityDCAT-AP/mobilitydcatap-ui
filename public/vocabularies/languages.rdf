   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/JIG"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="en">Djingili</skos:altLabel>
      <skos:altLabel xml:lang="jig">Jingulu</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">jig</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">jig</skos:notation>
      <skos:prefLabel xml:lang="en">Jingulu</skos:prefLabel>
      <dc:identifier>JIG</dc:identifier>
      <atold:op-code>JIG</atold:op-code>
      <at:op-code>JIG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>JIG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>jig</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Jingulu, also know as Djingili, is an Australian Aboriginal language spoken by the Jingili people in the Northern Territory of Australia, historically around the township of Elliot. The language is an isolate branch of the small Mirndi language family and unrelated to the widely distributed Pama-Nyungan language family. The Jingulu have (or had) a well-developed signed form of their language.</skos:definition>
   </skos:Concept>
