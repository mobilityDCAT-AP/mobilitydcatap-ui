      <skos:prefLabel xml:lang="pl">chiński minbei</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">мин бей китайски</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">chinês min setentrional</skos:prefLabel>
