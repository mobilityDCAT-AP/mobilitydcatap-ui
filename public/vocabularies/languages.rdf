      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="crl">Iyiyiw-Ayimiwin</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">crl</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">crl</skos:notation>
      <skos:prefLabel xml:lang="en">Northern East Cree</skos:prefLabel>
      <dc:identifier>CRL</dc:identifier>
      <atold:op-code>CRL</atold:op-code>
      <at:op-code>CRL</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>CRL</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>crl</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Northern East Cree is spoken in Canada on the east coast of lower Hudson Bay. It belongs to a dialect continuum of Algonquian languages also known as Cree–Montagnais–Naskapi languages.</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/CRE"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/CRK"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="crk">nēhiyawēwin</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">crk</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">crk</skos:notation>
      <skos:prefLabel xml:lang="en">Plains Cree</skos:prefLabel>
      <dc:identifier>CRK</dc:identifier>
      <atold:op-code>CRK</atold:op-code>
      <at:op-code>CRK</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>CRK</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>crk</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Plains Cree (endonym: nēhiyawēwin; alternatively: paskwâwinîmowin ‘language of the prairie people’) belongs to the Cree macrofamily of languages, which is the most populous Canadian indigenous language. Out of the 116 500 speakers of the Cree language, the Plains Cree dialect is spoken by about 34 000 people primarily in Saskatchewan and Alberta but also in Manitoba and Montana. Plains Cree is considered a dialect of the Cree language that is distinct from the Montagnais language or a dialect of the Montagnais language. Together, Cree–Montagnais–Naskapi continuum belongs to the Algonquian sub-branch in the Algic language family.</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/CRE"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/CRJ"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="crj">Iyiniw-Ayamiwin</skos:altLabel>
      <skos:altLabel xml:lang="en">Iyiyiw-Ayamiwin</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">crj</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">crj</skos:notation>
      <skos:prefLabel xml:lang="en">Southern East Cree</skos:prefLabel>
      <dc:identifier>CRJ</dc:identifier>
      <atold:op-code>CRJ</atold:op-code>
      <at:op-code>CRJ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>CRJ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>crj</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Southern East Cree is spoken in Canada on the east coast of lower James Bay, and inland southeastward from James Bay. It belongs to a dialect continuum of Algonquian languages also known as Cree–Montagnais–Naskapi languages.</skos:definition>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/language/CRE"/>
   </skos:Concept>
