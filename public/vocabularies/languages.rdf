      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="trx">Tringgus</skos:altLabel>
      <skos:altLabel xml:lang="trx">Mbaan</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">trx</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">trx</skos:notation>
      <skos:prefLabel xml:lang="en">Tringgus-Sembaan Bidayuh</skos:prefLabel>
      <dc:identifier>TRX</dc:identifier>
      <atold:op-code>TRX</atold:op-code>
      <at:op-code>TRX</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>TRX</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>trx</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Tringgus-Sembaan Bidayuh is a Dayak language of Borneo. It is closely related to the Bukar-Sadung Bidayuh (sdo), Bau Bidayuh (sne) and Biatah Bidayuh (bth) languages. Tringgus-Sembaan Bidayuh belongs to the Malayo-Polyneasian primary branch of the Austronesian language family. Two main morphological characteristics of the Malayo-Polynesian languages are a system of affixation and reduplication to form new words.</skos:definition>
   </skos:Concept>
