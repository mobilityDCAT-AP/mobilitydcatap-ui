      <skos:prefLabel xml:lang="es">lengua de signos de Sierra Leona</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Sierra Leone-i jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni della Sierra Leone</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">sierraleonský posunkový jazyk</skos:prefLabel>
