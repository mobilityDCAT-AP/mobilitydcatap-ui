      <skos:altLabel xml:lang="hps">Hawai‘i Pidgin Sign Language</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">hps</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">hps</skos:notation>
      <skos:prefLabel xml:lang="et">havaii pidgini viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Hawai‘i Pidgin Sign Language</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni creola hawaiana</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Lingwa tas-Sinjali Pidgin tal-Hawai‘i</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">hawaii pidzsin jelnyelv</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Hawai‘i Pidgin-gebarentaal</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">kreolski hawajski język migowy</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">havajský posunkový jazyk pidgin</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">хавайски жестомимичен език</skos:prefLabel>
      <skos:prefLabel xml:lang="es">lengua de signos simplificada de Hawai</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">hawaiianskt pidgin-teckenspråk</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes du créole hawaïen</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">havajskopidžinský znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne Hawai‘i Pidgin</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">havajski pidžin znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Havaju salu pidžina zīmju valoda</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">гавайский жестовый язык</skos:prefLabel>
      <skos:prefLabel xml:lang="el">νοηματική γλώσσα πίτζιν της Χαβάης</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">havajski pidžinski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Hawaiische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Havajų pidžin gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Phidsean Haváí</skos:prefLabel>
      <skos:prefLabel xml:lang="da">hawaiansk pidgin-tegnsprog</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">havaijilainen pidgin-viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">língua gestual pidgin do Havai</skos:prefLabel>
      <dc:identifier>HPS</dc:identifier>
      <atold:op-code>HPS</atold:op-code>
      <at:op-code>HPS</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>HPS</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>hps</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Hawai‘i Pidgin Sign Language is an indigenous sign language used in Hawaii. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
