      <at:op-code>ZMJ</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>ZMJ</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>zmj</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Maridjabin is an endangered Australian Aboriginal language traditionally spoken in the Daly River area of the Northern Territory. It belongs to the small family of Western Daly languages, and more specifically to its Marithielic sub-branch.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/HRR"
