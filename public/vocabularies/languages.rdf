      <skos:prefLabel xml:lang="es">lengua de signos marroquí</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">marocký znakový jazyk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Marokkanische Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">marokiečių gestų kalba</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">maroški znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Teanga Chomharthaíochta Mharacó</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">marokanski znakovni jezik</skos:prefLabel>
      <skos:prefLabel xml:lang="el">μαροκινή νοηματική γλώσσα</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">limbajul prin semne din Maroc</skos:prefLabel>
      <dc:identifier>XMS</dc:identifier>
      <atold:op-code>XMS</atold:op-code>
      <at:op-code>XMS</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>XMS</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>xms</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Moroccan Sign Language is a sign language used in Morocco. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/TWH"
                 at:deprecated="false">
