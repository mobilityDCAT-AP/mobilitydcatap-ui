      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="sgl">Sanglechi-Ishkashimi</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">sgl</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">sgl</skos:notation>
      <skos:prefLabel xml:lang="en">Sanglechi-Ishkashimi</skos:prefLabel>
      <dc:identifier>SGL</dc:identifier>
      <atold:op-code>SGL</atold:op-code>
      <at:op-code>SGL</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>SGL</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>sgl</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">The lexical similarity of Ishkashimi [isk] and Sanglechi [sgy] is 70%. Comprehension testing showed that intelligibility between the two speech varieties is marginal, although the Sanglechi understand Ishkashimi slightly better than vice versa.</skos:scopeNote>
      <at:end.use>2010-01-18</at:end.use>
   </skos:Concept>
