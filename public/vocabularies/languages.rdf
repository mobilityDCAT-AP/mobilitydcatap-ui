      <skos:prefLabel xml:lang="fi">hausalainen viittomakieli</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">langue des signes haoussa</skos:prefLabel>
      <skos:prefLabel xml:lang="et">hausa viipekeel</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lingua dei segni Hausa</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Hausa-Gebärdensprache</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">hausza jelnyelv</skos:prefLabel>
      <dc:identifier>HSL</dc:identifier>
      <atold:op-code>HSL</atold:op-code>
      <at:op-code>HSL</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>HSL</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>hsl</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Hausa Sign Language is a sign language used in Kano city in Nigeria. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions.</skos:definition>
   </skos:Concept>
