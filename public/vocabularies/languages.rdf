   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/MWX"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="mwx">Mediak</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">mwx</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">mwx</skos:notation>
      <skos:prefLabel xml:lang="en">Mediak</skos:prefLabel>
      <dc:identifier>MWX</dc:identifier>
      <atold:op-code>MWX</atold:op-code>
      <at:op-code>MWX</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>MWX</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>mwx</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:historyNote xml:lang="en">This code is deprecated in ISO 639-3. It is no longer in active use, but still has the meaning assigned to it when it was established in the Standard.</skos:historyNote>
      <skos:scopeNote xml:lang="en">Mediak is a clan name similar to Mosiro and Kisankasa according to Maguire (1948:7-8) and not a glossonym. Against this background and for linguistic reasons Rottland &amp; Vossen (1977: 226-230) shift all three clans to Akie [mwy].</skos:scopeNote>
      <at:end.use>2018-01-23</at:end.use>
   </skos:Concept>
