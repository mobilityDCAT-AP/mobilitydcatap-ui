   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/DHG"
                 at:deprecated="false">
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/language/0003"/>
      <skos:altLabel xml:lang="dhg">Djangu</skos:altLabel>
      <skos:altLabel xml:lang="dhg">Dhangu</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#ISO_639_3">dhg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_LNG">dhg</skos:notation>
      <skos:prefLabel xml:lang="en">Dhangu-Djangu</skos:prefLabel>
      <dc:identifier>DHG</dc:identifier>
      <atold:op-code>DHG</atold:op-code>
      <at:op-code>DHG</at:op-code>
      <at:start.use>1950-05-09</at:start.use>
      <at:authority-code>DHG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>iso-639-3</dc:source>
            <at:legacy-code>dhg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Dhangu-Djangu is a Pama-Nyungan language within the Yolngu sub-branch. It is spoken by the Dhaŋu and Djaŋu people in Australia's Northern Territory. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia.</skos:definition>
   </skos:Concept>
